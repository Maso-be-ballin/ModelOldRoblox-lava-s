local FONT_SIZE do
	local size = {8,9,10,11,12,14,18,24,36,48}
	local s
	local n = math.huge
	for i = 1,#size do
		if size[i] &lt;= GUI_SIZE then
			FONT_SIZE = i - 1
		end
	end
end

