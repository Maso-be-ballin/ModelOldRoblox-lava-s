					<ProtectedString name="Source">local tool, m, conn, polling = script.Parent, nil, nil, false

local function thread(f)
coroutine.resume(coroutine.create(f))
end
local lockicon   = &quot;rbxasset://textures\\LockCursor.png&quot;
local unlockicon = &quot;rbxasset://textures\\UnlockCursor.png&quot;
local ping  = &quot;rbxasset://sounds\\electronicpingshort.wav&quot;

tool.Selected:connect(function(mouse)
	m, polling = mouse, true
	conn = m.Button1Down:connect(function()
		local p = m.Target
		if p and p:isA(&quot;Part&quot;) then p.Locked = not p.Locked end
		local snd = Instance.new(&quot;Sound&quot;) snd.SoundId = ping snd.Parent  = tool snd:play()
		thread(function()
		wait(1)
		snd:Remove()
		end)
	end)

	thread(function()
		while polling do
			local p = m.Target
			if p and p:isA(&quot;Part&quot;) then m.Icon = p.Locked and unlockicon or lockicon else m.Icon = &quot;&quot; end
			wait(0.1)
		end
	end)
end)

tool.Deselected:connect(function()
	polling = false
	if conn then conn:disconnect() conn = nil end
	if m then m.Icon = &quot;&quot; m = nil end
end)
</ProtectedString>
