					<ProtectedString name="Source">-- #############################################################
-- 2012-style gubby character scaler &#150; resizes existing gubby
-- #############################################################
--  &#149; Works every time you re-run it: gubby parts scale properly
--  &#149; Keeps classic lower-case 2012 API  (:children(), :isA(), :connect, :remove, :findFirstChild)
--  &#149; Enhanced with configurable leg platform controls
-- #############################################################

----------------------------------------------------------------
-- LEG PLATFORM MODIFIERS (adjust these as needed)
----------------------------------------------------------------
local PLATFORM_SIZE_MODIFIER = 1.0      -- multiplier for platform size (1.0 = default)
local PLATFORM_Y_OFFSET = 2           -- additional Y offset in studs (+ = higher, - = lower)
local PLATFORM_ROTATION_X = 0          -- rotation in radians around X axis
local PLATFORM_ROTATION_Y = 80         -- rotation in radians around Y axis  
local PLATFORM_ROTATION_Z = 0          -- rotation in radians around Z axis

----------------------------------------------------------------
-- 0)  objects &amp; last-modifier tracker
----------------------------------------------------------------
local char = script.Parent
local mod  = script.modifier.Value                  -- new size you want

-- remember the previous size so we only scale **by the ratio**
local lastModObj = char:findFirstChild(&quot;_LastModifier&quot;)
if not lastModObj then
	lastModObj           = Instance.new(&quot;NumberValue&quot;)
	lastModObj.Name      = &quot;_LastModifier&quot;
	lastModObj.Value     = 1                       -- avatar starts un-scaled
	lastModObj.Parent    = char
end
local lastMod     = lastModObj.Value              -- what the rig is right now
local scaleFactor = mod / lastMod                 --  &gt;1 grow, &lt;1 shrink

----------------------------------------------------------------
-- constants / helpers
----------------------------------------------------------------
local V3   = Vector3.new
local R90  = CFrame.fromEulerAnglesXYZ(0,  math.pi/2, 0)
local Rm90 = CFrame.fromEulerAnglesXYZ(0, -math.pi/2, 0)

-- gubby part base sizes (from original gubby script)
local GUBBY_BASE = {
	Head          = V3(2,1,1),
	Torso         = V3(2,2,1),
	[&quot;Left Arm&quot;]  = V3(0.29,  0.93,  0.30),
	[&quot;Right Arm&quot;] = V3(0.29,  0.93,  0.30),
	[&quot;Left Leg&quot;]  = V3(0.29,  0.93,  0.30),
	[&quot;Right Leg&quot;] = V3(0.29,  0.93,  0.30),
	FakeTorso     = V3(2.4049108, 0.917663276, 1.61382174),
	EarR          = V3(0.207475901, 0.514878333, 0.772317469),
	EarL          = V3(0.207475901, 0.514878333, 0.772317469),
	Tail          = V3(0.696, 0.348, 0.348),
	BunsL         = V3(0.83,  0.847, 0.85),
	BunsR         = V3(0.83,  0.847, 0.85),
}

-- gubby part base offsets (from original gubby script)
local GUBBY_OFFSETS = {
	Head          = V3( 0,     0.72,  -0.79),
	EarR          = V3(-0.23, -1.48,   0.54),
	EarL          = V3( 0.23, -1.48,   0.54),
	FakeTorso     = V3( 0,     0,      0),
	Tail          = V3( 0,    -0.54,  -1.04),
	BunsL         = V3( 0.41, -0.03,  -0.57),
	BunsR         = V3(-0.43, -0.01,  -0.57),
	[&quot;Left Arm&quot;]  = V3( 0.46, -0.59,   0.61),
	[&quot;Right Arm&quot;] = V3(-0.46, -0.59,   0.60),
	[&quot;Left Leg&quot;]  = V3( 0.46, -0.59,  -0.61),
	[&quot;Right Leg&quot;] = V3(-0.46, -0.59,  -0.61),
}

-- gubby part rotations in radians
local GUBBY_ROTATIONS = {
	[&quot;Left Arm&quot;]  = V3(0, math.pi/2, 0),
	[&quot;Right Arm&quot;] = V3(0, math.pi/2, 0),
	[&quot;Left Leg&quot;]  = V3(0, math.pi/2, 0),
	[&quot;Right Leg&quot;] = V3(0, math.pi/2, 0),
}

local function hGap(sx) return math.max(sx*0.001, 0.002) end
local function vGap(sy) return math.max(sy*0.001, 0.002) end

----------------------------------------------------------------
-- 1) anchor pose for gubby (absolute values - no cumulative error)
----------------------------------------------------------------
local function anchorPoseGubby(c)
	local torso = c:findFirstChild(&quot;Torso&quot;); if not torso then return end
	
	-- Scale and position torso
	torso.Size = GUBBY_BASE.Torso * mod
	torso.Anchored = true
	
	-- Auto floor lift based on leg size
	local legSize = GUBBY_BASE[&quot;Left Leg&quot;] * mod
	local lift = (GUBBY_BASE.Torso.Y/2 + legSize.Y) * (mod-1)
	torso.CFrame = torso.CFrame * CFrame.new(0, lift, 0)
	
	-- Scale and position all gubby parts
	for partName, baseSize in pairs(GUBBY_BASE) do
		local part = c:findFirstChild(partName)
		if part and partName ~= &quot;Torso&quot; then
			part.Anchored = true
			if partName ~= &quot;EarL&quot; and partName ~= &quot;EarR&quot; and partName ~= &quot;Head&quot; then --  and partName ~= &quot;Left Leg&quot; and partName ~= &quot;Right Leg&quot; and partName ~= &quot;Left Arm&quot;  and partName ~= &quot;Right Arm&quot;
			part.Size = baseSize * mod
			end

			if partName == &quot;Left Leg&quot; or partName == &quot;Right Leg&quot; or partName == &quot;Left Arm&quot;  or partName == &quot;Right Arm&quot; then
			part.Size = Vector3.new(1,1,1) * mod
			elseif partName == &quot;Head&quot; then
				if part.Mesh:isA(&quot;CylinderMesh&quot;) then
					part.Mesh.Scale = Vector3.new(1*mod, mod-0.19, 1.1*mod)
				else
					part.Mesh.Scale = Vector3.new(0.798061311, 0.671487033, 0.798061311) * mod
				end
			end
			-- Get offset and apply scaling
			local offset = GUBBY_OFFSETS[partName]
			if offset then
				local scaledOffset = offset * mod
				local rotationCFrame = CFrame.new()
				
				-- Apply rotation if it exists
				if GUBBY_ROTATIONS[partName] then
					local rot = GUBBY_ROTATIONS[partName]
					rotationCFrame = CFrame.fromEulerAnglesXYZ(rot.X, rot.Y, rot.Z)
				end
				
				part.CFrame = torso.CFrame * CFrame.new(scaledOffset) * rotationCFrame
			end
		end
	end
	
	-- Explicitly handle FakeTorso and Tail sizing (in case they weren&apos;t caught above)
	local fakeTorso = c:findFirstChild(&quot;FakeTorso&quot;)
	if fakeTorso then
		fakeTorso.Anchored = true
		fakeTorso.Size = GUBBY_BASE.FakeTorso * mod
		fakeTorso.CFrame = torso.CFrame * CFrame.new(GUBBY_OFFSETS.FakeTorso * mod)
	end
	
	local tail = c:findFirstChild(&quot;Tail&quot;)
	if tail then
		tail.Anchored = true
		tail.Size = GUBBY_BASE.Tail * mod
		tail.CFrame = torso.CFrame * CFrame.new(GUBBY_OFFSETS.Tail * mod)
	end
	
	-- Scale meshes for special parts
	local head = c:findFirstChild(&quot;Head&quot;)
	if head then
		local headMesh = head:findFirstChild(&quot;Mesh&quot;)
		if headMesh then
			--headMesh.Scale = V3(0.798061311, 0.671487033, 0.798061311) * mod
		end
	end

	local lleg = c:findFirstChild(&quot;Left Leg&quot;)
	if lleg then
		local llegmesh = lleg:findFirstChild(&quot;Mesh&quot;)
		if llegmesh and mod &gt;= 1 then
			llegmesh.Scale = V3(0.29, 0.93, 0.3)
		else
			llegmesh.Scale = V3(0.29, 0.93, 0.3) * mod
		end
	end

		local rleg = c:findFirstChild(&quot;Right Leg&quot;)
	if rleg then
		local rlegmesh = rleg:findFirstChild(&quot;Mesh&quot;)
		if rlegmesh and mod &gt;= 1 then
			rlegmesh.Scale = V3(0.29, 0.93, 0.3)
		else
			rlegmesh.Scale = V3(0.29, 0.93, 0.3) * mod
		end
	end
	
		local larm = c:findFirstChild(&quot;Left Arm&quot;)
	if larm then
		local larmmesh = larm:findFirstChild(&quot;Mesh&quot;)
		if larmmesh and mod &gt;= 1 then
			larmmesh.Scale = V3(0.29, 0.93, 0.3)
		else
			larmmesh.Scale = V3(0.29, 0.93, 0.3) * mod
		end
	end

		local rarm = c:findFirstChild(&quot;Right Arm&quot;)
	if rarm then
		local rarmmesh = rarm:findFirstChild(&quot;Mesh&quot;)
		if rarmmesh and mod &gt;= 1 then
			rarmmesh.Scale = V3(0.29, 0.93, 0.3)
		else
			rarmmesh.Scale = V3(0.29, 0.93, 0.3) * mod
		end
	end

	local lbuns = c:findFirstChild(&quot;BunsL&quot;)
	if lbuns then
		local lbunsmesh = lbuns:findFirstChild(&quot;Mesh&quot;)
		if lbunsmesh and mod &gt;= 1 then
			lbunsmesh.Scale = V3(0.83,  0.847, 0.85)
		else
			lbunsmesh.Scale = V3(0.83,  0.847, 0.85) * mod
		end
	end

	local rbuns = c:findFirstChild(&quot;BunsR&quot;)
	if rbuns then
		local rbunsmesh = rbuns:findFirstChild(&quot;Mesh&quot;)
		if rbunsmesh and mod &gt;= 1 then
			rbunsmesh.Scale = V3(0.83,  0.847, 0.85)
		else
			rbunsmesh.Scale = V3(0.83,  0.847, 0.85) * mod
		end
	end
 -----------
	local fakeTorso = c:findFirstChild(&quot;FakeTorso&quot;)
	if fakeTorso then
		local ftMesh = fakeTorso:findFirstChild(&quot;SpecialMesh&quot;) or fakeTorso:findFirstChild(&quot;Mesh&quot;)
		if ftMesh then
			ftMesh.Scale = V3(1.2024554, 0.917663276, 1.61382174) * mod
		end
	end
	
	local tail = c:findFirstChild(&quot;Tail&quot;)
	if tail then
		local tailMesh = tail:findFirstChild(&quot;SpecialMesh&quot;) or tail:findFirstChild(&quot;Mesh&quot;)
		if tailMesh then
			tailMesh.Scale = V3(0.348079145, 0.348079205, 0.348079205) * mod
		end
	end
	
	local earmeshsize = Vector3.new(0.207, 0.515, 0.772)
	
	-- Also handle ears mesh scaling
	local earR = c:findFirstChild(&quot;EarR&quot;)
	if earR then
		local earRMesh = earR:findFirstChild(&quot;SpecialMesh&quot;) or earR:findFirstChild(&quot;Mesh&quot;)
		if earRMesh then
			earRMesh.Scale = earmeshsize * mod
		end
	end
	
	local earL = c:findFirstChild(&quot;EarL&quot;)
	if earL then
		local earLMesh = earL:findFirstChild(&quot;SpecialMesh&quot;) or earL:findFirstChild(&quot;Mesh&quot;)
		if earLMesh then
			earLMesh.Scale = (earmeshsize * mod)
		end
	end
end

----------------------------------------------------------------
-- 2) rebuild gubby joints
----------------------------------------------------------------
local function jointsGubby(c)
	local torso = c:findFirstChild(&quot;Torso&quot;); if not torso then return end
	
	-- Remove existing joints
	for _,v in ipairs(torso:children()) do
		if v:isA(&quot;Motor&quot;) or v:isA(&quot;Snap&quot;) or v:isA(&quot;Weld&quot;) then v:remove() end
	end
	
	-- Recreate Motor joints for limbs (2012 style)
	local limbData = {
		{name = &quot;Left Arm&quot;,  motor_name = &quot;Left Shoulder&quot;},
		{name = &quot;Right Arm&quot;, motor_name = &quot;Right Shoulder&quot;},
		{name = &quot;Left Leg&quot;,  motor_name = &quot;Left Hip&quot;},
		{name = &quot;Right Leg&quot;, motor_name = &quot;Right Hip&quot;},
	}
	
	for _, info in ipairs(limbData) do
		local limb = c:findFirstChild(info.name)
		if limb then
			local motor = Instance.new(&quot;Motor&quot;)
			motor.Name = info.motor_name
			motor.Parent = torso
			motor.Part0 = torso
			motor.Part1 = limb
			motor.MaxVelocity = 0.1
			
			-- Get scaled offset and rotation
			local offset = GUBBY_OFFSETS[info.name] * mod
			local rotation = GUBBY_ROTATIONS[info.name] or V3(0,0,0)
			local rotationCFrame = CFrame.fromEulerAnglesXYZ(rotation.X, rotation.Y, rotation.Z)
			
			motor.C0 = CFrame.new(offset) * rotationCFrame
			motor.C1 = CFrame.new(0, 0, 0)
			
			-- Position the limb correctly
			limb.CFrame = torso.CFrame * motor.C0 * motor.C1:inverse()
		end
	end
	
	-- Recreate head joint
	local head = c:findFirstChild(&quot;Head&quot;)
	if head then
		local neck = Instance.new(&quot;Snap&quot;)
		neck.Name = &quot;Neck&quot;
		neck.Part0 = torso
		neck.Part1 = head
		neck.Parent = torso
		neck.C0 = CFrame.new(GUBBY_OFFSETS.Head * mod)
	end
	
	-- Recreate welds for gubby parts
	local weldParts = {&quot;EarR&quot;, &quot;EarL&quot;, &quot;FakeTorso&quot;, &quot;Tail&quot;, &quot;BunsL&quot;, &quot;BunsR&quot;}
	for _, partName in ipairs(weldParts) do
		local part = c:findFirstChild(partName)
		if part then
			local weld = Instance.new(&quot;Weld&quot;)
			weld.Parent = torso
			weld.Part0 = torso
			weld.Part1 = part
			weld.C1 = CFrame.new(GUBBY_OFFSETS[partName] * mod)
		end
	end
	
	-- Handle HumanoidRootPart if present
	local root = c:findFirstChild(&quot;HumanoidRootPart&quot;)
	if root then
		local rootWeld = Instance.new(&quot;Weld&quot;)
		rootWeld.Parent = torso
		rootWeld.Part0 = torso
		rootWeld.Part1 = root
		rootWeld.C1 = CFrame.new(V3(0, -0.9, 0) * mod) -- RootOffset scaled
	end
	
	-- Apply torso offset to all joints
	local torsoOffset = V3(0, -0.8, 0) * mod -- TorsoOffset scaled
	for _, joint in ipairs(torso:children()) do
		if joint:isA(&quot;Weld&quot;) or joint:isA(&quot;Motor&quot;) or joint:isA(&quot;Snap&quot;) and joint.Parent ~= &quot;Head&quot; then
			joint.C0 = CFrame.new(torsoOffset) * joint.C0
		end
	end
end

----------------------------------------------------------------
-- 3) enhanced leg platform for gubby with configurable modifiers
----------------------------------------------------------------
local function platformGubby(c)
	local plate = c:findFirstChild(&quot;LegPlatform&quot;)
	if plate then plate:remove() end
	if mod &lt; 3.5 then return end

	local t, lleg = c:findFirstChild(&quot;Torso&quot;), c:findFirstChild(&quot;Left Leg&quot;)
	if not (t and lleg) then return end

	plate = Instance.new(&quot;Part&quot;)
	plate.Name = &quot;LegPlatform&quot;
	
	-- Apply size modifier to platform dimensions
	local baseSize = (mod&gt;100) and V3(t.Size.X,35,t.Size.Z) or V3(t.Size.X,5,t.Size.Z)
	plate.Size = baseSize * PLATFORM_SIZE_MODIFIER
	
	plate.Transparency, plate.CanCollide = 1, true
	plate.Anchored, plate.TopSurface, plate.BottomSurface = false, 0, 0
	plate.Parent = c

	local half = t.Size.Y/2 + lleg.Size.Y
	local yOff = -half + plate.Size.Y/2 + PLATFORM_Y_OFFSET

	-- Create rotation CFrame from the modifier values
	local customRotation = CFrame.fromEulerAnglesXYZ(
		PLATFORM_ROTATION_X, 
		PLATFORM_ROTATION_Y, 
		PLATFORM_ROTATION_Z
	)
	
	-- Apply position and rotation (including the original pi rotation plus custom rotation)
	local originalRotation = CFrame.fromEulerAnglesXYZ(math.pi, 0, 0)
	plate.CFrame = t.CFrame * CFrame.new(0, yOff, 0) * originalRotation * customRotation

	local w = Instance.new(&quot;Weld&quot;)
	w.Name, w.Part0, w.Part1, w.Parent = &quot;LegPlateWeld&quot;, t, plate, t
	w.C0, w.C1 = t.CFrame:inverse()*plate.CFrame, CFrame.new()
end

----------------------------------------------------------------
-- 4) run the pipeline
----------------------------------------------------------------
char:BreakJoints()
anchorPoseGubby(char)
jointsGubby(char)
platformGubby(char)

----------------------------------------------------------------
-- 5) HRP weld so 2012 tools work
----------------------------------------------------------------
local torso, hrp = char:findFirstChild(&quot;Torso&quot;), char:findFirstChild(&quot;HumanoidRootPart&quot;)
if torso and hrp then
	hrp.Size, hrp.CFrame = torso.Size, torso.CFrame
	local rw = Instance.new(&quot;Weld&quot;)
	rw.Name, rw.Part0, rw.Part1, rw.Parent = &quot;RootWeld&quot;, torso, hrp, torso
	rw.C0, rw.C1 = CFrame.new(), CFrame.new()
	char.Humanoid.CameraOffset = V3(0, mod, 0)
end

----------------------------------------------------------------
-- 6) un-anchor parts
----------------------------------------------------------------
for _,p in ipairs(char:children()) do
	if p:isA(&quot;Part&quot;) then p.Anchored = false end
end

----------------------------------------------------------------
-- 7) bounce Animate for old clients
----------------------------------------------------------------
char.Animate.Disabled = false
wait(0.1)
char.Animate.Disabled = true
wait(0.3)
char.Animate.Disabled = false

----------------------------------------------------------------
-- 8) update last-modifier for the **next** resize
----------------------------------------------------------------
