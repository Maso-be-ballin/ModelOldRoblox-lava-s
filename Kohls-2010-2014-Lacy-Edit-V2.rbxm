			<Item class="Script" referent="RBX53">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">giantscript</string>
					<ProtectedString name="Source">-- #############################################################
-- 2010-style character scaler &#150; auto-floor-lift + multi-resize hats
-- #############################################################
--  &#149; Works every time you re-run it: hats never over- or under-scale
--  &#149; Keeps classic lower-case 2010 API  (:children(), :isA(), :connect, &#133;)
-- #############################################################

----------------------------------------------------------------
-- 0)  objects &amp; last-modifier tracker
----------------------------------------------------------------
local char = script.Parent
local mod  = script.modifier.Value                  -- new size you want

-- remember the previous size so we only scale **by the ratio**
local lastModObj = char:findFirstChild(&quot;_LastModifier&quot;)
if not lastModObj then
	lastModObj           = Instance.new(&quot;NumberValue&quot;)
	lastModObj.Name      = &quot;_LastModifier&quot;
	lastModObj.Value     = 1                       -- avatar starts un-scaled
	lastModObj.Parent    = char
end
local lastMod     = lastModObj.Value              -- what the rig is right now
local scaleFactor = mod / lastMod                 --  &gt;1 grow, &lt;1 shrink


for i, v in ipairs(char:findFirstChild(&quot;Torso&quot;):children()) do
if v:isA(&quot;Decal&quot;) then
v:Remove()
end
end

for i, v in ipairs(char:children()) do
if v.Name == &quot;Shirt Graphic&quot; then --more AB BS &lt;3
v:Remove()
end
end

----------------------------------------------------------------
-- 0-bis) pre-scan every hat BEFORE we touch the rig
----------------------------------------------------------------
local hats = {}   -- [hat] = {handle, relCF, mesh}
do
	local head = char:findFirstChild(&quot;Head&quot;)
	if head then
		for _,h in ipairs(char:children()) do
			if h:isA(&quot;Hat&quot;) then
				local handle = h:findFirstChild(&quot;Handle&quot;)
				if handle and handle:isA(&quot;Part&quot;) then
					local mesh = handle:findFirstChild(&quot;SpecialMesh&quot;)
					         or handle:findFirstChild(&quot;Mesh&quot;)
					         or handle:findFirstChild(&quot;BlockMesh&quot;)
					         or handle:findFirstChild(&quot;CylinderMesh&quot;)
					hats[h] = {
						handle = handle,
						relCF  = head.CFrame:inverse() * handle.CFrame, -- head-space offset NOW
						mesh   = mesh,
					}
				end
			end
		end
	end
end

----------------------------------------------------------------
-- austiblox flag (unchanged)
----------------------------------------------------------------
local isausti
for _,lc in ipairs(game.Lighting:children()) do
	if lc.Name==&quot;BuildToolsModel&quot; or lc.Name==&quot;OwnerToolsModel&quot; then isausti=true end
end

local hasreset, hasfixer = false, false

for i,v in ipairs(game.Workspace:children()) do --2010 check
	if v.Name == &quot;ResetCommand&quot; then
		hasreset = true
	elseif v.Name == &quot;Fixer&quot; then
		hasfixer = true
	end
	if hasreset and hasfixer then
		isausti = true
		break
	end
end

----------------------------------------------------------------
-- constants / helpers
----------------------------------------------------------------
local V3   = Vector3.new
local R90  = CFrame.fromEulerAnglesXYZ(0,  math.pi/2, 0)
local Rm90 = CFrame.fromEulerAnglesXYZ(0, -math.pi/2, 0)

local BASE = {
	Head          = V3(2,1,1),  Torso         = V3(2,2,1),
	[&quot;Left Arm&quot;]  = V3(1,2,1),  [&quot;Right Arm&quot;] = V3(1,2,1),
	[&quot;Left Leg&quot;]  = V3(1,2,1),  [&quot;Right Leg&quot;] = V3(1,2,1),
}
local function hGap(sx) return math.max(sx*0.001, 0.002) end
local function vGap(sy) return math.max(sy*0.001, 0.002) end

----------------------------------------------------------------
-- 1) anchor pose (absolute values ? no cumulative error)
----------------------------------------------------------------
local function anchorPose(c)
	local torso = c:findFirstChild(&quot;Torso&quot;); if not torso then return end
	torso.Size, torso.Anchored = BASE.Torso*mod, true

	local lift = (BASE.Torso.Y/2 + BASE[&quot;Left Leg&quot;].Y) * (mod-1)
	torso.CFrame = torso.CFrame * CFrame.new(0,lift,0)

	local sx,sy = torso.Size.X/2, torso.Size.Y/2
	local gapX,gapY = hGap(sx*2), vGap(sy*2)

	local function set(p,off,rot)
		p.Anchored, p.Size = true, BASE[p.Name]*mod
		p.CFrame = torso.CFrame * CFrame.new(off) * rot
	end

	local head = c:findFirstChild(&quot;Head&quot;)
	if head then set(head, V3(0,sy+head.Size.Y/2,0), CFrame.new()) end

	local la = c:findFirstChild(&quot;Left Arm&quot;)
	if la then set(la, V3(-(sx+la.Size.X/2+gapX),0,0), Rm90) end
	local ra = c:findFirstChild(&quot;Right Arm&quot;)
	if ra then set(ra, V3( (sx+ra.Size.X/2+gapX),0,0), R90) end

	local ly = -(sy + (BASE[&quot;Left Leg&quot;].Y*mod)/2 + gapY)
	local ll = c:findFirstChild(&quot;Left Leg&quot;)
	if ll then set(ll, V3(-(sx-ll.Size.X/2),ly,0), R90) end
	local rl = c:findFirstChild(&quot;Right Leg&quot;)
	if rl then set(rl, V3( (sx-rl.Size.X/2),ly,0), R90) end
end

----------------------------------------------------------------
-- 2) rebuild joints (unchanged)
----------------------------------------------------------------
local function joints(c)
	local torso = c:findFirstChild(&quot;Torso&quot;); if not torso then return end
	local sx,sy = torso.Size.X/2, torso.Size.Y/2
	local gapX   = hGap(sx*2)

	for _,v in ipairs(torso:children()) do
		if v:isA(&quot;Motor&quot;) or v:isA(&quot;Snap&quot;) then v:Remove() end
	end

	local function mk(name,p1,c0,c1)
		local m = Instance.new(&quot;Motor&quot;)
		m.Name,m.Part0,m.Part1,m.Parent = name,torso,p1,torso
		m.C0,m.C1,m.MaxVelocity = c0,c1,0.1
		p1.CFrame = torso.CFrame * c0 * c1:inverse()
	end

	local la = c:findFirstChild(&quot;Left Arm&quot;)
	if la then mk(&quot;Left Shoulder&quot;,la,
		CFrame.new(-(sx+la.Size.X/2+gapX),sy-0.5,0)*Rm90,
		CFrame.new(0,la.Size.Y/2-0.5,0)*Rm90) end
	local ra = c:findFirstChild(&quot;Right Arm&quot;)
	if ra then mk(&quot;Right Shoulder&quot;,ra,
		CFrame.new( (sx+ra.Size.X/2+gapX),sy-0.5,0)*R90,
		CFrame.new(0,ra.Size.Y/2-0.5,0)*R90) end

	local ll = c:findFirstChild(&quot;Left Leg&quot;)
	if ll then mk(&quot;Left Hip&quot;,ll,
		CFrame.new(-(sx-ll.Size.X/2),-sy,0)*Rm90,
		CFrame.new(0,ll.Size.Y/2,0)*Rm90) end
	local rl = c:findFirstChild(&quot;Right Leg&quot;)
	if rl then mk(&quot;Right Hip&quot;,rl,
		CFrame.new( (sx-rl.Size.X/2),-sy,0)*R90,
		CFrame.new(0,rl.Size.Y/2,0)*R90) end

	local head = c:findFirstChild(&quot;Head&quot;)
	if head then
		local n = Instance.new(&quot;Snap&quot;)
		n.Name,n.Part0,n.Part1,n.Parent = &quot;Neck&quot;,torso,head,torso
		n.C0 = CFrame.new(0,sy+head.Size.Y/2,0)
	end
end

----------------------------------------------------------------
-- 3) optional leg platform (unchanged)
----------------------------------------------------------------
local function platform(c)
	local plate = c:findFirstChild(&quot;LegPlatform&quot;)
	if plate then plate:Remove() end
	if mod &lt; 3.5 then return end

	local t,lleg = c:findFirstChild(&quot;Torso&quot;), c:findFirstChild(&quot;Left Leg&quot;)
	if not (t and lleg) then return end

	plate = Instance.new(&quot;Part&quot;)
	plate.Name = &quot;LegPlatform&quot;
	plate.Size = (mod&gt;100) and V3(t.Size.X,35,t.Size.Z) or V3(t.Size.X,5,t.Size.Z)
	plate.Transparency, plate.CanCollide = 1, true
	plate.Anchored, plate.TopSurface, plate.BottomSurface = false,0,0
	plate.Parent = c

	local half = t.Size.Y/2 + lleg.Size.Y
	local yOff = -half + plate.Size.Y/2

	plate.CFrame = t.CFrame * CFrame.new(0,yOff,0) * CFrame.fromEulerAnglesXYZ(math.pi,0,0)

	local w = Instance.new(&quot;Weld&quot;)
	w.Name,w.Part0,w.Part1,w.Parent = &quot;LegPlateWeld&quot;,t,plate,t
	w.C0,w.C1 = t.CFrame:inverse()*plate.CFrame, CFrame.new()
end

----------------------------------------------------------------
-- 4)  **scale + re-place hats using ratio**
----------------------------------------------------------------
local function fixHats(c)
	local head = c:findFirstChild(&quot;Head&quot;); if not head then return end

	for hat,data in pairs(hats) do
		local handle = data.handle
		if handle and handle.Parent then
			----------------------------------------------------------
			-- I.  size / mesh scale only by the **ratio**
			----------------------------------------------------------
			--handle.Size = handle.Size * scaleFactor
			local mesh = data.mesh
			if mesh then
				mesh.Scale   = mesh.Scale   * scaleFactor
				if mesh.Offset then mesh.Offset = mesh.Offset * scaleFactor end
			end

			----------------------------------------------------------
			-- II. compute fresh C0  (original-offset * new-mod)
			----------------------------------------------------------
			local rel     = data.relCF                       -- offset seen *before* we grew/shrank
			local origPos = rel.p / lastMod                  -- back to un-scaled units
			local newPos  = origPos * mod                    -- target distance
			local rot     = rel - rel.p
			local c0      = CFrame.new(newPos) * rot

			----------------------------------------------------------
			-- III. weld &amp; place
			----------------------------------------------------------
			for _,j in ipairs(handle:children()) do
				if j:isA(&quot;Weld&quot;) or j:isA(&quot;Motor&quot;) or j:isA(&quot;Snap&quot;) then j:Remove() end
			end

			handle.CFrame, handle.Anchored = head.CFrame * c0, false

			local w = Instance.new(&quot;Weld&quot;)
			w.Part0, w.Part1, w.Parent = head, handle, head
			w.C0, w.C1 = c0, CFrame.new()
		end
	end
end

----------------------------------------------------------------
-- 5)  run the pipeline
----------------------------------------------------------------
char:BreakJoints()
anchorPose(char)
joints(char)
platform(char)
fixHats(char)

----------------------------------------------------------------
-- 6)  HRP weld so 2010 tools work
----------------------------------------------------------------
local torso,hrp = char:findFirstChild(&quot;Torso&quot;), char:findFirstChild(&quot;HumanoidRootPart&quot;)
if torso and hrp then
	hrp.Size, hrp.CFrame = torso.Size, torso.CFrame
	local rw = Instance.new(&quot;Weld&quot;)
	rw.Name,rw.Part0,rw.Part1,rw.Parent = &quot;RootWeld&quot;,torso,hrp,torso
	rw.C0,rw.C1 = CFrame.new(),CFrame.new()
	char.Humanoid.CameraOffset = V3(0,mod,0)
end

----------------------------------------------------------------
-- 7)  un-anchor parts
----------------------------------------------------------------
for _,p in ipairs(char:children()) do
	if p:isA(&quot;Part&quot;) then p.Anchored = false end
end

----------------------------------------------------------------
-- 8)  clothes logic (unchanged)
----------------------------------------------------------------
local ok = pcall(function() return char.Humanoid.Move end)
if not ok then
	if mod == 1 then
		for _,v in ipairs(char.Torso:children()) do
			if v:isA(&quot;Shirt&quot;) or v:isA(&quot;Pants&quot;) or v:isA(&quot;CharacterMesh&quot;) then v.Parent = char end
		end
		for _,n in ipairs({&quot;Left Leg&quot;,&quot;Right Leg&quot;}) do
			local leg = char:findFirstChild(n)
			if leg then
				for _,d in ipairs(leg:children()) do if d:isA(&quot;Decal&quot;) then d:Remove() end end
			end
		end
	else
		for _,w in ipairs(char:children()) do
			if w:isA(&quot;Shirt&quot;) or w:isA(&quot;Pants&quot;) or w:isA(&quot;CharacterMesh&quot;) then w.Parent = char.Torso end
			if w.Name==&quot;Left Leg&quot; or w.Name==&quot;Right Leg&quot; then
				local faces={&quot;Front&quot;,&quot;Back&quot;,&quot;Left&quot;,&quot;Right&quot;}
				for _,f in ipairs(faces) do
					local d=Instance.new(&quot;Decal&quot;); d.Face=Enum.NormalId[f]
					d.Texture = isausti and &quot;https://1.0char.co/Catalog/catalogitem.php?id=1161&amp;type=tshirt&quot;
					           or &quot;http://www.roblox.com/asset/?id=114314666135337&quot;
					d.Parent=w
				end
				local top=Instance.new(&quot;Decal&quot;); top.Face=Enum.NormalId.Top
				top.Texture = isausti and &quot;https://1.0char.co/Catalog/catalogitem.php?id=1162&amp;type=tshirt&quot;
				             or &quot;http://www.roblox.com/asset/?id=136997527729805&quot;
				top.Parent=w
			end
		end
	end
end

----------------------------------------------------------------
-- 9)  bounce Animate for old clients
----------------------------------------------------------------
char.Animate.Disabled=false; wait(0.1); char.Animate.Disabled=true
wait(0.3);                char.Animate.Disabled=false

----------------------------------------------------------------
-- 10)  update last-modifier for the **next** resize
----------------------------------------------------------------
lastModObj.Value = mod
</ProtectedString>
				</Properties>
				<Item class="NumberValue" referent="RBX54">
					<Properties>
						<bool name="Archivable">true</bool>
						<string name="Name">modifier</string>
						<double name="Value">0</double>
					</Properties>
				</Item>
			</Item>
			<Item class="LocalScript" referent="RBX55">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Animate</string>
					<ProtectedString name="Source">function waitForChild(parent, childName)
	local child = parent:findFirstChild(childName)
	if child then return child end
	while true do
		child = parent.ChildAdded:wait()
		if child.Name==childName then return child end
	end
end

if script.Parent:findFirstChild(&quot;giantscript&quot;) then
	multiplier = tonumber(script.Parent:findFirstChild(&quot;giantscript&quot;).modifier.Value)
elseif script.Parent:findFirstChild(&quot;gubbyresize&quot;) then
	multiplier = tonumber(script.Parent:findFirstChild(&quot;gubbyresize&quot;).modifier.Value)
end
-- ANIMATION

-- declarations

local Figure = script.Parent
local Torso = waitForChild(Figure, &quot;Torso&quot;)
local RightShoulder = waitForChild(Torso, &quot;Right Shoulder&quot;)
local LeftShoulder = waitForChild(Torso, &quot;Left Shoulder&quot;)
local RightHip = waitForChild(Torso, &quot;Right Hip&quot;)
local LeftHip = waitForChild(Torso, &quot;Left Hip&quot;)
local Neck = waitForChild(Torso, &quot;Neck&quot;)
local Humanoid = waitForChild(Figure, &quot;Humanoid&quot;)
local pose = &quot;Standing&quot;

local toolAnim = &quot;None&quot;
local toolAnimTime = 0

local platform = script.Parent:findFirstChild(&quot;LegPlatform&quot;)

-- functions

function onRunning(speed)
	if speed&gt;0 then
		pose = &quot;Running&quot;
	else
		pose = &quot;Standing&quot;
	end
end

function onDied()
	pose = &quot;Dead&quot;
end

function onJumping()
   if platform then platform.CanCollide = false end
	--script.Parent.Legplatform.CanCollide = false
	pose = &quot;Jumping&quot;
end

function onClimbing()
	pose = &quot;Climbing&quot;
end

function onGettingUp()
	pose = &quot;GettingUp&quot;
end

function onFreeFall()
--	script.Parent.Legplatform.CanCollide = true
   if platform then platform.CanCollide = true end
	pose = &quot;FreeFall&quot;
end

function onFallingDown()
   if platform then platform.CanCollide = true end
--	script.Parent.Legplatform.CanCollide = true
	pose = &quot;FallingDown&quot;
end

function onSeated()
	pose = &quot;Seated&quot;
end

function onPlatformStanding()
	pose = &quot;PlatformStanding&quot;
end

function moveJump()
	RightShoulder.MaxVelocity = 0.5
	LeftShoulder.MaxVelocity = 0.5
	RightShoulder.DesiredAngle = 3.14
	LeftShoulder.DesiredAngle = -3.14
	RightHip.DesiredAngle = 0
	LeftHip.DesiredAngle = 0
end


-- same as jump for now

function moveFreeFall()
	RightShoulder.MaxVelocity = 0.5
	LeftShoulder.MaxVelocity = 0.5
	RightShoulder.DesiredAngle = 3.14
	LeftShoulder.DesiredAngle = -3.14
	RightHip.DesiredAngle = 0
	LeftHip.DesiredAngle = 0
end

function moveSit()
	RightShoulder.MaxVelocity = 0.15
	LeftShoulder.MaxVelocity = 0.15
	RightShoulder.DesiredAngle = 3.14 /2
	LeftShoulder.DesiredAngle = -3.14 /2
	RightHip.DesiredAngle = 3.14 /2
	LeftHip.DesiredAngle = -3.14 /2
end

function getTool()	
	for _, kid in ipairs(Figure:GetChildren()) do
		if kid.className == &quot;Tool&quot; then return kid end
	end
	return nil
end

function getToolAnim(tool)
	for _, c in ipairs(tool:GetChildren()) do
		if c.Name == &quot;toolanim&quot; and c.className == &quot;StringValue&quot; then
			return c
		end
	end
	return nil
end

function animateTool()
	
	if (toolAnim == &quot;None&quot;) then
		RightShoulder.DesiredAngle = 1.57
		return
	end

	if (toolAnim == &quot;Slash&quot;) then
		RightShoulder.MaxVelocity = 0.5
		RightShoulder.DesiredAngle = 0
		return
	end

	if (toolAnim == &quot;Lunge&quot;) then
		RightShoulder.MaxVelocity = 0.5
		LeftShoulder.MaxVelocity = 0.5
		RightHip.MaxVelocity = 0.5
		LeftHip.MaxVelocity = 0.5
		RightShoulder.DesiredAngle = 1.57
		LeftShoulder.DesiredAngle = 1.0
		RightHip.DesiredAngle = 1.57
		LeftHip.DesiredAngle = 1.0
		return
	end
end

function move(time)
	local amplitude
	local frequency
  
	if (pose == &quot;Jumping&quot;) then
		moveJump()
		return
	end

	if (pose == &quot;FreeFall&quot;) then
		moveFreeFall()
		return
	end
 
	if (pose == &quot;Seated&quot;) then
		moveSit()
		return
	end

	local climbFudge = 0
	
	if (pose == &quot;Running&quot;) then
		RightShoulder.MaxVelocity = 0.15
		LeftShoulder.MaxVelocity = 0.15
		amplitude = 1
		if multiplier &lt; 1 then
			frequency = 1
		elseif multiplier &gt;= 10 then
			frequency = 1.5
		elseif multiplier &gt;= 9 then
			frequency = 1.75
		elseif multiplier &gt;= 8 then
			frequency = 2
		elseif multiplier &gt;= 7 then
			frequency = 2.25
		elseif multiplier &gt;= 6 then
			frequency = 2.5
		elseif multiplier &gt;= 5 then
			frequency = 3
		elseif multiplier &gt;= 4 then
			frequency = 4
		elseif multiplier &gt;= 3 then
			frequency = 5
		elseif multiplier &gt;= 2 then
			frequency = 7
		else
			frequency = 9
		end
	elseif (pose == &quot;Climbing&quot;) then
		RightShoulder.MaxVelocity = 0.5 
		LeftShoulder.MaxVelocity = 0.5
		amplitude = 1
		if multiplier &lt; 1 then
			frequency = 1
		elseif multiplier &gt;= 10 then
			frequency = 1.5
		elseif multiplier &gt;= 9 then
			frequency = 1.75
		elseif multiplier &gt;= 8 then
			frequency = 2
		elseif multiplier &gt;= 7 then
			frequency = 2.25
		elseif multiplier &gt;= 6 then
			frequency = 2.5
		elseif multiplier &gt;= 5 then
			frequency = 3
		elseif multiplier &gt;= 4 then
			frequency = 4
		elseif multiplier &gt;= 3 then
			frequency = 5
		elseif multiplier &gt;= 2 then
			frequency = 7
		else
			frequency = 9
		end
		climbFudge = 3.14
	else
		amplitude = 0.1
		frequency = 1
	end

	desiredAngle = amplitude * math.sin(time*frequency)

	RightShoulder.DesiredAngle = desiredAngle + climbFudge
	LeftShoulder.DesiredAngle = desiredAngle - climbFudge
	RightHip.DesiredAngle = -desiredAngle
	LeftHip.DesiredAngle = -desiredAngle


	local tool = getTool()

	if tool then
	
		animStringValueObject = getToolAnim(tool)

		if animStringValueObject then
			toolAnim = animStringValueObject.Value
			-- message recieved, delete StringValue
			animStringValueObject.Parent = nil
			toolAnimTime = time + .3
		end

		if time &gt; toolAnimTime then
			toolAnimTime = 0
			toolAnim = &quot;None&quot;
		end

		animateTool()

		
	else
		toolAnim = &quot;None&quot;
		toolAnimTime = 0
	end
end


-- connect events

Humanoid.Died:connect(onDied)
Humanoid.Running:connect(onRunning)
Humanoid.Jumping:connect(onJumping)
Humanoid.Climbing:connect(onClimbing)
Humanoid.GettingUp:connect(onGettingUp)
Humanoid.FreeFalling:connect(onFreeFall)
Humanoid.FallingDown:connect(onFallingDown)
Humanoid.Seated:connect(onSeated)
Humanoid.PlatformStanding:connect(onPlatformStanding)

-- main program

local runService = game:service(&quot;RunService&quot;);

while Figure.Parent~=nil do
	local _, time = wait(0.1)
	move(time)
end
