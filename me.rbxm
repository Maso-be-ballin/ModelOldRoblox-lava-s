&#9;&#9;&#9;W.Part1 = B
&#9;&#9;&#9;W.C0 = CFrame.new(0, -0.5, 0)
&#9;&#9;&#9;W.Parent = Limb

&#9;&#9;end
&#9;&#9;local Limb = Character:FindFirstChild(&quot;Right Leg&quot;)
&#9;&#9;if Limb then

