							<string name="Name">Telescript2</string>
							<ProtectedString name="Source">function onClicked()

local c = game.Players:GetChildren() 

for i = 1, #c do 
wait(12)
c[i].Character.Torso.CFrame = CFrame.new(script.Parent.Parent.Parent.Parent.Teleport1.Position)--change &quot;teleport1&quot; to the name of the object you want to be teled to...
end 

end 

script.Parent.ClickDetector.MouseClick:connect(onClicked)</ProtectedString>
