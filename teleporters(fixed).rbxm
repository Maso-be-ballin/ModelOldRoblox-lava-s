other.RSign.Transparency = 0.15
wait(.3)
model.RSign.Transparency = 0.05
other.RSign.Transparency = 0.05
wait(.3)
model.RSign.Transparency = 0.1
other.RSign.Transparency = 0.1
wait(.3)
model.RSign.Transparency = 0.01
other.RSign.Transparency = 0.01
wait(.3)
model.RSign.Transparency = 0
other.RSign.Transparency = 0
wait(1)
model.RSign.Transparency = 0.1
other.RSign.Transparency = 0.1
wait(.3)
model.RSign.Transparency = 0.2
other.RSign.Transparency = 0.2
wait(.3)
model.RSign.Transparency = 0.3
other.RSign.Transparency = 0.3
wait(.3)
model.RSign.Transparency = 0.4
other.RSign.Transparency = 0.4
wait(.3)
model.RSign.Transparency = 0.5
other.RSign.Transparency = 0.5
wait(.3)
