						<string name="Name">Script</string>
						<ProtectedString name="Source">--Made By: Zach123456789,:builderman
l = script.Parent
while true do
wait()
local h = l:GetChildren()
for i = 1, #h do
if h[i].Name == &quot;RSign&quot; then
h[i].CFrame = h[i].CFrame * CFrame.fromEulerAnglesXYZ(0,0,10)
end
end
end</ProtectedString>
