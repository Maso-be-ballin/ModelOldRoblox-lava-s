other.RSign.Transparency = 0.8
wait(.3)
model.RSign.Transparency = 0.9
other.RSign.Transparency = 0.9
wait(.3)
model.RSign.Transparency = 1
other.RSign.Transparency = 1
model.Name = &quot;Player has been sucessfully teleported.&quot;
other.Name = &quot;Player has been sucessfully teleported.&quot;
model.Door1.CanCollide = true
model.Door1.Transparency = 0
model.Door2.CanCollide = false
model.Door2.Transparency = 1
other.Door1.CanCollide = true
other.Door1.Transparency = 0
other.Door2.CanCollide = false
other.Door2.Transparency = 1
wait(5)
model.Name = &quot;Teleporter&quot;
other.Name = &quot;Teleporter&quot;
end
script.Parent.ClickDetector.MouseClick:connect (onClicked)
