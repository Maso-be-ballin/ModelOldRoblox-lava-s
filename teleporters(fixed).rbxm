					<Item class="Script" referent="RBX31">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Telescript</string>
							<ProtectedString name="Source">local other = script.Parent.Parent.Parent.Parent.Telething2.Teleporter
function onClicked()
local model = script.Parent.Parent
other.Door1.CanCollide = false
other.Door1.Transparency = 1
other.Door2.CanCollide = true
other.Door2.Transparency = 0
model.Door1.CanCollide = false
model.Door1.Transparency = 1
model.Door2.CanCollide = true
model.Door2.Transparency = 0
model.Name = &quot;Activating components&quot;
other.Name = &quot;Activating components&quot;
wait(.2)
model.Name = &quot;Activating components.&quot;
other.Name = &quot;Activating components.&quot;
wait(.2)
model.Name = &quot;Activating components..&quot;
other.Name = &quot;Activating components..&quot;
wait(.2)
model.Name = &quot;Activating components...&quot;
other.Name = &quot;Activating components...&quot;
wait(.2)
model.Name = &quot;Connecting to telenet...&quot;
other.Name = &quot;Connecting to telenet...&quot;
wait(.5)
model.Name = &quot;Locating desired teleporter...&quot;
other.Name = &quot;Locating desired teleporter...&quot;
wait(.5)
model.Name = &quot;Desired teleporter found&quot;
other.Name = &quot;Desired teleporter found&quot;
wait(.5)
model.Name = &quot;Preparing to send player...&quot;
other.Name = &quot;Preparing to recieve player...&quot;
wait(.5)
model.Name = &quot;Begining teleportation...&quot;
other.Name = &quot;Begining teleportation...&quot;
wait(1)
model.Name = &quot;Teleporter is now&quot;
other.Name = &quot;Teleporter is now&quot;
wait(0.5)
model.Name = &quot;Sending...&quot;
other.Name = &quot;Recieving...&quot;
model.RSign.Transparency = 0.9
other.RSign.Transparency = 0.9
wait(.3)
model.RSign.Transparency = 0.8
other.RSign.Transparency = 0.8
wait(.3)
model.RSign.Transparency = 0.85
other.RSign.Transparency = 0.85
wait(.3)
model.RSign.Transparency = 0.7
other.RSign.Transparency = 0.7
wait(.3)
model.RSign.Transparency = 0.8
other.RSign.Transparency = 0.8
wait(.3)
model.RSign.Transparency = 0.65
other.RSign.Transparency = 0.65
wait(.3)
model.RSign.Transparency = 0.7
other.RSign.Transparency = 0.7
wait(.3)
