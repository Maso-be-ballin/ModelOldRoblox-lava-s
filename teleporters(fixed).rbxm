wait(.3)
model.RSign.Transparency = 1
other.RSign.Transparency = 1
model.Name = &quot;Player has been sucessfully teleported.&quot;
other.Name = &quot;Player has been sucessfully teleported.&quot;
model.Door1.CanCollide = true
model.Door1.Transparency = 0
