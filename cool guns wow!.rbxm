			<Item class="LocalScript" referent="RBX2856">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Shooter</string>
					<ProtectedString name="Source">Tool = script.Parent

local arms = nil
local torso = nil
local weld33 = nil -- right arm
local weld55 = nil -- left arm
local welds = {}
local reloading = false
local firing = false
local canreload = true
local canshoot = true
local damage = 200



function ReloadSequence()
weld33.C1 = CFrame.new(-0.95, 0.05, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-91), math.rad(-35), 0.2) 
weld55.C1 = CFrame.new(1.27, 0.85, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(275), 0.83, math.rad(-0))
wait(.04)
weld33.C1 = CFrame.new(-0.85, 0.2, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-92), math.rad(-35), 0.4) 
weld55.C1 = CFrame.new(1.24, 0.55, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(275), 0.96, math.rad(-0))
wait(.04)
