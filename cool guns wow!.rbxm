				<Item class="Script" referent="RBX2543">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Player Injury Blood Script</string>
						<ProtectedString name="Source">-- seandewar5
game.Workspace.ChildAdded:connect(function(child)

P = game.Players:GetPlayerFromCharacter(child)

if P ~= nil then

&#9;if P.Character ~= nil then

&#9;&#9;H = P.Character:findFirstChild(&quot;Humanoid&quot;)

&#9;&#9;if H ~= nil then

&#9;&#9;&#9;T = P.Character:findFirstChild(&quot;Head&quot;)

&#9;&#9;&#9;-- Only give to players who have a Humanoid and a Torso..
&#9;&#9;&#9;if T ~= nil then

&#9;&#9;&#9;&#9;giveblood = script.BloodS:clone()
&#9;&#9;&#9;&#9;giveblood.Disabled = false
&#9;&#9;&#9;&#9;giveblood.Parent = P.Character

&#9;&#9;&#9;end

&#9;&#9;end

&#9;end

end

end)</ProtectedString>
					</Properties>
					<Item class="Script" referent="RBX2544">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">BloodS</string>
							<ProtectedString name="Source">--seandewar5

function MakeBlood()

local blood = Instance.new(&quot;Part&quot;)
blood.formFactor = &quot;Plate&quot;
blood.Size = Vector3.new(1,0.4,1)
blood.Name = &quot;Blood&quot;
blood.Reflectance = 0
blood.Transparency = 0
blood.BrickColor = BrickColor.new(&quot;Really red&quot;)
blood.Locked = true
blood.BackSurface = &quot;Smooth&quot;
blood.TopSurface = &quot;Smooth&quot;

local CC = math.random(1,2)

if CC == 0.1 then

blood.CanCollide = false

elseif CC == 0.1 then

blood.CanCollide = false

end

blood.Position = script.Parent.Torso.Position
blood.Parent = script.Parent

end

humanoid = script.Parent.Humanoid
lhh = humanoid.Health

while true do

if humanoid.Health &lt; lhh then

howmuch = math.random(5,10)
lhh = humanoid.Health

for i = 1 , howmuch do

MakeBlood()

end

end

wait(0.1)
end
</ProtectedString>
						</Properties>
					</Item>
				</Item>
				<Item class="Script" referent="RBX2545">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local Tool = script.Parent;

enabled = true




function onActivated()
&#9;if not enabled  then
&#9;&#9;return
&#9;end

&#9;enabled = false
&#9;Tool.GripForward = Vector3.new(1, 0.01, -1.49e-008)
&#9;Tool.GripPos = Vector3.new(1.5, -0.7, -0.1)
&#9;Tool.GripRight = Vector3.new(0.00109, -0.109, 0.994)
&#9;Tool.GripUp = Vector3.new(-0.00994, 0.994, 0.109)


&#9;Tool.Handle.Sound:Play()

&#9;wait(3)
&#9;
&#9;local h = Tool.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;if (h ~= nil) then
&#9;&#9;&#9;Tool.Handle.Fire:Play()
&#9;&#9;&#9;h.Health = h.MaxHealth
&#9;end

&#9;Tool.GripForward = Vector3.new(-0, 0, -1)
&#9;Tool.GripPos = Vector3.new(0.2, 0, -0.1)
&#9;Tool.GripRight = Vector3.new(1, 0, 0)
&#9;Tool.GripUp = Vector3.new(-0, 1, 0)

&#9;enabled = true

end

function onEquipped()
&#9;Tool.Handle.Sound:play()
end

script.Parent.Activated:connect(onActivated)
script.Parent.Equipped:connect(onEquipped)
</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX2546">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">Tool = script.Parent

local field = nil

function Heal()

&#9;

&#9;local vCharacter = Tool.Parent

&#9;local childs = vCharacter:GetChildren()

&#9;local colors = {}


&#9;wait(1)

&#9;local human = vCharacter:FindFirstChild(&quot;Humanoid&quot;)
&#9;if (human ~= nil) then
&#9;&#9;human.Health = human.MaxHealth
&#9;&#9;Tool.Handle.Fire:Play()
&#9;&#9;wait(0.001)
&#9;&#9;human.Parent.Head:Remove()
&#9;&#9;wait(1)
&#9;&#9;human.Health = human.Health - 100
&#9;&#9;wait(1)
&#9;&#9;human.Health = human.Health - 100
&#9;&#9;wait(1)
&#9;&#9;human.Health = human.Health - 100
&#9;&#9;wait(1)
&#9;&#9;human.Health = human.Health - 100
&#9;&#9;wait(1)
&#9;&#9;human.Health = human.Health - 100
&#9;&#9;wait(1)
&#9;&#9;human.Health = human.Health - 100
&#9;&#9;wait(1)
&#9;&#9;human.Health = human.Health - 100
&#9;&#9;wait(1)
&#9;&#9;human.Health = human.Health - 100
&#9;&#9;wait(1)
&#9;&#9;human.Health = human.Health - 100
&#9;&#9;wait(1)
&#9;&#9;human.Health = human.Health - 50
&#9;&#9;wait(1)
&#9;&#9;human.Health = human.Health - 50
&#9;&#9;wait(1)
&#9;end


end



Tool.Enabled = true
function onActivated()

&#9;if not Tool.Enabled then
&#9;&#9;return
&#9;end

&#9;Tool.Enabled = false

&#9;Heal()
&#9;wait(2)
&#9;Tool.Enabled = true
end


script.Parent.Activated:connect(onActivated)



</ProtectedString>
					</Properties>
				</Item>
