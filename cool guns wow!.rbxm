			<Item class="LocalScript" referent="RBX2022">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Shooter</string>
					<ProtectedString name="Source">Tool = script.Parent

local arms = nil
local torso = nil
local weld33 = nil -- right arm
local weld55 = nil -- left arm
local welds = {}
local reloading = false
local firing = false


function ReloadSequence() -- this will be a pain in my blocky butt.
local mag = Tool.Mag:clone()
mag.Parent = game.Workspace
game:GetService(&quot;Debris&quot;):addItem(mag,6)
Tool.Mag.Transparency = 1
local mag2 = Instance.new(&quot;Part&quot;)
mag2.Size = Vector3.new(1,1,1)
mag2.BrickColor = BrickColor.new(26)
mag2.Parent = game.Workspace
local magmesh2 = Instance.new(&quot;BlockMesh&quot;)
magmesh2.Scale = Vector3.new(0.143, 1.36, 0.286)
magmesh2.Parent = mag2
local magweld = Instance.new(&quot;Weld&quot;)
leftarm = Tool.Parent[&quot;Left Arm&quot;]
magweld.Parent = mag2
magweld.Part0 = mag2
magweld.Part1 = leftarm
magweld.C0 = CFrame.new(-1,0,0.3)
magweld.C0 = magweld.C0 * CFrame.fromEulerAnglesXYZ(0,0.6,1.6)
weld55.C1 = CFrame.new(-0.35, 0.5, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(260), -1.2, math.rad(-50))
wait(.1)
weld55.C1 = CFrame.new(-0.35, 0.5, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(265), -1.1, math.rad(-50))
wait(.035)
weld55.C1 = CFrame.new(-0.35, 0.5, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(270), -1, math.rad(-60))
wait(.035)
weld55.C1 = CFrame.new(-0.35, 0.5, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(275), -0.9, math.rad(-60))
wait(.035)
weld55.C1 = CFrame.new(-0.35, 0.5, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(280), -0.8, math.rad(-70))
wait(.035)
weld55.C1 = CFrame.new(-0.35, 0.5, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(285), -0.7, math.rad(-70))
wait(.035)
weld55.C1 = CFrame.new(-0.35, 0.5, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -0.6, math.rad(-80))
wait(.035)
weld55.C1 = CFrame.new(-0.35, 0.5, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -0.5, math.rad(-80))
wait(.035)
weld55.C1 = CFrame.new(-0.35, 0.5, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -0.4, math.rad(-90))
wait(.035)
weld55.C1 = CFrame.new(-0.35, 0.5, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -0.3, math.rad(-90))
wait(.035)
weld55.C1 = CFrame.new(-0.35, 0.5, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -0.2, math.rad(-90))
wait(.035)
mag2:remove()
Tool.Mag.Transparency = 0
weld55.C1 = CFrame.new(-0.35, 0.5, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
weld33.C1 = CFrame.new(-0.75, 0.5, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-10),-.2)
wait(.035)
weld55.C1 = CFrame.new(-0.35, 0.5, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-50))

wait(.035)
weld55.C1 = CFrame.new(-0.35, 0.5, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0.2, math.rad(-90))
weld33.C1 = CFrame.new(-0.75, 0.5, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-10),-.3)
wait(.035)
weld55.C1 = CFrame.new(-0.35, 0.5, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0.4, math.rad(-90))
weld33.C1 = CFrame.new(-0.75, 0.5, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-10),-.4)
wait(.035)
weld55.C1 = CFrame.new(-0.35, 0.9, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0.4, math.rad(-90))
weld33.C1 = CFrame.new(-0.75, 0.5, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-10),-.5)
Tool.Handle.Reload4:play()
wait(.035)
Tool.C1.Mesh.Offset = Vector3.new(0,0,0.1125)
Tool.C2.Mesh.Offset = Vector3.new(0,0,0.1125)
Tool.C3.Mesh.Offset = Vector3.new(0,0,0.1125)
weld55.C1 = CFrame.new(-0.35, 0.85, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0.4, math.rad(-90))
wait(.035)
Tool.C1.Mesh.Offset = Vector3.new(0,0,0.225)
Tool.C2.Mesh.Offset = Vector3.new(0,0,0.225)
Tool.C3.Mesh.Offset = Vector3.new(0,0,0.225)
weld55.C1 = CFrame.new(-0.35, 0.7, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0.4, math.rad(-90))
wait(.035)
Tool.C1.Mesh.Offset = Vector3.new(0,0,0.35)
Tool.C2.Mesh.Offset = Vector3.new(0,0,0.35)
Tool.C3.Mesh.Offset = Vector3.new(0,0,0.35)
weld55.C1 = CFrame.new(-0.35, 0.55, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0.4, math.rad(-90))
wait(.035)
Tool.C1.Mesh.Offset = Vector3.new(0,0,0.425)
Tool.C2.Mesh.Offset = Vector3.new(0,0,0.425)
Tool.C3.Mesh.Offset = Vector3.new(0,0,0.425)
weld55.C1 = CFrame.new(-0.35, 0.4, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0.4, math.rad(-90))

wait(.035)
Tool.C1.Mesh.Offset = Vector3.new(0,0,0.45)
Tool.C2.Mesh.Offset = Vector3.new(0,0,0.45)
Tool.C3.Mesh.Offset = Vector3.new(0,0,0.45)
weld55.C1 = CFrame.new(-0.35, 0.25, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0.4, math.rad(-90))
wait(.035)
Tool.C1.Mesh.Offset = Vector3.new(0,0,0.425)
Tool.C2.Mesh.Offset = Vector3.new(0,0,0.425)
Tool.C3.Mesh.Offset = Vector3.new(0,0,0.425)
weld55.C1 = CFrame.new(-0.35, 0.4, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0.4, math.rad(-90))
wait(.035)
Tool.C1.Mesh.Offset = Vector3.new(0,0,0.35)
Tool.C2.Mesh.Offset = Vector3.new(0,0,0.35)
Tool.C3.Mesh.Offset = Vector3.new(0,0,0.35)
weld55.C1 = CFrame.new(-0.35, 0.55, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0.4, math.rad(-90))
wait(.035)
Tool.C1.Mesh.Offset = Vector3.new(0,0,0.225)
Tool.C2.Mesh.Offset = Vector3.new(0,0,0.225)
Tool.C3.Mesh.Offset = Vector3.new(0,0,0.225)
weld55.C1 = CFrame.new(-0.35, 0.7, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0.4, math.rad(-90))
wait(.035)
Tool.C1.Mesh.Offset = Vector3.new(0,0,0.1125)
Tool.C2.Mesh.Offset = Vector3.new(0,0,0.1125)
Tool.C3.Mesh.Offset = Vector3.new(0,0,0.1125)
weld55.C1 = CFrame.new(-0.35, 0.75, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0.4, math.rad(-90))
