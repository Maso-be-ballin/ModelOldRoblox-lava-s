Game:GetService(&quot;ContentProvider&quot;):Preload(&quot;http://www.roblox.com/asset/?id=57571495&quot;)
Game:GetService(&quot;ContentProvider&quot;):Preload(&quot;http://www.roblox.com/asset/?id=77831264&quot;)
--
local cc = game.Workspace.CurrentCamera -- Don&apos;t touch
local lp = game.Players.LocalPlayer -- Don&apos;t touch
local zoomed = false -- Don&apos;t touch
local thermalon = false --Don&apos;t touch
local alreadyLoaded = false -- Don&apos;t touch
local readytofire = true -- Don&apos;t touch
local tab = {} -- Don&apos;t touch
local scope_Time = .35 -- Customize
local unscope_Time = 0 -- Don&apos;t touch
local currentzoom = 20 -- Don&apos;t touch
--
gatherparts = function(dir)
tab = {}
&#9;for i, v in pairs(dir:GetChildren()) do
&#9;&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;tab[#tab+1] = v
&#9;&#9;end
&#9;end
&#9;return tab
end
--
killcheck = function(obj, poshit, orient)
&#9;if obj and not zoomed then
&#9;&#9;if obj.Parent:findFirstChild(&quot;Humanoid&quot;) then
&#9;&#9;&#9;if obj.Parent.Humanoid.Health &gt; 1 then
&#9;&#9;&#9;&#9;player = obj.Parent
&#9;&#9;&#9;&#9;if obj.Name == &quot;Right Leg&quot; or obj.Name == &quot;Left Leg&quot; then
&#9;&#9;&#9;&#9;&#9;player.Humanoid:TakeDamage(math.random(50,80))
&#9;&#9;&#9;&#9;elseif obj.Name == &quot;Right Arm&quot; or obj.Name == &quot;Left Arm&quot; then
&#9;&#9;&#9;&#9;&#9;player.Humanoid:TakeDamage(math.random(55,125))
&#9;&#9;&#9;&#9;&#9;if player.Humanoid.Health &lt;= 0 then
&#9;&#9;&#9;&#9;&#9;&#9;setLabel(scope.KillLabel, &quot;No-Scope&quot;, 4)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;elseif obj.Name == &quot;Head&quot; then
&#9;&#9;&#9;&#9;&#9;player.Humanoid.Health = 0
&#9;&#9;&#9;&#9;&#9;setLabel(scope.KillLabel, &quot;Boom, Headshot No-Scope&quot;, 4)
&#9;&#9;&#9;&#9;elseif obj.Name == &quot;Torso&quot; then
&#9;&#9;&#9;&#9;&#9;setLabel(scope.KillLabel, &quot;No-Scope&quot;, 4)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;player.Humanoid:TakeDamage(200)
&#9;&#9;&#9;&#9;&#9;rayn = Ray.new(poshit, orient * 8)
&#9;&#9;&#9;&#9;&#9;newobj, newpos = game.Workspace:FindPartOnRayWithIgnoreList(rayn, gatherparts(player))
&#9;&#9;&#9;&#9;&#9;killcheck(newobj, newpos, orient * 8)
&#9;&#9;&#9;&#9;&#9;local faderay = Instance.new(&quot;Part&quot;, Workspace)
&#9;&#9;&#9;&#9;&#9;faderay.Size = Vector3.new(1, 1, 8)
&#9;&#9;&#9;&#9;&#9;faderay.CFrame = CFrame.new(poshit, newpos) * CFrame.new(0, 0, (-faderay.Size.z / 2))
&#9;&#9;&#9;&#9;&#9;faderay.Anchored = true
&#9;&#9;&#9;&#9;&#9;faderay.CanCollide = false
&#9;&#9;&#9;&#9;&#9;faderay.Transparency = .8
&#9;&#9;&#9;&#9;&#9;fadeout(faderay, .01, 0)
&#9;&#9;&#9;&#9;&#9;mesh = Instance.new(&quot;BlockMesh&quot;,faderay)
&#9;&#9;&#9;&#9;&#9;mesh.Scale = Vector3.new(.25,.25,1)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;else
&#9;&#9;if obj then
&#9;&#9;&#9;if obj.Parent:findFirstChild(&quot;Humanoid&quot;) then
&#9;&#9;&#9;&#9;if obj.Parent.Humanoid.Health &gt; 1 then
&#9;&#9;&#9;&#9;&#9;player = obj.Parent
&#9;&#9;&#9;&#9;&#9;if obj.Name == &quot;Right Leg&quot; or obj.Name == &quot;Left Leg&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;player.Humanoid:TakeDamage(math.random(50,80))
&#9;&#9;&#9;&#9;&#9;elseif obj.Name == &quot;Right Arm&quot; or obj.Name == &quot;Left Arm&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;player.Humanoid:TakeDamage(math.random(55,125))
&#9;&#9;&#9;&#9;&#9;&#9;if player.Humanoid.Health &lt;= 0 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;setLabel(scope.KillLabel, &quot;One Shot, One Kill&quot;, 4)
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;elseif obj.Name == &quot;Head&quot; and player:findFirstChild(&quot;Head&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;player.Humanoid.Health = 0
&#9;&#9;&#9;&#9;&#9;&#9;setLabel(scope.KillLabel, &quot;Boom, Headshot&quot;, 4)
&#9;&#9;&#9;&#9;&#9;elseif obj.Name == &quot;Torso&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;player.Humanoid.Health = 0
&#9;&#9;&#9;&#9;&#9;&#9;setLabel(scope.KillLabel, &quot;One Shot, One Kill&quot;, 4)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;player.Humanoid:TakeDamage(200)
&#9;&#9;&#9;&#9;&#9;rayn = Ray.new(poshit, orient * 8)
&#9;&#9;&#9;&#9;&#9;newobj, newpos = game.Workspace:FindPartOnRayWithIgnoreList(rayn, gatherparts(player))
&#9;&#9;&#9;&#9;&#9;killcheck(newobj, newpos, orient * 8)
&#9;&#9;&#9;&#9;&#9;local faderay = Instance.new(&quot;Part&quot;, Workspace)
&#9;&#9;&#9;&#9;&#9;faderay.Size = Vector3.new(1, 1, 8)
&#9;&#9;&#9;&#9;&#9;faderay.CFrame = CFrame.new(poshit, newpos) * CFrame.new(0, 0, (-faderay.Size.z / 2))
&#9;&#9;&#9;&#9;&#9;faderay.Anchored = true
&#9;&#9;&#9;&#9;&#9;faderay.CanCollide = false
&#9;&#9;&#9;&#9;&#9;faderay.Transparency = .8
&#9;&#9;&#9;&#9;&#9;fadeout(faderay, .01, 0)
&#9;&#9;&#9;&#9;&#9;mesh = Instance.new(&quot;BlockMesh&quot;,faderay)
&#9;&#9;&#9;&#9;&#9;mesh.Scale = Vector3.new(.25,.25,1)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end
--
fadeout = function(obj, rate, waittime)
&#9;coroutine.resume(coroutine.create(function()
&#9;&#9;currentTrans = obj.Transparency
&#9;&#9;for i = currentTrans, 1, rate do
&#9;&#9;&#9;obj.Transparency = i
&#9;&#9;&#9;wait(waittime)
&#9;&#9;end
&#9;&#9;obj:Destroy()
&#9;end))
end
--
fix = function()
ignoretab = {}
&#9;for i, v in pairs(game.Players:GetPlayers()) do
&#9;&#9;for ii, vv in pairs(v.Character:GetChildren()) do
&#9;&#9;&#9;if vv:IsA(&quot;Hat&quot;) or vv:IsA(&quot;Tool&quot;) then
&#9;&#9;&#9;&#9;ignoretab[#ignoretab+1] = vv
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return ignoretab
end
--
fireanim = function(obj)
&#9;obj.ReadyBar.GreenBar.Size = UDim2.new(0,0,1,0)
&#9;obj.ReadyBar.GreenBar.Text = &quot;&quot;
&#9;for i = 0, 1, .03 do
&#9;&#9;wait()
&#9;&#9;obj.ReadyBar.GreenBar.Size = UDim2.new(i,0,1,0)
&#9;end
&#9;obj.ReadyBar.GreenBar.Size = UDim2.new(1,0,1,0)
&#9;obj.ReadyBar.GreenBar.Text = &quot;Ready&quot;
end
--
for i = -2, 2, .02 do
&#9;tab[#tab+1] = i
end
--
recoil = function(scopedin) --
&#9;if scopedin then --
&#9;&#9;for i = 0, 8 do --
&#9;&#9;&#9;wait()
&#9;&#9;&#9;cc.Focus = cc.Focus * CFrame.new(.015, .015, 0)
&#9;&#9;end --
&#9;&#9;for i = 0, 8 do --
&#9;&#9;&#9;wait()
&#9;&#9;&#9;cc.Focus = cc.Focus * CFrame.new(-.015, -.015, 0)
&#9;&#9;end --
&#9;end
&#9;if not scopedin then
&#9;&#9;for i = 0, 2 do --
&#9;&#9;&#9;wait()
&#9;&#9;&#9;cc.Focus = cc.Focus * CFrame.new(.015, .015, 0)
&#9;&#9;end --
&#9;&#9;for i = 0, 4 do --
&#9;&#9;&#9;wait()
&#9;&#9;&#9;cc.Focus = cc.Focus * CFrame.new(-.01, -.01, 0)
&#9;&#9;end
&#9;end --
end --
--
loadWeapon = function()
&#9;if not alreadyLoaded then
&#9;&#9;alreadyLoaded = true
&#9;&#9;originalName = script.Parent.Name
&#9;&#9;loaded = false
&#9;&#9;coroutine.resume(coroutine.create(function()
&#9;&#9;&#9;while not loaded do
&#9;&#9;&#9;&#9;for i = 1, 3 do
&#9;&#9;&#9;&#9;&#9;wait(.5)
&#9;&#9;&#9;&#9;&#9;name = &quot;Loading&quot;
&#9;&#9;&#9;&#9;&#9;script.Parent.Name = name..string.rep(&quot;.&quot;,i)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;script.Parent.Name = originalName
&#9;&#9;end))
&#9;&#9;wait(3)
&#9;&#9;loaded = true
&#9;end
end
--]]
setLabel = function(label, text, waittime)
&#9;coroutine.resume(coroutine.create(function()
&#9;&#9;labelActive = true
&#9;&#9;label.Text = text
&#9;&#9;wait(3)
&#9;&#9;label.Text = &quot;&quot;
&#9;&#9;label.TextTransparency = 0
&#9;end))
end
--
script.Parent.Equipped:connect(function(mouse)
--loadWeapon()
&#9;lp.CameraMode = 1
&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=57571495&quot;
&#9;if script.Parent:findFirstChild(&quot;Zoom&quot;) then
&#9;&#9;script.Parent.Zoom.Parent = lp.PlayerGui
&#9;&#9;scope = lp.PlayerGui.Zoom
&#9;&#9;tf = lp.PlayerGui.Zoom.Scope.ThermalFrame
&#9;end
&#9;mouse.Button1Down:connect(function()
&#9;&#9;if readytofire then
&#9;&#9;&#9;readytofire = false
&#9;&#9;&#9;if zoomed then
&#9;&#9;&#9;&#9;Rayr = Ray.new(script.Parent.Parent.Head.CFrame.p,(mouse.Hit.p - script.Parent.Parent.Head.CFrame.p).unit * 999) 
&#9;&#9;&#9;&#9;obje,pos = game.Workspace:FindPartOnRayWithIgnoreList(Rayr, fix())
-- Make a bullet trail
&#9;&#9;&#9;&#9;local faderay = Instance.new(&quot;Part&quot;, Workspace)
&#9;&#9;&#9;&#9;faderay.Size = Vector3.new(1, 1, math.abs(math.ceil((pos-script.Parent.Barrel.CFrame.p).magnitude)))
&#9;&#9;&#9;&#9;faderay.CFrame = CFrame.new(script.Parent.Barrel.CFrame.p, pos) * CFrame.new(0, 0, (-faderay.Size.z / 2))
&#9;&#9;&#9;&#9;faderay.Anchored = true
&#9;&#9;&#9;&#9;faderay.CanCollide = false
&#9;&#9;&#9;&#9;faderay.Transparency = .8
&#9;&#9;&#9;&#9;fadeout(faderay, .01, 0)
&#9;&#9;&#9;&#9;mesh = Instance.new(&quot;BlockMesh&quot;,faderay)
&#9;&#9;&#9;&#9;mesh.Scale = Vector3.new(.25,.25,1)
-- End of making a bullet trail
&#9;&#9;&#9;&#9;newvar = (mouse.Hit.p - script.Parent.Parent.Head.CFrame.p).unit
&#9;&#9;&#9;&#9;killcheck(obje, pos, newvar) -------------------------------------------- New kill function
&#9;&#9;&#9;&#9;coroutine.resume(coroutine.create(function()
&#9;&#9;&#9;&#9;&#9;recoil(true)
&#9;&#9;&#9;&#9;end))
&#9;&#9;&#9;end
&#9;&#9;&#9;if not zoomed then 
&#9;&#9;&#9;&#9;var1, var2, var3 = tab[math.random(1,#tab)], tab[math.random(1,#tab)], tab[math.random(1,#tab)]
&#9;&#9;&#9;&#9;Rayr = Ray.new(script.Parent.Barrel.CFrame.p,(mouse.Hit.p+Vector3.new(var1, var2, var3) - script.Parent.Barrel.CFrame.p).unit * 999) 
&#9;&#9;&#9;&#9;obje,pos = game.Workspace:FindPartOnRayWithIgnoreList(Rayr, fix())
-- Make a bullet trail
&#9;&#9;&#9;&#9;local faderay = Instance.new(&quot;Part&quot;, Workspace)
&#9;&#9;&#9;&#9;faderay.Size = Vector3.new(1, 1, math.abs(math.ceil((pos-script.Parent.Barrel.CFrame.p).magnitude)))
&#9;&#9;&#9;&#9;faderay.CFrame = CFrame.new(script.Parent.Barrel.CFrame.p, pos) * CFrame.new(0, 0, (-faderay.Size.z / 2))
&#9;&#9;&#9;&#9;faderay.Anchored = true
&#9;&#9;&#9;&#9;faderay.CanCollide = false
&#9;&#9;&#9;&#9;faderay.Transparency = .8
&#9;&#9;&#9;&#9;fadeout(faderay, .01, 0)
&#9;&#9;&#9;&#9;mesh = Instance.new(&quot;BlockMesh&quot;,faderay)
&#9;&#9;&#9;&#9;mesh.Scale = Vector3.new(.25,.25,1)
-- End of making a bullet trail
&#9;&#9;&#9;&#9;newvar2 = (mouse.Hit.p+Vector3.new(var1, var2, var3) - script.Parent.Barrel.CFrame.p).unit
&#9;&#9;&#9;&#9;killcheck(obje, pos, newvar2) -------------------------- New kill function
&#9;&#9;&#9;&#9;coroutine.resume(coroutine.create(function()
&#9;&#9;&#9;&#9;&#9;recoil(false)
&#9;&#9;&#9;&#9;end))
&#9;&#9;&#9;end -- Debounce
&#9;&#9;&#9;fireanim(scope)
&#9;&#9;&#9;readytofire = true
&#9;&#9;end
&#9;end)
&#9;mouse.KeyUp:connect(function(key2)
&#9;&#9;if string.lower(key2) == &quot;r&quot; and zoomed then
&#9;&#9;&#9;zo = scope.Switch_Zoom
&#9;&#9;&#9;rdown = false
&#9;&#9;&#9;zo:TweenPosition(UDim2.new(0.25, 10, 0.75, 25), &quot;Out&quot;, &quot;Sine&quot;, .75, true)
&#9;&#9;elseif string.lower(key2) == &quot;f&quot; and zoomed then
&#9;&#9;&#9;zo = scope.Switch_Zoom
&#9;&#9;&#9;fdown = false
&#9;&#9;&#9;zo:TweenPosition(UDim2.new(0.25, 10, 0.75, 25), &quot;Out&quot;, &quot;Sine&quot;, .75, true)
&#9;&#9;end
&#9;end)
&#9;mouse.KeyDown:connect(function(key)
&#9;&#9;if string.lower(key) == &quot;q&quot; and not zoomed then
&#9;&#9;&#9;zoomed = true
&#9;&#9;&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=77831264&quot; -- Scope Crosshair
--[[ Size and Position 
&#9;&#9;&#9;scope.Scope.ScopeImage:TweenSizeAndPosition(UDim2.new(0, 442, 0, 438), UDim2.new(0.5, -221, 0.5, -219), &quot;Out&quot;, &quot;Sine&quot;, .89)
&#9;&#9;&#9;scope.Scope.B1:TweenSizeAndPosition(UDim2.new(1, 0, 0.5, 3), UDim2.new(0, 0, 0, -216), &quot;Out&quot;, &quot;Sine&quot;, .89)
&#9;&#9;&#9;scope.Scope.B2:TweenSizeAndPosition(UDim2.new(1, 0, 0.5, 0), UDim2.new(0, 0, 0.5, 219), &quot;Out&quot;, &quot;Sine&quot;, .89)
&#9;&#9;&#9;scope.Scope.B3:TweenSizeAndPosition(UDim2.new(0.5, -218, 1, 0), UDim2.new(0, 0, 0, 0), &quot;Out&quot;, &quot;Sine&quot;, .89)
&#9;&#9;&#9;scope.Scope.B4:TweenSizeAndPosition(UDim2.new(0.5, 0, 1, 0), UDim2.new(0.5, 221, 0, 0), &quot;Out&quot;, &quot;Sine&quot;, .89)
--]]
-- Position 
&#9;&#9;&#9;scope.Scope.ScopeImage:TweenPosition(UDim2.new(0.5, -221, 0.5, -219), &quot;Out&quot;, &quot;Sine&quot;, scope_Time, true)
&#9;&#9;&#9;scope.Scope.B1:TweenPosition(UDim2.new(0, 0, 0, -216), &quot;Out&quot;, &quot;Sine&quot;, scope_Time, true)
&#9;&#9;&#9;scope.Scope.B2:TweenPosition(UDim2.new(0, 0, 0.5, 219), &quot;Out&quot;, &quot;Sine&quot;, scope_Time, true)
&#9;&#9;&#9;scope.Scope.B3:TweenPosition(UDim2.new(0, 0, 0, 0), &quot;Out&quot;, &quot;Sine&quot;, scope_Time, true)
&#9;&#9;&#9;scope.Scope.B4:TweenPosition(UDim2.new(0.5, 221, 0, 0), &quot;Out&quot;, &quot;Sine&quot;, scope_Time, true)
&#9;&#9;&#9;coroutine.resume(coroutine.create(function()
&#9;&#9;&#9;&#9;wait(scope_Time)
&#9;&#9;&#9;&#9;scope.Scope.ThermalLabel.Visible = true
&#9;&#9;&#9;end))
--
&#9;&#9;&#9;coroutine.resume(coroutine.create(function()
&#9;&#9;&#9;&#9;for i = 70, 20, -4 do
&#9;&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;&#9;&#9;cc.FieldOfView = i --Zoomed
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end))
&#9;&#9;elseif zoomed and string.lower(key) == &quot;q&quot; then
&#9;&#9;&#9;thermalon = false
&#9;&#9;&#9;scope.Scope.ThermalFrame.Visible = false
&#9;&#9;&#9;zoomed = false
&#9;&#9;&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=57571495&quot; -- Crosshair
--[[ Size and Position
&#9;&#9;&#9;scope.Scope.ScopeImage:TweenSizeAndPosition(UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 1, 0), &quot;Out&quot;, &quot;Sine&quot;, .89)
&#9;&#9;&#9;scope.Scope.B1:TweenSizeAndPosition(UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 1, 0), &quot;Out&quot;, &quot;Sine&quot;, .89)
&#9;&#9;&#9;scope.Scope.B2:TweenSizeAndPosition(UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 1, 0), &quot;Out&quot;, &quot;Sine&quot;, .89)
&#9;&#9;&#9;scope.Scope.B3:TweenSizeAndPosition(UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 1, 0), &quot;Out&quot;, &quot;Sine&quot;, .89)
&#9;&#9;&#9;scope.Scope.B4:TweenSizeAndPosition(UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 1, 0), &quot;Out&quot;, &quot;Sine&quot;, .89)
--]]
-- Position
&#9;&#9;&#9;scope.Scope.ScopeImage:TweenPosition(UDim2.new(1, 0, 1, 0), &quot;Out&quot;, &quot;Sine&quot;, scope_Time, true)
&#9;&#9;&#9;scope.Scope.B1:TweenPosition(UDim2.new(1, 0, 1, 0), &quot;Out&quot;, &quot;Sine&quot;, scope_Time, true)
&#9;&#9;&#9;scope.Scope.B2:TweenPosition(UDim2.new(1, 0, 1, 0), &quot;Out&quot;, &quot;Sine&quot;, scope_Time, true)
&#9;&#9;&#9;scope.Scope.B3:TweenPosition(UDim2.new(1, 0, 1, 0), &quot;Out&quot;, &quot;Sine&quot;, scope_Time, true)
&#9;&#9;&#9;scope.Scope.B4:TweenPosition(UDim2.new(1, 0, 1, 0), &quot;Out&quot;, &quot;Sine&quot;, scope_Time, true)
&#9;&#9;&#9;scope.Scope.ThermalLabel.Visible = false
--
&#9;&#9;&#9;coroutine.resume(coroutine.create(function()
&#9;&#9;&#9;&#9;for i = 20, 70, 4 do
&#9;&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;&#9;&#9;cc.FieldOfView = i --Not zoomed
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end))
&#9;&#9;elseif string.lower(key) == &quot;r&quot; and zoomed then
&#9;&#9;&#9;zo = scope.Switch_Zoom
&#9;&#9;&#9;zolabel = zo.Num_Zoom
&#9;&#9;&#9;rdown = true
&#9;&#9;&#9;zo:TweenPosition(UDim2.new(0.25, 50, 0.75, 25), &quot;Out&quot;, &quot;Sine&quot;, .5, true)
&#9;&#9;&#9;coroutine.resume(coroutine.create(function()
&#9;&#9;&#9;&#9;while wait(.05) and rdown and not fdown and currentzoom &gt;= 21 do
&#9;&#9;&#9;&#9;&#9;currentzoom = currentzoom - 1
&#9;&#9;&#9;&#9;&#9;cc.FieldOfView = currentzoom
&#9;&#9;&#9;&#9;&#9;zolabel.Text = tostring(currentzoom)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end))
&#9;&#9;elseif string.lower(key) == &quot;f&quot; and zoomed then
&#9;&#9;&#9;zo = scope.Switch_Zoom
&#9;&#9;&#9;zolabel = zo.Num_Zoom
&#9;&#9;&#9;fdown = true
&#9;&#9;&#9;zo:TweenPosition(UDim2.new(0.25, 50, 0.75, 25), &quot;Out&quot;, &quot;Sine&quot;, .5, true)
&#9;&#9;&#9;coroutine.resume(coroutine.create(function()
&#9;&#9;&#9;&#9;while wait(.05) and fdown and not rdown and currentzoom &lt;= 69 do
&#9;&#9;&#9;&#9;&#9;currentzoom = currentzoom + 1
&#9;&#9;&#9;&#9;&#9;cc.FieldOfView = currentzoom
&#9;&#9;&#9;&#9;&#9;zolabel.Text = tostring(currentzoom)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end))
&#9;&#9;end
&#9;&#9;if string.lower(key) == &quot;e&quot; and not thermalon and zoomed then
&#9;&#9;&#9;tf.Visible = true
&#9;&#9;&#9;thermalon = true
&#9;&#9;&#9;for i, v in pairs(game.Players:GetChildren()) do
&#9;&#9;&#9;&#9;if v.Name ~= lp.Name then
&#9;&#9;&#9;&#9;&#9;for ii, vv in pairs(v.Character:GetChildren()) do
&#9;&#9;&#9;&#9;&#9;&#9;if vv:IsA(&quot;Part&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;local selection = Instance.new(&quot;SelectionBox&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;selection.Adornee = vv
&#9;&#9;&#9;&#9;&#9;&#9;&#9;selection.Color = BrickColor.new(&quot;Really red&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;selection.Name = &quot;Selection&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;selection.Parent = tf
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;elseif string.lower(key) == &quot;e&quot; and thermalon and zoomed then
&#9;&#9;&#9;thermalon = false
&#9;&#9;&#9;tf.Visible = false
&#9;&#9;&#9;for b, j in pairs(tf:GetChildren()) do
&#9;&#9;&#9;&#9;if j.Name == &quot;Selection&quot; then
&#9;&#9;&#9;&#9;&#9;j:Destroy()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)&#9;
end)

script.Parent.Unequipped:connect(function()
&#9;if scope then
&#9;&#9;zoomed = false
&#9;&#9;scope.Scope.ScopeImage:TweenPosition(UDim2.new(1, 0, 1, 0), &quot;Out&quot;, &quot;Sine&quot;, unscope_Time, false)
&#9;&#9;scope.Scope.B1:TweenPosition(UDim2.new(1, 0, 1, 0), &quot;Out&quot;, &quot;Sine&quot;, unscope_Time, false)
&#9;&#9;scope.Scope.B2:TweenPosition(UDim2.new(1, 0, 1, 0), &quot;Out&quot;, &quot;Sine&quot;, unscope_Time, false)
&#9;&#9;scope.Scope.B3:TweenPosition(UDim2.new(1, 0, 1, 0), &quot;Out&quot;, &quot;Sine&quot;, unscope_Time, false)
&#9;&#9;scope.Scope.B4:TweenPosition(UDim2.new(1, 0, 1, 0), &quot;Out&quot;, &quot;Sine&quot;, unscope_Time, false)
&#9;&#9;scope.Scope.ThermalFrame.Visible = false
&#9;&#9;thermalon = false
&#9;&#9;scope.Scope.ThermalLabel.Visible = false
&#9;&#9;lp.CameraMode = 0
&#9;&#9;cc.FieldOfView = 70
&#9;end
end)

</ProtectedString>
