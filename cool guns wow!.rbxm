		<Item class="Tool" referent="RBX4775">
			<Properties>
				<bool name="CanBeDropped">true</bool>
				<bool name="Enabled">true</bool>
				<CoordinateFrame name="Grip">
					<X>0</X>
					<Y>0</Y>
					<Z>0</Z>
					<R00>-0.0050099371</R00>
					<R01>0</R01>
					<R02>0.999987423</R02>
					<R10>0</R10>
					<R11>1</R11>
					<R12>0</R12>
					<R20>-0.999987423</R20>
					<R21>0</R21>
					<R22>-0.0050099371</R22>
				</CoordinateFrame>
				<string name="Name">Assault Rifle</string>
