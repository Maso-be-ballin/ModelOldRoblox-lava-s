			<Item class="Tool" referent="RBX1573">
				<Properties>
					<bool name="CanBeDropped">true</bool>
					<bool name="Enabled">true</bool>
					<CoordinateFrame name="Grip">
						<X>0</X>
						<Y>-0.150000006</Y>
						<Z>0.5</Z>
						<R00>0.925277114</R00>
