					<string name="Name">Zoom Script</string>
					<ProtectedString name="Source">local Tool = script.Parent
wut = Tool.Parent
&#9;repeat wait() until _G.RoLib _G.RoLib()
&#9;local headWeld
&#9;local char = getCharacter()
&#9;local head = waitForChild(char, &quot;Head&quot;)
&#9;local headFake = waitForChild(char, &quot;HeadFake&quot;)
&#9;if headFake == nil then
&#9;headFake = head:Clone()
&#9;end
&#9;for i, child in pairs(head:GetChildren()) do
&#9;&#9;if child.className == &quot;Weld&quot; then
&#9;&#9;&#9;child.Parent = headFake
&#9;&#9;&#9;child.Part0 = headFake
&#9;&#9;else
&#9;&#9;child:remove()
&#9;&#9;end
&#9;end
&#9;head.Transparency = 1
&#9;headFake.Name = &quot;HeadFake&quot;
&#9;headFake.Parent = char
&#9;headWeld = createWeld(head, headFake, CFrame.new(0, -0.5, 0), CFrame.new(0, -0.5, 0))

function onEquipped(mouse2)
&#9;mouse2.KeyDown:connect(onkeyDown)
&#9;mouse = mouse2
end

function onkeyDown(key) 
&#9;if key == &quot;z&quot; then
&#9;if Tool.Running.Value == false and a == false then 
&#9;&#9;game.Workspace.CurrentCamera.FieldOfView = 30
&#9;&#9;Tool.Aim.Value = 0.1
&#9;&#9;Tool.ZoomedIn.Value = true
&#9;&#9;Tool.Parent.Humanoid.WalkSpeed = 3
&#9;&#9;a=true
&#9;&#9;headWeld.C0 = CFrame.new(0, -0.5, 0) * CFrame.Angles(0, 0, Tool.ZoomedIn.Value == true and -math.pi / 8 or 0 )
&#9;
&#9;else
&#9;&#9;a=false
&#9;&#9;game.Workspace.CurrentCamera.FieldOfView = 70
&#9;&#9;Tool.ZoomedIn.Value = false
&#9;&#9;Tool.Aim.Value = 15
&#9;&#9;Tool.Parent.Humanoid.WalkSpeed = 16
&#9;&#9;headWeld.C0 = CFrame.new(0, -0.5, 0) * CFrame.Angles(0, 0, Tool.ZoomedIn.Value == true and -math.pi / 8 or 0 )
&#9;end
end 
end




script.Parent.Equipped:connect(onEquipped)
