							<string name="Name">Cursor</string>
							<ProtectedString name="Source">bin = game.Players.LocalPlayer
Tool = script.Parent
crosshair = Tool:findFirstChild(&quot;Crosshairs&quot;)
hitmarker = crosshair.Hit



function Run(mouse)
if  mouse ~= nil then
scope = Tool:findFirstChild(&quot;scoped&quot;)
player = mouse.Target

if hitmarker.Value == 0 then
if crosshair.Value == 1 then
mouse.Icon = &quot;http://www.roblox.com/asset/?id=47894823&quot; --- 1
elseif crosshair.Value == 2 then
