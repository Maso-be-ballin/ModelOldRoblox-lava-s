				<CoordinateFrame name="Grip">
					<X>-0.100000001</X>
					<Y>-0.239999995</Y>
					<Z>0.400000006</Z>
					<R00>0.8064484</R00>
					<R01>0</R01>
					<R02>0.591304481</R02>
					<R10>0</R10>
					<R11>1</R11>
					<R12>-0</R12>
