wait(.04)
weld33.C1 = CFrame.new(-0.95, 0.1, 0.25) * CFrame.fromEulerAnglesXYZ(math.rad(-99), math.rad(-25), 0)
weld55.C1 = CFrame.new(-0.25, -0.55, 0.7) * CFrame.fromEulerAnglesXYZ(math.rad(350), -0.7, math.rad(-55))
