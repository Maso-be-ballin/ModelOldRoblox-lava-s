function ReloadChoose()
   if script.Parent.Left.Value == 0 then
      ReloadSequence2()
   elseif script.Parent.Left.Value &gt;= 1 then
      ReloadSequence()
   end
end

function Choosy()
   if script.Parent.Ammo.Value == 0 then
      Thing1()
   elseif script.Parent.Ammo.Value &gt;= 1 then
      Thing2()
   end
end

function Thing2()
cam = game.Workspace.CurrentCamera
local cam_rot = cam.CoordinateFrame - cam.CoordinateFrame.p
local cam_scroll = (cam.CoordinateFrame.p - cam.Focus.p).magnitude
local ncf = CFrame.new(cam.Focus.p)*cam_rot*CFrame.fromEulerAnglesXYZ(0.01, 0.01, 0)
cam.CoordinateFrame = ncf*CFrame.new(0, 0, cam_scroll)
weld33.C1 = CFrame.new(-1.03, -0.15, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-35), 0) 
weld55.C1 = CFrame.new(1.26, 1.125, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(275), 0.7, math.rad(-0))
Tool.Flash.Mesh.Scale = Vector3.new(1.5, 1.5, 1.5)
Tool.Flash.Transparency = .8
Tool.A1.Mesh.Offset = Vector3.new(0, -0.3, 0)
Tool.A2.Mesh.Offset = Vector3.new(0, -0.3, 0)
wait(0.041)
local cam_rot = cam.CoordinateFrame - cam.CoordinateFrame.p
local cam_scroll = (cam.CoordinateFrame.p - cam.Focus.p).magnitude
local ncf = CFrame.new(cam.Focus.p)*cam_rot*CFrame.fromEulerAnglesXYZ(0.01, -0.01, 0)
cam.CoordinateFrame = ncf*CFrame.new(0, 0, cam_scroll)
weld33.C1 = CFrame.new(-1.05, -0.1, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-35), 0) 
weld55.C1 = CFrame.new(1.3, 1.15, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(275), 0.7, math.rad(-0))
Tool.Flash.Transparency = 1
Tool.A1.Mesh.Offset = Vector3.new(0, 0, 0)
Tool.A2.Mesh.Offset = Vector3.new(0, 0, 0)
end

