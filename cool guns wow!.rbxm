&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;return true
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;return true
&#9;end)
&#9;bullet.Parent=game.Workspace
&#9;if hit~=nil then
