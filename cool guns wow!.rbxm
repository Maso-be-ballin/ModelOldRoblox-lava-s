						<string name="Name">RayDamage</string>
						<ProtectedString name="Source">script.Parent.Touched:connect(function(hit)
&#9;if hit.Parent:findFirstChild(&quot;Humanoid&quot;) and hit.Parent.Name ~= script.Parent.Parent.Parent.Owner.Value then
&#9;&#9;hit.Parent.Humanoid:TakeDamage(100)
&#9;elseif hit.Parent:findFirstChild(&quot;Zombie&quot;) then
&#9;&#9;hit.Parent.Humanoid:TakeDamage(1000)
&#9;end
end)
for i, v in pairs(game.Players:GetChildren()) do
&#9;if (script.Parent.Position-v.Character.Torso.Position).magnitude &lt;= 6 and v.Name ~= script.Parent.Parent.Parent.Owner.Value then 
&#9;&#9;v.Character.Humanoid:TakeDamage(((script.Parent.Position-v.Character.Torso.Position).magnitude)*7)
&#9;end
end
for i, v in pairs(Workspace.Zombies:GetChildren()) do
&#9;if (script.Parent.Position-v.Torso.Position).magnitude &lt;= 6 then 
&#9;&#9;v.Zombie:TakeDamage(((script.Parent.Position-v.Torso.Position).magnitude)*25)
&#9;end
end
--

