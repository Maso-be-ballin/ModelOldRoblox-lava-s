		<Item class="Tool" referent="RBX4791">
			<Properties>
				<bool name="CanBeDropped">true</bool>
				<bool name="Enabled">true</bool>
				<CoordinateFrame name="Grip">
					<X>-0.200000003</X>
					<Y>0</Y>
					<Z>-0.200000003</Z>
					<R00>-0.287347883</R00>
					<R01>0</R01>
					<R02>0.957826257</R02>
					<R10>0</R10>
					<R11>1</R11>
					<R12>-0</R12>
					<R20>-0.957826257</R20>
					<R21>0</R21>
					<R22>-0.287347883</R22>
				</CoordinateFrame>
				<string name="Name">Pistol</string>
				<Content name="TextureId"><null></null></Content>
