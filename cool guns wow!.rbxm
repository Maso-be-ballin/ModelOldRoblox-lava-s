			<Item class="LocalScript" referent="RBX53">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui</string>
					<ProtectedString name="Source">local Tool = script.Parent;

enabled = true
function onButton1Down(mouse)
&#9;if not enabled then
&#9;&#9;return
&#9;end

&#9;enabled = false
&#9;mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;

&#9;wait(2)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;enabled = true

end

function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end

&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end


Tool.Equipped:connect(onEquippedLocal)
</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX54">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">LaserBlast</string>
					<ProtectedString name="Source">ball = script.Parent
damage = 0

HitSound = Instance.new(&quot;Sound&quot;)
HitSound.Name = &quot;HitSound&quot;
HitSound.SoundId = &quot;http://www.roblox.com/asset/?id=11945266&quot;
HitSound.Parent = ball
HitSound.Volume = 1
HitSound.Pitch = .8

debris = game:GetService(&quot;Debris&quot;)


local hits = 12

function onTouched(hit)

&#9;if (hit.Name == &quot;ScatterShot&quot;) then return end

&#9;hits = hits - 1
&#9;if (hits &lt; 0) then
&#9;&#9;connection:disconnect()
&#9;&#9;debris:AddItem(ball, .10)
&#9;end

&#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)

&#9;if humanoid ~= nil then
&#9;&#9;tagHumanoid(humanoid)
&#9;&#9;humanoid:TakeDamage(damage)
&#9;&#9;untagHumanoid(humanoid)
&#9;end

&#9;if (math.random() &gt; .1) then
&#9;&#9;HitSound:Play()
&#9;end

end

function tagHumanoid(humanoid)
&#9;-- todo: make tag expire
&#9;local tag = ball:findFirstChild(&quot;creator&quot;)
&#9;if tag ~= nil then
&#9;&#9;local new_tag = tag:clone()
&#9;&#9;new_tag.Parent = humanoid
&#9;end
end


function untagHumanoid(humanoid)
&#9;if humanoid ~= nil then
&#9;&#9;local tag = humanoid:findFirstChild(&quot;creator&quot;)
&#9;&#9;if tag ~= nil then
&#9;&#9;&#9;tag.Parent = nil
&#9;&#9;end
&#9;end
end

connection = ball.Touched:connect(onTouched)

wait(5)
--ball.SparkSound.Looped = false
--ball.SparkSound:Stop()
ball.Parent = nil</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX55">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">OnEquiped</string>
					<ProtectedString name="Source">Tool = script.Parent
print(&quot;Welding...&quot;)

function Weldnow()
&#9;local w1 = Instance.new(&quot;Weld&quot;)
&#9;w1.Parent = Tool.Handle
&#9;w1.Part0 = w1.Parent
&#9;w1.Part1 = Tool.SPos
&#9;w1.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(-0.8, 0.5, -0.1)
&#9;Tool.SPos.CanCollide = false
end

Tool.Equipped:connect(Weldnow)
Tool.Unequipped:connect(Weldnow)
</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX56">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ScatterBlast</string>
					<ProtectedString name="Source">local Tool = script.Parent;

enabled = true

local spark = Instance.new(&quot;Sparkles&quot;)
spark.Color = Color3.new(0,0,0)

function fire(v)

&#9;local vCharacter = Tool.Parent
&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;
&#9;

&#9;local spawnPos = vCharacter.PrimaryPart.Position
&#9;
&#9;local PewPew = Tool.Handle:FindFirstChild(&quot;PewPew&quot;)

&#9;if (PewPew == nil) then
&#9;&#9;PewPew = Instance.new(&quot;Sound&quot;)
&#9;&#9;PewPew.Name = &quot;PewPew&quot;
&#9;&#9;PewPew.SoundId = &quot;http://www.roblox.com/asset/?id=13775466&quot;
&#9;&#9;PewPew.Parent = Tool.Handle
&#9;&#9;PewPew.Volume = 1
&#9;&#9;PewPew.Pitch = .7
&#9;end
&#9;

&#9;for dx=-.7,.7,.7 do
&#9;&#9;for dy=-.7,.7,.7 do
&#9;&#9;&#9;if (math.abs(dx) == 0 or math.abs(dy) == 0) then

&#9;&#9;&#9;&#9;local p = Instance.new(&quot;Seat&quot;)
&#9;&#9;&#9;&#9;p.BrickColor = BrickColor.new(11)
&#9;&#9;&#9;&#9;p.formFactor = 2
&#9;&#9;&#9;&#9;p.Size = Vector3.new(1,.4,1)
&#9;&#9;&#9;&#9;p.Material = Enum.Material.Plastic
&#9;&#9;&#9;&#9;p.Friction = .05
&#9;&#9;&#9;&#9;p.Elasticity = .9
&#9;&#9;&#9;&#9;p.TopSurface = 0
&#9;&#9;&#9;&#9;p.BottomSurface = 0
&#9;&#9;&#9;&#9;p.Name = &quot;ScatterShot&quot;

&#9;&#9;&#9;&#9;local dv = CFrame.fromEulerAnglesXYZ(dx/4,dy/4,0) * v

&#9;&#9;&#9;&#9;local a = math.random() * 5.5
&#9;&#9;&#9;&#9;local d = Vector3.new(math.cos(a), 0, math.sin(a)).unit
&#9;&#9;&#9;&#9;p.Velocity = dv * 175
&#9;&#9;&#9;&#9;p.RotVelocity = d
&#9;&#9;&#9;&#9;p.Position = spawnPos + (dv * 5)

&#9;&#9;&#9;&#9;local force = Instance.new(&quot;BodyForce&quot;)
&#9;&#9;&#9;&#9;force.force = Vector3.new(0,30,0)
&#9;&#9;&#9;&#9;force.Parent = p

&#9;&#9;&#9;&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;&#9;creator_tag.Value = vPlayer
&#9;&#9;&#9;&#9;creator_tag.Name = &quot;creator&quot;
&#9;&#9;&#9;&#9;creator_tag.Parent = p

&#9;&#9;&#9;&#9;local new_script = script.Parent.LaserBlast:clone()
&#9;&#9;&#9;&#9;new_script.Disabled = false
&#9;&#9;&#9;&#9;new_script.Parent = p

&#9;&#9;&#9;&#9;spark:Clone().Parent = p

&#9;&#9;&#9;&#9;p.Parent = game.Workspace
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end

&#9;PewPew:Play()

end



function gunUp()
&#9;Tool.GripForward = Vector3.new(0,.981,-.196)
&#9;Tool.GripRight = Vector3.new(1,0,0)
&#9;Tool.GripUp = Vector3.new(0,.196,.981)
end

function gunOut()
&#9;Tool.GripForward = Vector3.new(0,1,0)
&#9;Tool.GripRight = Vector3.new(1,0,0)
&#9;Tool.GripUp = Vector3.new(0,0,1)
end



function onActivated()
&#9;if not enabled  then
&#9;&#9;return
&#9;end

&#9;enabled = false


&#9;local character = Tool.Parent;
&#9;local humanoid = character.Humanoid
&#9;if humanoid == nil then
&#9;&#9;print(&quot;Humanoid not found&quot;)
&#9;&#9;return 
&#9;end

&#9;local targetPos = humanoid.TargetPoint
&#9;local lookAt = (targetPos - character.Head.Position).unit

&#9;local reload = 1
&#9;--if (isTurbo(character)) then
&#9;--&#9;reload = .25
&#9;--&#9;print(&quot;turbo&quot;)
&#9;--end

&#9;gunUp()
&#9;fire(lookAt)
&#9;wait(reload)
&#9;gunOut()
&#9;wait(reload)

&#9;enabled = true

end

function onEquipped()
&#9;Tool.Handle.EquipSound:play()
end

script.Parent.Activated:connect(onActivated)
script.Parent.Equipped:connect(onEquipped)
</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX57">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Two-Handed Script</string>
					<ProtectedString name="Source">Tool = script.Parent;
local arms = nil
local torso = nil
local welds = {}

function Equip(mouse)
wait(0.01)
arms = {Tool.Parent:FindFirstChild(&quot;Left Arm&quot;), Tool.Parent:FindFirstChild(&quot;Right Arm&quot;)}
torso = Tool.Parent:FindFirstChild(&quot;Torso&quot;)
if arms ~= nil and torso ~= nil then
local sh = {torso:FindFirstChild(&quot;Left Shoulder&quot;), torso:FindFirstChild(&quot;Right Shoulder&quot;)}
if sh ~= nil then
local yes = true
if yes then
yes = false
sh[1].Part1 = nil
sh[2].Part1 = nil
local weld1 = Instance.new(&quot;Weld&quot;)
weld1.Part0 = torso
weld1.Parent = torso
weld1.Part1 = arms[1]
weld1.C1 = CFrame.new(-0.249, 1.35, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
welds[1] = weld1
local weld2 = Instance.new(&quot;Weld&quot;)
weld2.Part0 = torso
weld2.Parent = torso
weld2.Part1 = arms[2]
weld2.C1 = CFrame.new(-1, -0.2, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
welds[2] = weld2
end
else
print(&quot;sh&quot;)
end
else
print(&quot;arms&quot;)
end
end

function Unequip(mouse)
if arms ~= nil and torso ~= nil then
local sh = {torso:FindFirstChild(&quot;Left Shoulder&quot;), torso:FindFirstChild(&quot;Right Shoulder&quot;)}
if sh ~= nil then
local yes = true
if yes then
yes = false
sh[1].Part1 = arms[1]
sh[2].Part1 = arms[2]
welds[1].Parent = nil
welds[2].Parent = nil
end
else
print(&quot;sh&quot;)
end
else
print(&quot;arms&quot;)
end
end
Tool.Equipped:connect(Equip)
Tool.Unequipped:connect(Unequip)</ProtectedString>
				</Properties>
