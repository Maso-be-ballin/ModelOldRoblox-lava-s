						<R10>0</R10>
						<R11>1</R11>
						<R12>0</R12>
						<R20>-0.379291654</R20>
						<R21>0</R21>
						<R22>0.925277233</R22>
					</CoordinateFrame>
					<string name="Name">M92FS</string>
