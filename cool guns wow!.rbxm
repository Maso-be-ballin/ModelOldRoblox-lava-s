				<Item class="LocalScript" referent="RBX1893">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">RayShooter</string>
						<ProtectedString name="Source">plyr = game.Players.LocalPlayer
--
deb = false
--
player = script.Parent.Parent.Parent
--
model = Instance.new(&quot;Model&quot;,Workspace)
model.Name = &quot;RayHolder&quot;
name = Instance.new(&quot;StringValue&quot;,model)
name.Value = player.Name
name.Name = &quot;Owner&quot;
--
plyr.Character.Humanoid.Died:connect(function()
&#9;model:Destroy()
end)
--
script.Parent.Equipped:connect(function(mouse)
&#9;mouse.Button1Down:connect(function()
&#9;&#9;if not deb then
&#9;&#9;&#9;deb = true
&#9;&#9;&#9;coroutine.resume(coroutine.create(function()
&#9;&#9;&#9;&#9;modell = Instance.new(&quot;Model&quot;,model)
&#9;&#9;&#9;&#9;modell.Name = &quot;GRay&quot;
&#9;&#9;&#9;&#9;local endpos = mouse.hit.p
&#9;&#9;&#9;&#9;startblock = script.Parent.Barrel
&#9;&#9;&#9;&#9;length = math.abs(math.ceil((mouse.Hit.p-startblock.Position).magnitude))
&#9;&#9;&#9;&#9;Ray = Instance.new(&quot;Part&quot;,modell)
&#9;&#9;&#9;&#9;Ray.BrickColor = BrickColor.new(&quot;Camo&quot;)
&#9;&#9;&#9;&#9;Ray.Size = Vector3.new(1,1,length)
&#9;&#9;&#9;&#9;Ray.CFrame = CFrame.new(startblock.CFrame.p, mouse.Hit.p) * CFrame.new(0, 0, (-Ray.Size.z / 2))
&#9;&#9;&#9;&#9;Ray.Anchored = true
&#9;&#9;&#9;&#9;Ray.CanCollide = false
&#9;&#9;&#9;&#9;local sc = script.Parent.RayDamage:clone()
&#9;&#9;&#9;&#9;sc.Parent = Ray
&#9;&#9;&#9;&#9;sc.Disabled = false
&#9;&#9;&#9;&#9;mesh = Instance.new(&quot;BlockMesh&quot;,Ray)
&#9;&#9;&#9;&#9;mesh.Scale = Vector3.new(.25,.25,1)
&#9;&#9;&#9;&#9;Ring = Instance.new(&quot;Part&quot;,modell)
&#9;&#9;&#9;&#9;Ring.formFactor = &quot;Custom&quot;
&#9;&#9;&#9;&#9;Ring.Size = Vector3.new(1,1,1)
&#9;&#9;&#9;&#9;Ring.CanCollide = false
&#9;&#9;&#9;&#9;Ring.Anchored = true
&#9;&#9;&#9;&#9;Ring.BrickColor = BrickColor.new(&quot;Lime green&quot;)
&#9;&#9;&#9;&#9;Ring.CFrame = Ray.CFrame+(Ray.CFrame.lookVector)
&#9;&#9;&#9;&#9;local mesh = script.Parent.Mesh:clone()
&#9;&#9;&#9;&#9;mesh.Parent = Ring
&#9;&#9;&#9;&#9;for i = 1, math.floor(length/6)-1 do
&#9;&#9;&#9;&#9;&#9;ring = Instance.new(&quot;Part&quot;,modell)
&#9;&#9;&#9;&#9;&#9;ring.Name = &quot;Ring&quot;
&#9;&#9;&#9;&#9;&#9;ring.formFactor = &quot;Custom&quot;
&#9;&#9;&#9;&#9;&#9;ring.Size = Vector3.new(1,1,1)
&#9;&#9;&#9;&#9;&#9;ring.CanCollide = false
&#9;&#9;&#9;&#9;&#9;ring.Anchored = true
&#9;&#9;&#9;&#9;&#9;ring.BrickColor = BrickColor.new(&quot;Lime green&quot;)
&#9;&#9;&#9;&#9;&#9;local mesh = script.Parent.Mesh:clone()
&#9;&#9;&#9;&#9;&#9;mesh.Parent = ring
&#9;&#9;&#9;&#9;&#9;ring.CFrame = Ring.CFrame+(Ring.CFrame.lookVector*(3*i))
&#9;&#9;&#9;&#9;&#9;ring2 = Instance.new(&quot;Part&quot;,modell)
&#9;&#9;&#9;&#9;&#9;ring2.Name = &quot;Ring&quot;
&#9;&#9;&#9;&#9;&#9;ring2.formFactor = &quot;Custom&quot;
&#9;&#9;&#9;&#9;&#9;ring2.Size = Vector3.new(1,1,1)
&#9;&#9;&#9;&#9;&#9;ring2.CanCollide = false
&#9;&#9;&#9;&#9;&#9;ring2.Anchored = true
&#9;&#9;&#9;&#9;&#9;ring2.BrickColor = BrickColor.new(&quot;Lime green&quot;)
&#9;&#9;&#9;&#9;&#9;local mesh = script.Parent.Mesh:clone()
&#9;&#9;&#9;&#9;&#9;mesh.Parent = ring2
&#9;&#9;&#9;&#9;&#9;ring2.CFrame = Ring.CFrame-(Ring.CFrame.lookVector*(3*i))
&#9;&#9;&#9;&#9;end
--
&#9;&#9;&#9;&#9;for ii, v in pairs(modell:GetChildren()) do
&#9;&#9;&#9;&#9;&#9;coroutine.resume(coroutine.create(function()
&#9;&#9;&#9;&#9;&#9;&#9;for i = 0, 1, .1 do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;v.Transparency = i
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;wait(.05)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end))
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;game:GetService(&quot;Debris&quot;):AddItem(modell, .5)
--
&#9;&#9;&#9;end))
&#9;&#9;&#9;wait(.1)
&#9;&#9;&#9;deb = false
&#9;&#9;end
&#9;end)
end)
</ProtectedString>
