			<Item class="IntValue" referent="RBX1194">
				<Properties>
					<string name="Name">Ammo</string>
					<int name="Value">5</int>
				</Properties>
			</Item>
			<Item class="IntValue" referent="RBX1195">
				<Properties>
					<string name="Name">Clips</string>
					<int name="Value">99990</int>
