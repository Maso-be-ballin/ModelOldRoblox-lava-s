			<Item class="Script" referent="RBX59">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Weld</string>
					<ProtectedString name="Source">--- ok here ya go
local player = script.Parent
function onPlayerDied(died)
if player.Humanoid.Health == 0 then
if player.Head:findFirstChild(&quot;face&quot;) ~= nil then player.Head:findFirstChild(&quot;face&quot;):remove() end
if player.Torso:findFirstChild(&quot;Right Shoulder&quot;) ~= nil then player.Torso:findFirstChild(&quot;Right Shoulder&quot;):remove() end
if player.Torso:findFirstChild(&quot;Left Shoulder&quot;) ~= nil then player.Torso:findFirstChild(&quot;Left Shoulder&quot;):remove() end
if player.Torso:findFirstChild(&quot;Right Hip&quot;) ~= nil then player.Torso:findFirstChild(&quot;Right Hip&quot;):remove() end
if player.Torso:findFirstChild(&quot;Left Hip&quot;) ~= nil then player.Torso:findFirstChild(&quot;Left Hip&quot;):remove() end
local face = Instance.new(&quot;Decal&quot;)
local weld = Instance.new(&quot;Weld&quot;)
local weld2 = Instance.new(&quot;Weld&quot;)
local weld3 = Instance.new(&quot;Weld&quot;)
local weld4 = Instance.new(&quot;Weld&quot;)
local weld5 = Instance.new(&quot;Weld&quot;)

face.Parent = player.Head
face.Texture = &quot;http://www.roblox.com/asset/?id=2298724&quot;

weld.Parent = player.Torso
weld.Part0 = player.Torso
weld.Part1 = player.Head
weld.C0 = CFrame.new(0,1.5,0)

weld2.Parent = player.Torso
weld2.Part0 = player.Torso
weld2.Part1 = player:findFirstChild(&quot;Right Arm&quot;)
weld2.C0 = CFrame.new(1.5,0,0)

weld3.Parent = player.Torso
weld3.Part0 = player.Torso
weld3.Part1 = player:findFirstChild(&quot;Left Arm&quot;)
weld3.C0 = CFrame.new(-1.5,0,0)

weld4.Parent = player.Torso
weld4.Part0 = player.Torso
weld4.Part1 = player:findFirstChild(&quot;Right Leg&quot;)
weld4.C0 = CFrame.new(0.5,-2,0)

weld5.Parent = player.Torso
weld5.Part0 = player.Torso
weld5.Part1 = player:findFirstChild(&quot;Left Leg&quot;)
weld5.C0 = CFrame.new(-0.5,-2,0)
end
end

player.Humanoid.Died:connect(onPlayerDied)</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX60">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Welding</string>
					<ProtectedString name="Source">function Weld(x,y)
&#9;local W = Instance.new(&quot;Weld&quot;)
&#9;W.Part0 = x
&#9;W.Part1 = y
&#9;local CJ = CFrame.new(x.Position)
&#9;local C0 = x.CFrame:inverse()*CJ
&#9;local C1 = y.CFrame:inverse()*CJ
&#9;W.C0 = C0
&#9;W.C1 = C1
&#9;W.Parent = x
end

function Get(A)
&#9;if A.className == &quot;Part&quot; then
&#9;&#9;Weld(script.Parent.Handle, A)
&#9;&#9;A.Anchored = false
&#9;else
&#9;&#9;local C = A:GetChildren()
&#9;&#9;for i=1, #C do
&#9;&#9;Get(C[i])
&#9;&#9;end
&#9;end
end

function Finale()
&#9;Get(script.Parent)
end

script.Parent.Equipped:connect(Finale)
script.Parent.Unequipped:connect(Finale)
Finale()</ProtectedString>
				</Properties>
			</Item>
