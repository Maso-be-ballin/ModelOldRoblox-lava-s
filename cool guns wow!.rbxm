				<Item class="Script" referent="RBX1888">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GrenadeScript</string>
						<ProtectedString name="Source">r = game:service(&quot;RunService&quot;)

shaft = script.Parent
position = shaft.Position
car = false
lol = false

script.Parent.Explosion.PlayOnRemove = true -- play explosion sound when projectile removed from game


function blow()
&#9;explosion = Instance.new(&quot;Explosion&quot;)
&#9;explosion.Position = shaft.Position
&#9;explosion.BlastPressure = 0
&#9;explosion.BlastRadius = 30


&#9;-- find instigator tag
&#9;local creator = script.Parent:findFirstChild(&quot;creator&quot;)
&#9;if creator ~= nil then
&#9;&#9;explosion.Hit:connect(function(part, distance)  onPlayerBlownUp(part, distance, creator) end)
&#9;&#9;explosion.Hit:connect(function(part, distance)  doDamage(part, distance) end)
&#9;end


&#9;explosion.Parent = game.Workspace
&#9;connection:disconnect()
&#9;wait(.1)
&#9;shaft:remove()
end

function onPlayerBlownUp(part, distance, creator)
&#9;
&#9;if part.Name == &quot;Head&quot; then
&#9;
&#9;&#9;local humanoid = part.Parent.Humanoid
&#9;&#9;tagHumanoid(humanoid, creator)
&#9;end
end

function doDamage(part, distance)
&#9;
&#9;if part.Name == &quot;Regen&quot; then return end

&#9;if part.Parent.className == &quot;Tool&quot; then return end
&#9;if part.Parent.className == &quot;Hat&quot; then return end

&#9;if part.Parent:findFirstChild(&quot;ShellShocked&quot;) ~= nil then return end
&#9;if part.Parent:findFirstChild(&quot;ForceField&quot;) ~= nil then return end

&#9;if part.Name == &quot;Head&quot; then
&#9;&#9;local humanoid = part.Parent.Humanoid
&#9;&#9;humanoid.Health = humanoid.Health - (130 - distance)
&#9;&#9;local ss = Instance.new(&quot;IntValue&quot;)
&#9;&#9;ss.Parent = part.Parent
&#9;&#9;ss.Name = &quot;ShellShocked&quot;
&#9;&#9;game:getService(&quot;Debris&quot;):addItem(ss,2)
&#9;end
end


function tagHumanoid(humanoid, creator)
&#9;-- tag does not need to expire iff all explosions lethal
&#9;
&#9;if creator ~= nil then
&#9;&#9;local new_tag = creator:clone()
&#9;&#9;new_tag.Parent = humanoid
&#9;&#9;
&#9;end
end

function untagHumanoid(humanoid)
&#9;if humanoid ~= nil then
&#9;&#9;local tag = humanoid:findFirstChild(&quot;creator&quot;)
&#9;&#9;if tag ~= nil then
&#9;&#9;
&#9;&#9;&#9;tag.Parent = nil
&#9;&#9;end
&#9;end
end

t, s = r.Stepped:wait()

d = t + 9999999999 - s
connection = shaft.Touched:connect(blow)

while t &lt; d do
&#9;t = r.Stepped:wait()
end

-- at max range
blow()
script.Parent.Explosion.PlayOnRemove = false
shaft:remove()</ProtectedString>
