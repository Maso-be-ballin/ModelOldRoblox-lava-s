&#9;p.Parent=game.Lighting
&#9;p.Position=pos
&#9;p.Parent=game.Workspace
end


function fire(aim)
&#9;sp.Handle.Fire:Play()

&#9;t=r.Stepped:wait()
&#9;last6=last5
&#9;last5=last4
&#9;last4=last3
&#9;last3=last2
&#9;last2=last
&#9;last=t

&#9;local bullet=Bullet:clone()
&#9;local totalDist=0
