&#9;wait()
Tool.GripUp = Vector3.new(0, 0, 1)
&#9;weld33.C1 = CFrame.new(-0.75, 0.5, 0.45) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15),0)
&#9;weld55.C1 = CFrame.new(-0.35, 0.5, 0.55) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))

