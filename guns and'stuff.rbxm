&#9;&#9;local tag=Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;tag.Value=plr
&#9;&#9;tag.Name=&quot;creator&quot;
&#9;&#9;tag.Parent=humanoid
&#9;&#9;delay(2,function()
&#9;&#9;&#9;if tag~=nil then
&#9;&#9;&#9;&#9;tag.Parent=nil
&#9;&#9;&#9;end
&#9;&#9;end)
&#9;end
end


