&#9;cam.CoordinateFrame = ncf*CFrame.new(0, 0, cam_scroll)
Tool.GripUp = Vector3.new(0, 0.05, 1)

&#9;weld33.C1 = CFrame.new(-0.75, 0.5, 0.45) * CFrame.fromEulerAnglesXYZ(math.rad(-93), math.rad(-15),0)
&#9;weld55.C1 = CFrame.new(-0.35, 0.5, 0.55) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0.06, math.rad(-90))

&#9;wait()

smoke:remove()
smoke1:remove()
smoke2:remove()
smoke12:remove()

Tool.GripUp = Vector3.new(0, 0.1, 1)
&#9;local ncf = CFrame.new(cam.Focus.p)*cam_rot*CFrame.fromEulerAnglesXYZ(0.02, 0, 0)

