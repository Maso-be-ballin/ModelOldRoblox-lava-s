function onButton1Down(mouse)
&#9;h=sp.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;if not enabled or reloading or down or h==nil then
&#9;&#9;return
&#9;end
&#9;if sp.Ammo.Value&gt;0 and h.Health&gt;0 and h.Jump == false and reloading == false and attaching == false then
&#9;&#9;--[[if sp.Ammo.Value&lt;=0 then
&#9;&#9;&#9;if not reloading then
&#9;&#9;&#9;&#9;reload(mouse)
&#9;&#9;&#9;end
&#9;&#9;&#9;return
&#9;&#9;end]]
&#9;&#9;down=true
&#9;&#9;enabled=false

&#9;&#9;while down and h.Jump == false and h.Health&gt;0 and reloading == false and attaching == false do
&#9;&#9;&#9;if sp.Ammo.Value&lt;=0 then
&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;end

&#9;&#9;&#9;if sp.FireMode.Value == 1 then
&#9;&#9;&#9;if Tool.Pose.Value == 1 then
&#9;&#9;&#9;Tool.Accuracy.Value = Accuracy*1
&#9;&#9;&#9;elseif Tool.Pose.Value == 2 then
&#9;&#9;&#9;Tool.Accuracy.Value = Accuracy*0.5
&#9;&#9;&#9;elseif Tool.Pose.Value == 3 then
&#9;&#9;&#9;Tool.Accuracy.Value = Accuracy*0.35
&#9;&#9;&#9;end
&#9;&#9;&#9;if Tool.ZoomedIn.Value == true then
&#9;&#9;&#9;Tool.Accuracy.Value = Accuracy*0.35
&#9;&#9;&#9;end
&#9;&#9;&#9;automatic = true
&#9;&#9;&#9;burst= false
&#9;&#9;&#9;shot = false
&#9;&#9;&#9;
&#9;&#9;&#9;elseif sp.FireMode.Value == 2 then
&#9;&#9;&#9;if Tool.Pose.Value == 1 then
&#9;&#9;&#9;Tool.Accuracy.Value = Accuracy*0.35
&#9;&#9;&#9;elseif Tool.Pose.Value == 2 then
&#9;&#9;&#9;Tool.Accuracy.Value = Accuracy*0.275
&#9;&#9;&#9;elseif Tool.Pose.Value == 3 then
&#9;&#9;&#9;Tool.Accuracy.Value = Accuracy*0.2
&#9;&#9;&#9;end
&#9;&#9;&#9;if Tool.ZoomedIn.Value == true then
&#9;&#9;&#9;Tool.Accuracy.Value = Accuracy*0.1
&#9;&#9;&#9;end
&#9;&#9;&#9;shot = true
&#9;&#9;&#9;burst = false
&#9;&#9;&#9;automatic = false
&#9;&#9;&#9;elseif sp.FireMode.Value &gt;= 3 then
&#9;&#9;&#9;sp.FireMode.Value = 1
&#9;&#9;&#9;end
&#9;&#9; 

&#9;&#9;&#9;if burst and h.Health&gt;0 then
&#9;&#9;&#9;&#9;local startpoint=barrel_1.CFrame.p
&#9;&#9;&#9;&#9;local mag=(mouse.Hit.p-startpoint).magnitude
&#9;&#9;&#9;&#9;local rndm=Vector3.new(math.random(-Tool.Accuracy.Value,Tool.Accuracy.Value), math.random(-Tool.Accuracy.Value,Tool.Accuracy.Value ),math.random(-Tool.Accuracy.Value,Tool.Accuracy.Value))
&#9;&#9;&#9;&#9;fire(mouse.Hit.p+rndm)
&#9;&#9;&#9;&#9;sp.Ammo.Value=sp.Ammo.Value-1
&#9;&#9;&#9;&#9;if sp.Ammo.Value&lt;=0 then
&#9;&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;wait(.02)
&#9;&#9;&#9;&#9;local startpoint=barrel_1.CFrame.p
&#9;&#9;&#9;&#9;local mag2=((mouse.Hit.p+rndm)-startpoint).magnitude
&#9;&#9;&#9;&#9;local rndm2=Vector3.new(math.random(-Tool.Accuracy.Value,Tool.Accuracy.Value), math.random(-Tool.Accuracy.Value,Tool.Accuracy.Value ),math.random(-Tool.Accuracy.Value,Tool.Accuracy.Value))
&#9;&#9;&#9;&#9;fire(mouse.Hit.p+rndm+rndm2)
&#9;&#9;&#9;&#9;sp.Ammo.Value=sp.Ammo.Value-1
&#9;&#9;&#9;&#9;if sp.Ammo.Value&lt;=0 then
&#9;&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;wait(.02)
&#9;&#9;&#9;&#9;fire(mouse.Hit.p+rndm+rndm2+rndm2)
&#9;&#9;&#9;&#9;sp.Ammo.Value=sp.Ammo.Value-1
&#9;&#9;&#9;elseif shot and h.Health&gt;0 then
&#9;&#9;&#9;&#9;sp.Ammo.Value=sp.Ammo.Value-1
&#9;&#9;&#9;&#9;local startpoint=barrel_1.CFrame.p
&#9;&#9;&#9;&#9;local mag=(mouse.Hit.p-startpoint).magnitude
&#9;&#9;&#9;&#9;local rndm=Vector3.new(math.random(-Tool.Accuracy.Value,Tool.Accuracy.Value), math.random(-Tool.Accuracy.Value,Tool.Accuracy.Value ),math.random(-Tool.Accuracy.Value,Tool.Accuracy.Value))
&#9;&#9;&#9;&#9;fire(mouse.Hit.p+rndm)
&#9;&#9;&#9;&#9;wait(Firerate)
&#9;&#9;&#9;elseif automatic and h.Health&gt;0 then
&#9;&#9;&#9;&#9;sp.Ammo.Value=sp.Ammo.Value-1
&#9;&#9;&#9;&#9;local startpoint=barrel_1.CFrame.p
&#9;&#9;&#9;&#9;local mag=(mouse.Hit.p-startpoint).magnitude
&#9;&#9;&#9;&#9;local rndm=Vector3.new(math.random(-Tool.Accuracy.Value,Tool.Accuracy.Value), math.random(-Tool.Accuracy.Value,Tool.Accuracy.Value ),math.random(-Tool.Accuracy.Value,Tool.Accuracy.Value))
&#9;&#9;&#9;&#9;fire(mouse.Hit.p+rndm)
&#9;&#9;&#9;elseif h.Health &lt;= 0 then
&#9;&#9;&#9;game.Workspace.CurrentCamera.FieldOfView = 70
&#9;&#9;&#9;end
&#9;&#9;&#9;wait(Firerate)
&#9;&#9;&#9;if not automatic then
&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;end
&#9;&#9;end&#9;
&#9;&#9;enabled=true
&#9;else
&#9;&#9;wait()
&#9;end
end

function aimtest()
for i = 1, 10 do
Tool.GripForward = Vector3.new(.083*i,0,1)
wait()
weld55.C1 = CFrame.new(1-i*.01, 0.8, 0.8) * CFrame.fromEulerAnglesXYZ(math.rad(320-i*3.9), 0, math.rad(-90))
weld33.C1 = CFrame.new(1-i*.01, 0.2, -1) * CFrame.fromEulerAnglesXYZ(math.rad(-90-i*3.9), math.rad(-0), math.rad(-90))
end
Tool.ZoomedIn.Value = true
zooming = false
game.Workspace.CurrentCamera.FieldOfView = 65
wait()
game.Workspace.CurrentCamera.FieldOfView = 60
wait()
game.Workspace.CurrentCamera.FieldOfView = 55
wait()
game.Workspace.CurrentCamera.FieldOfView = 50
wait()
game.Workspace.CurrentCamera.FieldOfView = 45
end

function aimoff()
Tool.ZoomedIn.Value = false
game.Workspace.CurrentCamera.FieldOfView = 50
wait()
game.Workspace.CurrentCamera.FieldOfView = 55
wait()
game.Workspace.CurrentCamera.FieldOfView = 60
wait()
game.Workspace.CurrentCamera.FieldOfView = 65
wait()
game.Workspace.CurrentCamera.FieldOfView = 70
for i = 1, 10 do
i = 10 - i
Tool.GripForward = Vector3.new(.083*i,0,1)
wait()
weld55.C1 = CFrame.new(0.9+i*.01, 0.8, 0.8) * CFrame.fromEulerAnglesXYZ(math.rad(320-i*3.9), 0, math.rad(-90))
weld33.C1 = CFrame.new(0.9+i*.01, 0.2, -1) * CFrame.fromEulerAnglesXYZ(math.rad(-90-i*3.9), math.rad(-0), math.rad(-90))
end

weld55.C1 = CFrame.new(1, 0.8, 0.8) * CFrame.fromEulerAnglesXYZ(math.rad(320), 0, math.rad(-90))
weld33.C1 = CFrame.new(1, 0.2, -1) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-0), math.rad(-90))
zooming = false
end

function getYawFromVector(lvec)
&#9;local yaw = 0
&#9;local a = lvec.X
&#9;local o = lvec.Z
&#9;yaw = math.atan2(o,a) + math.pi
&#9;return yaw
end

local lArmOrig = CFrame.new(1, 0.8, 0.8) * CFrame.fromEulerAnglesXYZ(math.rad(320), 0, math.rad(-90))
local rArmOrig = CFrame.new(1, 0.2, -1) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-0), math.rad(-90))
local lArmFrame = lArmOrig
local rArmFrame = rArmOrig

function getYawFromVector(lvec)
&#9;local yaw = 0
&#9;local a = lvec.X
&#9;local o = lvec.Z
&#9;yaw = math.atan2(o,a) + math.pi
&#9;return yaw
end

function getPitchFromVector(lvec)
&#9;local a = math.sqrt(lvec.X^2 + lvec.Z^2)
&#9;local o = lvec.Y
&#9;local pitch = math.atan(o/a)
&#9;return pitch
end
function weld(par,p0,p1,c0,c1)
&#9;local w = Instance.new(&quot;Weld&quot;)
&#9;w.Part0 = p0
&#9;w.Part1 = p1
&#9;w.C0 = c0 or CFrame.new()
&#9;w.C1 = c1 or CFrame.new()
&#9;w.Parent = par
&#9;return w
end
