					<string name="Name">Local Gui</string>
					<ProtectedString name="Source">-------------------------------------Gun info
ToolName=&quot;Shotgun&quot;

ClipSize=8
ReloadTime=2.2
Firerate=.8
MinSpread=0.2
MaxSpread=0.3
