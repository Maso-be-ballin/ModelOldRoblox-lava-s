&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif hit.Parent.Name == &quot;Cockpit&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;hit.Parent.Parent.Parent.Health.Value = hit.Parent.Parent.Parent.Health.Value - damage
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif hit.Parent.Name == &quot;Front&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;hit.Parent.Parent.Parent.Health.Value = hit.Parent.Parent.Parent.Health.Value - damage
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif hit.Parent.Name == &quot;Middle&quot; then
