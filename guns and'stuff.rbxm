VELOCITY = 60

function Nade2()
&#9;local model = Instance.new(&quot;Model&quot;)
&#9;model.Name = &quot;Nade&quot;
&#9;model.Parent = game.Workspace
&#9;nade = game.Lighting.Handle:clone()
