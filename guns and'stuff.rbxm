end

&#9;&#9;if reloading==false and Tool.Running.Value == false and holst == false and Tool.ZoomedIn.Value == false and zooming == false and running == false and attaching == false then
&#9;&#9;gyro.maxTorque = Vector3.new(0, 0, 0)
&#9;&#9;ang.maxTorque = Vector3.new(0, 0, 0)
&#9;&#9;weld55.C1 = CFrame.new(1, 0.8, 0.8) * CFrame.fromEulerAnglesXYZ(math.rad(320), 0, math.rad(-90))
&#9;&#9;weld33.C1 = CFrame.new(1, 0.2, -1) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-0), math.rad(-90))

&#9;&#9;elseif Tool.ZoomedIn.Value == true and reloading == false and Tool.Running.Value == false and holst == false and zooming == false and running == false and attaching == false then
&#9;&#9;if (camera.CoordinateFrame.p - camera.Focus.p).magnitude &gt; 1 then
&#9;&#9;local dir=(Mouse.Hit.p)-startpoint
&#9;&#9;gyro.cframe = CFrame.new(startpoint,  startpoint + dir)
&#9;&#9;gyro.maxTorque = Vector3.new(0, 999999, 0)
&#9;&#9;ang.maxTorque = Vector3.new(9999999, 9999999, 9999999)
&#9;&#9;else
&#9;&#9;local camPoint = CFrame.new(torso.Position, torso.Position + (camera.CoordinateFrame.lookVector))
&#9;&#9;gyro.cframe = camPoint * CFrame.Angles(0, 0 ,0)
&#9;&#9;gyro.maxTorque = Vector3.new(0, 999999, 0)
&#9;&#9;ang.maxTorque = Vector3.new(9999999, 9999999, 9999999)
&#9;&#9;end
&#9;&#9;weld55.C1 = CFrame.new(0.92, 0.8, 0.8) * CFrame.fromEulerAnglesXYZ(math.rad(281), 0, math.rad(-90))
&#9;&#9;weld33.C1 = CFrame.new(0.92, 0.2, -1) * CFrame.fromEulerAnglesXYZ(math.rad(-129), math.rad(-0), math.rad(-90))
&#9;&#9;elseif reloading==false and Tool.Running.Value == true and holst == false and Tool.ZoomedIn.Value == false and zooming == false and running == false and attaching == false then
&#9;&#9;gyro.maxTorque = Vector3.new(0, 0, 0)
&#9;&#9;ang.maxTorque = Vector3.new(0, 0, 0)
&#9;&#9;weld55.C1 = CFrame.new(0.7, 0.9, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(250), 0, math.rad(-120))
&#9;&#9;weld33.C1 = CFrame.new(1.3, 0.1, -1.1) * CFrame.fromEulerAnglesXYZ(math.rad(-150),0, math.rad(-110))
&#9;&#9;end 




&#9;end

end

function setUpGui()
&#9;if vPlayer == nil or vPlayer:findFirstChild(&quot;PlayerGui&quot;) == nil then
&#9;&#9;return
&#9;end

&#9;Gui = script.AmmoGui:clone()
&#9;Gui.Parent = vPlayer.PlayerGui
end

function check()
game.Players.LocalPlayer.PlayerGui.AmmoGui.Frame.Ammo.Text = &quot;&quot;..script.Parent.Ammo.Value..&quot;/&quot;..script.Parent.AmmoStored.Value..&quot;&quot;
game.Players.LocalPlayer.PlayerGui.AmmoGui.Frame.Grenades.Text = &quot;Gx&quot;..script.Parent.Grenades.Value..&quot;&quot;
--game.Players.LocalPlayer.PlayerGui.AmmoGui.Frame.Health.Text = &quot;&quot;..game.Players.LocalPlayer.Character.Humanoid.Health..&quot;%&quot;
game.Players.LocalPlayer.PlayerGui.AmmoGui.Frame.GunName.Text = ToolName
if script.Parent.FireMode.Value == 1 then
game.Players.LocalPlayer.PlayerGui.AmmoGui.Frame.SelectSemi.Visible = false
game.Players.LocalPlayer.PlayerGui.AmmoGui.Frame.SelectAuto.Visible = true
else 
game.Players.LocalPlayer.PlayerGui.AmmoGui.Frame.SelectSemi.Visible = true
game.Players.LocalPlayer.PlayerGui.AmmoGui.Frame.SelectAuto.Visible = false
end
end


function onUnequippedLocal(mouse)
if arms ~= nil and torso ~= nil then
local sh = {torso:FindFirstChild(&quot;Left Shoulder&quot;), torso:FindFirstChild(&quot;Right Shoulder&quot;)}
if sh ~= nil then
local yes = true
if yes then
yes = false
welds[1].Parent = nil
welds[2].Parent = nil
falsearm1:remove()
falsearm2:remove()
neck.C1 = CFrame.new(0,.75,0) * CFrame.Angles(0,0,0)
ang:remove()
gyro:remove()
end
else
end
else
end
&#9;equiped=false
