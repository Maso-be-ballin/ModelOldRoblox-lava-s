						<string name="Name">BlinkingScript</string>
						<ProtectedString name="Source">--Just insert into a brick
--You can change the wait(x), x being how fast or slow you want the colors to change
while true do 
&#9;
&#9;script.Parent.BrickColor =  BrickColor.new(1)--White
&#9;&#9;wait(.001)
&#9;script.Parent.BrickColor =  BrickColor.new(26)--Black
&#9;&#9;wait(.001)
&#9;end
</ProtectedString>
					</Properties>
				</Item>
