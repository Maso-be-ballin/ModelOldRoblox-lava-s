			<Item class="LocalScript" referent="RBX657">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">GunDown</string>
					<ProtectedString name="Source">wait()
local Tool = script.Parent
enabled = true
function onEquippedLocal(mouse)
&#9;mouse.Button1Down:connect(Clicky)
&#9;mouse.KeyDown:connect(onKeyDown)
end

function defaultrifle()
torso = Tool.Parent:FindFirstChild(&quot;Torso&quot;)
walkspeed1 = Tool.Parent:FindFirstChild(&quot;Humanoid&quot;)
if torso ~= nil then
torso.weld1.C1 = CFrame.new(-0.249, 1.35, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
torso.weld2.C1 = CFrame.new(-1, -0.2, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
walkspeed1.WalkSpeed = 16
end
end

function defaultpistol()
torso = Tool.Parent:FindFirstChild(&quot;Torso&quot;)
walkspeed1 = Tool.Parent:FindFirstChild(&quot;Humanoid&quot;)
if torso ~= nil then
torso.weld1.C1 = CFrame.new(-0.5, 0.9, 0.7) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
torso.weld2.C1 = CFrame.new(-1, 0.6, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-20), 0)
walkspeed1.WalkSpeed = 16
end
end

function holster()
torso = Tool.Parent:FindFirstChild(&quot;Torso&quot;)
walkspeed1 = Tool.Parent:FindFirstChild(&quot;Humanoid&quot;)
if torso ~= nil then
torso.weld1.C1 = CFrame.new(0.5,0,.5) * CFrame.fromEulerAnglesXYZ(math.rad(315), 0, math.rad(-40))
torso.weld2.C1 = CFrame.new(-.8, -0.6, -0.5) * CFrame.fromEulerAnglesXYZ(math.rad(-40), math.rad(-60), 0)
walkspeed1.WalkSpeed = 20
end
end


function onKeyDown(key)
&#9;if (key~=nil) then
&#9;&#9;key = key:lower()
&#9;&#9;if (key==&quot;g&quot;)  then
&#9;&#9;&#9;&#9;defaultrifle()
&#9;&#9;end

&#9;&#9;&#9;if (key==&quot;h&quot;) then
&#9;&#9;&#9;&#9;holster()
&#9;&#9;end
&#9;end
end

function Clicky()
defaultrifle()
end

Tool.Equipped:connect(onEquippedLocal)</ProtectedString>
