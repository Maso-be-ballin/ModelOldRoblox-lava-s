			<Item class="LocalScript" referent="RBX33">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Prone</string>
					<ProtectedString name="Source">on = 0
Tool = script.Parent
welds = {}
sh = {}
arms = nil
torso = nil
f = nil

function Crouch(ison)
if arms == nil and torso == nil then
arms = {Tool.Parent:FindFirstChild(&quot;Left Leg&quot;), Tool.Parent:FindFirstChild(&quot;Right Leg&quot;)}
torso = Tool.Parent:FindFirstChild(&quot;Torso&quot;)
end
if arms ~= nil and torso ~= nil then
sh = {torso:FindFirstChild(&quot;Left Hip&quot;), torso:FindFirstChild(&quot;Right Hip&quot;)}
if sh ~= nil then
local yes = true
if yes then
yes = false
if ison == 1 then
sh[1].Part1 = nil
sh[2].Part1 = nil
local weld1 = Instance.new(&quot;Weld&quot;)
weld1.Part0 = torso
weld1.Parent = torso
weld1.Part1 = arms[1]
weld1.C1 = CFrame.new(-0.5, 1, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(90),-0.1,-0.1)
arms[1].Name = &quot;LDave&quot;
arms[1].CanCollide = true
welds[1] = weld1
-------------------------------------------
local weld2 = Instance.new(&quot;Weld&quot;)
weld2.Part0 = torso
weld2.Parent = torso
weld2.Part1 = arms[2]
weld2.C1 = CFrame.new(0.5,1,0.6) * CFrame.fromEulerAnglesXYZ(math.rad(90),0.1,0.1)
arms[2].Name = &quot;RDave&quot;
arms[2].CanCollide = true
welds[2] = weld2
---------------------------------
local force = Instance.new(&quot;BodyForce&quot;)
force.Parent = torso
f = force
wait(0.01)
elseif ison == 0 then
if arms then
sh[1].Part1 = arms[1]
sh[2].Part1 = arms[2]
f.Parent = nil
arms[2].Name = &quot;Right Leg&quot;
arms[1].Name = &quot;Left Leg&quot;
welds[1].Parent = nil
welds[2].Parent = nil
end
end
--
end
else
print(&quot;sh&quot;)
end
else
print(&quot;arms&quot;)
end
end

------------------------

--WalkSpeedsHere!

local WalkSpeedWhileCrouching = 5
local CurrentWalkSpeed = 16

--WalkSpeedsHere!

------------------------

function Key(key)
if key then
key = string.lower(key)
if (key==&quot;x&quot;) then
if on == 1 then
Tool.Parent.Humanoid.WalkSpeed = CurrentWalkSpeed
Tool.Accuracy.Value = Tool.Accuracy.Value + 4
Tool.Pose.Value = 1
on = 0
elseif on == 0 then
Tool.Parent.Humanoid.WalkSpeed = WalkSpeedWhileCrouching
Tool.Accuracy.Value = Tool.Accuracy.Value - 4
Tool.Pose.Value = 3
on = 1
end
Crouch(on)
end
end
end
function Equip(mouse)
mouse.KeyDown:connect(Key)
end
script.Parent.Equipped:connect(Equip)

</ProtectedString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX34">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Zoom Script</string>
					<ProtectedString name="Source">local Tool = script.Parent
wut = Tool.Parent
&#9;repeat wait() until _G.RoLib _G.RoLib()
&#9;local headWeld
&#9;local char = getCharacter()
&#9;local head = waitForChild(char, &quot;Head&quot;)
&#9;local headFake = waitForChild(char, &quot;HeadFake&quot;)
&#9;if headFake == nil then
&#9;headFake = head:Clone()
&#9;end
&#9;for i, child in pairs(head:GetChildren()) do
&#9;&#9;if child.className == &quot;Weld&quot; then
&#9;&#9;&#9;child.Parent = headFake
&#9;&#9;&#9;child.Part0 = headFake
&#9;&#9;else
&#9;&#9;child:remove()
&#9;&#9;end
&#9;end
&#9;head.Transparency = 1
&#9;headFake.Name = &quot;HeadFake&quot;
&#9;headFake.Parent = char
&#9;headWeld = createWeld(head, headFake, CFrame.new(0, -0.5, 0), CFrame.new(0, -0.5, 0))

function onEquipped(mouse2)
&#9;mouse2.KeyDown:connect(onkeyDown)
&#9;mouse = mouse2
end

function onkeyDown(key) 
&#9;if key == &quot;z&quot; then
&#9;if Tool.Running.Value == false and a == false then 
&#9;&#9;game.Workspace.CurrentCamera.FieldOfView = 30
&#9;&#9;Tool.Aim.Value = 0.1
&#9;&#9;Tool.ZoomedIn.Value = true
&#9;&#9;Tool.Parent.Humanoid.WalkSpeed = 3
&#9;&#9;a=true
&#9;&#9;headWeld.C0 = CFrame.new(0, -0.5, 0) * CFrame.Angles(0, 0, Tool.ZoomedIn.Value == true and -math.pi / 8 or 0 )
&#9;
&#9;else
&#9;&#9;a=false
&#9;&#9;game.Workspace.CurrentCamera.FieldOfView = 70
&#9;&#9;Tool.ZoomedIn.Value = false
&#9;&#9;Tool.Aim.Value = 15
&#9;&#9;Tool.Parent.Humanoid.WalkSpeed = 16
&#9;&#9;headWeld.C0 = CFrame.new(0, -0.5, 0) * CFrame.Angles(0, 0, Tool.ZoomedIn.Value == true and -math.pi / 8 or 0 )
&#9;end
end 
end




script.Parent.Equipped:connect(onEquipped)
</ProtectedString>
				</Properties>
			</Item>
