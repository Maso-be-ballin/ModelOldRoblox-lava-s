					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Shooter</string>
					<ProtectedString name="Source">Tool = script.Parent

local arms = nil
local torso = nil
local weld33 = nil -- right arm
local weld55 = nil -- left arm
local welds = {}
local reloading = false
local firing = false
local canreload = true
local canshoot = true
local damage = 200



function ReloadSequence()
weld33.C1 = CFrame.new(-0.95, 0.05, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-91), math.rad(-35), 0.2) 
weld55.C1 = CFrame.new(1.27, 0.85, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(275), 0.83, math.rad(-0))
wait(.04)
weld33.C1 = CFrame.new(-0.85, 0.2, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-92), math.rad(-35), 0.4) 
weld55.C1 = CFrame.new(1.24, 0.55, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(275), 0.96, math.rad(-0))
wait(.04)
weld33.C1 = CFrame.new(-0.75, 0.35, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-93), math.rad(-35), 0.6)
weld55.C1 = CFrame.new(1.21, 0.25, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(275), 1.09, math.rad(-0)) 
wait(.04)
weld33.C1 = CFrame.new(-0.65, 0.5, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-94), math.rad(-35), 0.8) 
weld55.C1 = CFrame.new(1.18, -0.05, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(275), 1.22, math.rad(-0))
wait(.04)
weld33.C1 = CFrame.new(-0.55, 0.65, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-95), math.rad(-35), 1)
weld55.C1 = CFrame.new(1.15, -0.35, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(275), 1.35, math.rad(-0)) 
wait(.04)
weld33.C1 = CFrame.new(-0.45, 0.8, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-96), math.rad(-35), 1.2) 
weld55.C1 = CFrame.new(1.12, -0.65, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(275), 1.48, math.rad(-0))
wait(.1)
weld33.C1 = CFrame.new(-0.45, 0.8, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-98), math.rad(-35), 1.2) 
weld55.C1 = CFrame.new(1.12, -0.85, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(275), 1.48, math.rad(-0))
Tool.Handle.M1:play()
Tool.Mag.Transparency = 1
local mag = Tool.Mag:clone()
mag.Parent = game.Workspace
mag.CanCollide = false
mag.Transparency = 0
Tool.Mag2.Transparency = 1
local mag = Tool.Mag2:clone()
mag.Parent = game.Workspace
mag.CanCollide = false
mag.Transparency = 0
Tool.Mag3.Transparency = 1
local mag = Tool.Mag3:clone()
mag.Parent = game.Workspace
mag.CanCollide = false
mag.Transparency = 0
wait(.04)
weld33.C1 = CFrame.new(-0.45, 0.8, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-98), math.rad(-35), 1.2) 
weld55.C1 = CFrame.new(1.12, -0.95, 0.3) * CFrame.fromEulerAnglesXYZ(math.rad(280), 1.48, math.rad(-0))
wait(.04)
weld33.C1 = CFrame.new(-0.45, 0.8, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-98), math.rad(-35), 1.2) 
weld55.C1 = CFrame.new(1.12, -1.05, 0.1) * CFrame.fromEulerAnglesXYZ(math.rad(285), 1.48, math.rad(-0))
wait(.04)
weld33.C1 = CFrame.new(-0.45, 0.8, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-98), math.rad(-35), 1.2) 
weld55.C1 = CFrame.new(1.12, -1.15, -0.1) * CFrame.fromEulerAnglesXYZ(math.rad(290), 1.48, math.rad(-0))
wait(.04)
weld33.C1 = CFrame.new(-0.45, 0.8, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-99), math.rad(-35), 1.2) 
weld55.C1 = CFrame.new(1.12, -1.25, -0.3) * CFrame.fromEulerAnglesXYZ(math.rad(295), 1.48, math.rad(-0))
wait(.04)
weld33.C1 = CFrame.new(-0.45, 0.8, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-99), math.rad(-35), 1.2) 
weld55.C1 = CFrame.new(1.12, -1.25, -0.5) * CFrame.fromEulerAnglesXYZ(math.rad(300), 1.48, math.rad(-0))
wait(.04)
weld33.C1 = CFrame.new(-0.45, 0.8, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-99), math.rad(-35), 1.2) 
weld55.C1 = CFrame.new(1.12, -1.25, -0.7) * CFrame.fromEulerAnglesXYZ(math.rad(305), 1.48, math.rad(-0))
wait(.1)
weld33.C1 = CFrame.new(-0.45, 0.8, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-99), math.rad(-35), 1.2) 
weld55.C1 = CFrame.new(1.12, -1.25, -0.5) * CFrame.fromEulerAnglesXYZ(math.rad(300), 1.48, math.rad(-0))
wait(.04)
weld33.C1 = CFrame.new(-0.45, 0.8, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-99), math.rad(-35), 1.2) 
weld55.C1 = CFrame.new(1.12, -1.25, -0.3) * CFrame.fromEulerAnglesXYZ(math.rad(295), 1.48, math.rad(-0))
wait(.04)
weld33.C1 = CFrame.new(-0.45, 0.8, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-98), math.rad(-35), 1.2) 
weld55.C1 = CFrame.new(1.12, -1.25, -0.1) * CFrame.fromEulerAnglesXYZ(math.rad(290), 1.48, math.rad(-0))
wait(.04)
weld33.C1 = CFrame.new(-0.45, 0.8, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-98), math.rad(-35), 1.2) 
weld55.C1 = CFrame.new(1.12, -1.25, 0.1) * CFrame.fromEulerAnglesXYZ(math.rad(285), 1.48, math.rad(-0))
wait(.1)
weld33.C1 = CFrame.new(-0.45, 0.8, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-98), math.rad(-35), 1.2) 
weld55.C1 = CFrame.new(1.12, -1.25, 0.3) * CFrame.fromEulerAnglesXYZ(math.rad(280), 1.48, math.rad(-0))
