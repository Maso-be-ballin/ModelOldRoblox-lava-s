function onKeyDown(key,mouse)
&#9;key=key:lower()
&#9;if key==&quot;r&quot; and not reloading and attaching == false then
&#9;&#9;if sp.Ammo.Value &lt; ClipSize and sp.AmmoStored.Value ~= 0 then
&#9;&#9;reload(mouse)
&#9;&#9;end
&#9;end

&#9;if key == &quot;f&quot; and not reloading then
&#9;if Tool.FireMode.Value &lt; 2 then
&#9;Tool.FireMode.Value = Tool.FireMode.Value + 1
&#9;else
&#9;Tool.FireMode.Value = 1
&#9;end
&#9;end

&#9;if key == &quot;q&quot; and not reloading then
&#9;&#9;if Tool.ZoomedIn.Value == false and reloading == false and Tool.Running.Value == false and holst == false and running == false and attaching == false then
&#9;&#9;zooming = true
&#9;&#9;aimtest()
&#9;&#9;elseif Tool.ZoomedIn.Value == true and reloading == false and Tool.Running.Value == false and holst == false and running == false and attaching == false then
&#9;&#9;zooming = true
&#9;&#9;aimoff()
&#9;&#9;end
&#9;end
&#9;if key == &quot;m&quot; and Tool.ZoomedIn.Value == true then
&#9;zoomdist = zoomdist + 10
&#9;end
&#9;if key == &quot;n&quot; and Tool.ZoomedIn.Value == true then
&#9;zoomdist = zoomdist - 10
&#9;end

&#9;--[[if key ==&quot;v&quot; and not reloading and attaching == false then
&#9;if script.Silenced.Value == false then
&#9;&#9;attaching = true
&#9;&#9;attach()
&#9;&#9;script.Silenced.Value = true
&#9;&#9;attaching = false
&#9;&#9;barrel_1.Normal:remove()
&#9;&#9;silencer = script.Silencer:clone()
&#9;&#9;silencer.Parent = barrel_1
&#9;&#9;barrel_1.BrickColor = BrickColor.new(&quot;Black&quot;)
&#9;elseif script.Silenced.Value == true then
&#9;&#9;attaching = true
&#9;&#9;attach()
&#9;&#9;script.Silenced.Value = false 
&#9;&#9;attaching = false
&#9;&#9;barrel_1.Silencer:remove()
&#9;&#9;normal = script.Normal:clone()
&#9;&#9;normal.Parent = barrel_1
&#9;&#9;barrel_1.BrickColor = BrickColor.new(&quot;Dark stone grey&quot;)
&#9;end
&#9;end]]
&#9;if key ==&quot;g&quot; and not reloading then
&#9;&#9;onThrow2()
&#9;end
&#9;if key:byte() == 48 and not reloading  and attaching == false then
&#9;if Tool.Running.Value == false and not a and Tool.ZoomedIn.Value == false and reloading == false and holst == false and running == false and attaching == false then
&#9;Tool.Running.Value = true
&#9;sprint()
&#9;elseif Tool.Running.Value == true and not a and Tool.ZoomedIn.Value == false and reloading == false and holst == false and running == false and attaching == false then
&#9;run()
&#9;end
&#9;end
end

function movecframe(p,pos)
&#9;p.Parent=game.Lighting
&#9;p.Position=pos
&#9;p.Parent=game.Workspace
end

&#9; function rayCast(pos, dir, ignore)
&#9;&#9;return workspace:FindPartOnRayWithIgnoreList(Ray.new(pos, dir.unit * math.min(dir.magnitude, 999)), ignore)
&#9;end
&#9; function calculateTrajectory(velocity, gravity, mass, t)
&#9;&#9;return velocity*t + gravity*mass*t*t
&#9;end
&#9; function createPart(name, parent, delete)
&#9;&#9;local part = Instance.new(&quot;Part&quot;)
&#9;&#9;part.BottomSurface = &quot;Smooth&quot;
&#9;&#9;part.TopSurface = &quot;Smooth&quot;
&#9;&#9;part.FormFactor = &quot;Custom&quot;
&#9;&#9;part.CanCollide = false
&#9;&#9;part.Name = name
&#9;&#9;part.Size = Vector3.new(0.2, 0.2, 0.2)
&#9;&#9;part.Parent = parent
&#9;&#9;if delete then
&#9;&#9;&#9;game.Debris:AddItem(part)
&#9;&#9;end
&#9;&#9;return part
&#9;end
&#9; function createWeld (p0, p1, c0, c1)
&#9;&#9;local weld = Instance.new(&quot;Weld&quot;)
&#9;&#9;weld.Part0 = p0
&#9;&#9;weld.Part1 = p1
&#9;&#9;weld.C0 = c0 or CFrame.new(0, 0, 0)
&#9;&#9;weld.C1 = c1 or CFrame.new(0, 0, 0)
&#9;&#9;weld.Parent = p0
&#9;&#9;return weld
&#9;end

&#9; function placePartWithMesh(part, mesh, pos0, pos1)
&#9;&#9;local frame = CFrame.new((pos0 + pos1) / 2, pos1)
&#9;&#9;part.CFrame = frame - frame.p
&#9;&#9;mesh.Offset = part.CFrame:pointToObjectSpace(frame.p)
&#9;&#9;mesh.Scale = Vector3.new(mesh.Scale.x, mesh.Scale.y, (pos0 - pos1).magnitude * 5)
&#9;end
&#9;function createBlockMesh(part, scale)
&#9;&#9;local mesh = Instance.new(&quot;BlockMesh&quot;)
&#9;&#9;mesh.Scale = scale
&#9;&#9;mesh.Parent = part
&#9;&#9;return mesh
&#9;end
&#9;function lerp(a, b, t)
&#9;return a + (b - a)*t
end
&#9;function slerp(a, b, t)
&#9;local dot = a:Dot(b)
&#9;if dot &gt; 0.99999 or dot &lt; -0.99999 then
&#9;&#9;return t &lt;= 0.5 and a or b
&#9;else
&#9;&#9;local r = math.acos(dot)
&#9;&#9;return (a*math.sin((1 - t)*r) + b*math.sin(t*r)) / math.sin(r)
&#9;end
end
&#9;function matrixInterpolate(a, b, t)
&#9;&#9;local ax, ay, az, a00, a01, a02, a10, a11, a12, a20, a21, a22 = a:components()
&#9;&#9;local bx, by, bz, b00, b01, b02, b10, b11, b12, b20, b21, b22 = b:components()

&#9;&#9;local v0 =  lerp(Vector3.new(ax , ay , az ), Vector3.new(bx , by , bz) , t) -- Position
&#9;&#9;local v1 = slerp(Vector3.new(a00, a01, a02), Vector3.new(b00, b01, b02), t) -- Vector right
&#9;&#9;local v2 = slerp(Vector3.new(a10, a11, a12), Vector3.new(b10, b11, b12), t) -- Vector up
&#9;&#9;local v3 = slerp(Vector3.new(a20, a21, a22), Vector3.new(b20, b21, b22), t) -- Vector back

&#9;&#9;return CFrame.new(
&#9;&#9;&#9;v0.x, v0.y, v0.z,
&#9;&#9;&#9;v1.x, v1.y, v1.z,
&#9;&#9;&#9;v2.x, v2.y, v2.z,
&#9;&#9;&#9;v3.x, v3.y, v3.z)
&#9;end
function fire(aim)
&#9;if script.Silenced.Value == false then
&#9;sp.Handle.Fire:Play()
&#9;elseif script.Silenced.Value == true then
&#9;sp.Handle.Fire2:Play()
&#9;end
&#9;
&#9;Tool.Running.Value = false
&#9;
&#9;t=r.Stepped:wait()
&#9;last6=last5
&#9;last5=last4
&#9;last4=last3
&#9;last3=last2
&#9;last2=last
&#9;last=t
&#9;local totalDist=0
&#9;Lengthdist=-RayLength/.5
&#9;head = sp.Parent:FindFirstChild(&quot;Head&quot;)
&#9;startpoint=head.CFrame.p
&#9;local dir=(aim)-startpoint

&#9;local position = head.Position
&#9;local velocity = dir.unit * gunSpecs.bulletSpeed
&#9;local pos0, hit
&#9;local pos1 = position
&#9;local bullet = createPart(&quot;Bullet&quot;, workspace.Ignore, true)
&#9;bullet.BrickColor = BrickColor.new(1008)
&#9;bullet.Anchored = true
&#9;bullet.CFrame = CFrame.new(0, 0, 0)
&#9;local bulletMesh = createBlockMesh(bullet, Vector3.new(0.2222, 0.2222, 0.2222))


Spawn(function()
&#9;&#9;&#9;&#9;&#9;local time = 0.03
&#9;&#9;&#9;&#9;&#9;for i = 1, 100 do
&#9;&#9;&#9;&#9;&#9;&#9;pos0 = pos1
&#9;&#9;&#9;&#9;&#9;&#9;pos1 = calculateTrajectory(velocity, Vector3.new(0, -9.81, 0), gunSpecs.bulletMass, time)

&#9;&#9;&#9;&#9;&#9;&#9;-- Ray cast
&#9;&#9;&#9;&#9;&#9;&#9;hit, pos1 = rayCast(pos0, pos1, {script.Parent,workspace.Ignore,sp.Parent})

&#9;&#9;&#9;&#9;&#9;&#9;-- Place path
&#9;&#9;&#9;&#9;&#9;&#9;if i == 1 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;placePartWithMesh(bullet, bulletMesh, pos0, pos1)
&#9;&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;&#9;-- Stop or continue
&#9;&#9;&#9;&#9;&#9;&#9;if hit then break end
&#9;&#9;&#9;&#9;&#9;&#9;time = time + wait()
&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;-- Hit
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if hit then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;print(hit.Name)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if hit.Parent.className == &quot;Hat&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;hit = hit.Parent
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif hit.Parent.className == &quot;Tool&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;hit = hit.Parent
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;local humanoid=hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if humanoid~=nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;local damage=math.random(BaseDamage-(BaseDamage*0.01),BaseDamage+(BaseDamage*0.01))
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if hit.Name==&quot;Head&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;damage=damage*2
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif hit.Name==&quot;Torso&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;damage=damage*1.25
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;damage=damage
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if humanoid.Health&gt;0 and h.Health&gt;0 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;local eplr=game.Players:playerFromCharacter(humanoid.Parent)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;local plr=game.Players:playerFromCharacter(sp.Parent)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;--[[if eplr~=nil and plr~=nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if eplr.Neutral or plr.Neutral then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Mouse.Icon = &quot;http://www.roblox.com/asset/?id=49170312&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;tagHumanoid(humanoid)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;humanoid:TakeDamage(damage)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Mouse.Icon = &quot;http://www.roblox.com/asset/?id=49170312&quot;&#9;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;tagHumanoid(humanoid)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;humanoid:TakeDamage(damage)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end]]
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if eplr~=nil and plr~=nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;--&#9;if eplr.TeamColor~=plr.TeamColor or eplr.Neutral or plr.Neutral then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Mouse.Icon = &quot;http://www.roblox.com/asset/?id=49170312&quot;&#9;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;tagHumanoid(humanoid)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;humanoid:TakeDamage(damage)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;--&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Mouse.Icon = &quot;http://www.roblox.com/asset/?id=49170312&quot;&#9;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;tagHumanoid(humanoid)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;humanoid:TakeDamage(damage)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if (hit.Parent:findFirstChild(&quot;Hit&quot;)) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;hit.Parent.Health.Value = hit.Parent.Health.Value - BaseDamage/3
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if hit.Parent.Parent.Name == &quot;HumVee&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;hit.Parent.Parent.Health.Value = hit.Parent.Parent.Health.Value - BaseDamage
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Mouse.Icon = &quot;http://www.roblox.com/asset/?id=49170312&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif hit.Parent.Name == &quot;HumVee&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;hit.Parent.Health.Value = hit.Parent.Health.Value - BaseDamage
