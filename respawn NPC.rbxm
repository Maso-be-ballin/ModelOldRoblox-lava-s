					<Item class="Script" referent="RBX5618">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">NewSeatScript</string>
							<ProtectedString name="Source">sit=false
function up()
&#9;if h.Sit==false then
&#9;&#9;weld:remove()
&#9;&#9;wait(.5)
&#9;&#9;sit=false
&#9;end
end
function Sit(hit)
&#9;h=hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if h~=nil then
&#9;&#9;if sit==false then
&#9;&#9;&#9;sit=true
&#9;&#9;&#9;h.Sit=true
&#9;&#9;&#9;weld=Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;weld.Parent=script.Parent
&#9;&#9;&#9;weld.Part0=script.Parent
&#9;&#9;&#9;weld.Part1=hit.Parent.Torso
&#9;&#9;&#9;change=-((script.Parent.Size.y/2) + 1.49)
&#9;&#9;&#9;if script.Parent.Mode.Value==1 then --reg
&#9;&#9;&#9;&#9;weld.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(0, change, 0)
&#9;&#9;&#9;elseif script.Parent.Mode.Value==2 then --Back
&#9;&#9;&#9;&#9;weld.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(0, change, -((script.Parent.Size.z/2)-.5))
&#9;&#9;&#9;elseif script.Parent.Mode.Value==3 then --Centered
&#9;&#9;&#9;&#9;weld.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(0, change, -0.75)
&#9;&#9;&#9;elseif script.Parent.Mode.Value==0 then --classic
&#9;&#9;&#9;&#9;weld.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(0, -2.4, 0)
&#9;&#9;&#9;end
&#9;&#9;&#9;h.Changed:connect(up)
&#9;&#9;end
&#9;end
end


script.Parent.Touched:connect(Sit)</ProtectedString>
						</Properties>
					</Item>
					<Item class="NumberValue" referent="RBX5619">
						<Properties>
							<string name="Name">Mode</string>
							<double name="Value">1</double>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX5620">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Instructions</string>
							<ProtectedString name="Source">--[[
Modes:
1-Torso in the center, but the butt aligns no matter what size brick it is.   (This is default for all except &quot;0&quot;)
2-Back Aligned to the rear of the part, so if there is another part alongside it the back of the player will be aligned to appear to be resting.
3-The whole player is centered on the part.
0-The old seat functionality, not suggested.
]]</ProtectedString>
						</Properties>
					</Item>
				</Item>
