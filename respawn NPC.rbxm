						<Item class="Script" referent="RBX3084">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Telescript</string>
								<ProtectedString name="Source">local other = script.Parent.Parent.Parent.Parent.Telething1.Teleporter
function onClicked()
local model = script.Parent.Parent
other.Door1.CanCollide = false
other.Door1.Transparency = 1
other.Door2.CanCollide = true
other.Door2.Transparency = 0
model.Door1.CanCollide = false
model.Door1.Transparency = 1
model.Door2.CanCollide = true
model.Door2.Transparency = 0
model.Name = &quot;Activating components&quot;
other.Name = &quot;Activating components&quot;
wait(.2)
model.Name = &quot;Activating components.&quot;
other.Name = &quot;Activating components.&quot;
wait(.2)
model.Name = &quot;Activating components..&quot;
other.Name = &quot;Activating components..&quot;
wait(.2)
model.Name = &quot;Activating components...&quot;
other.Name = &quot;Activating components...&quot;
wait(.2)
model.Name = &quot;Connecting to telenet...&quot;
other.Name = &quot;Connecting to telenet...&quot;
wait(.5)
model.Name = &quot;Locating desired teleporter...&quot;
other.Name = &quot;Locating desired teleporter...&quot;
wait(.5)
model.Name = &quot;Desired teleporter found&quot;
other.Name = &quot;Desired teleporter found&quot;
wait(.5)
model.Name = &quot;Preparing to send player...&quot;
other.Name = &quot;Preparing to recieve player...&quot;
wait(.5)
model.Name = &quot;Begining teleportation...&quot;
other.Name = &quot;Begining teleportation...&quot;
wait(1)
model.Name = &quot;Teleporter is now&quot;
other.Name = &quot;Teleporter is now&quot;
wait(0.5)
model.Name = &quot;Sending...&quot;
other.Name = &quot;Recieving...&quot;
model.RSign.Transparency = 0.9
other.RSign.Transparency = 0.9
wait(.3)
model.RSign.Transparency = 0.8
other.RSign.Transparency = 0.8
wait(.3)
model.RSign.Transparency = 0.85
other.RSign.Transparency = 0.85
wait(.3)
model.RSign.Transparency = 0.7
other.RSign.Transparency = 0.7
wait(.3)
model.RSign.Transparency = 0.8
other.RSign.Transparency = 0.8
wait(.3)
model.RSign.Transparency = 0.65
other.RSign.Transparency = 0.65
wait(.3)
model.RSign.Transparency = 0.7
other.RSign.Transparency = 0.7
wait(.3)
model.RSign.Transparency = 0.5
other.RSign.Transparency = 0.5
wait(.3)
model.RSign.Transparency = 0.55
other.RSign.Transparency = 0.55
wait(.3)
model.RSign.Transparency = 0.3
other.RSign.Transparency = 0.3
wait(.3)
model.RSign.Transparency = 0.45
other.RSign.Transparency = 0.45
wait(.3)
model.RSign.Transparency = 0.5
other.RSign.Transparency = 0.5
wait(.3)
model.RSign.Transparency = 0.45
other.RSign.Transparency = 0.45
wait(.3)
model.RSign.Transparency = 0.4
other.RSign.Transparency = 0.4
wait(.3)
model.RSign.Transparency = 0.45
other.RSign.Transparency = 0.45
wait(.3)
model.RSign.Transparency = 0.4
other.RSign.Transparency = 0.4
wait(.3)
model.RSign.Transparency = 0.45
other.RSign.Transparency = 0.45
wait(.3)
model.RSign.Transparency = 0.3
other.RSign.Transparency = 0.3
wait(.3)
model.RSign.Transparency = 0.2
other.RSign.Transparency = 0.2
wait(.3)
model.RSign.Transparency = 0.25
other.RSign.Transparency = 0.25
wait(.3)
model.RSign.Transparency = 0.1
other.RSign.Transparency = 0.1
wait(.3)
model.RSign.Transparency = 0.15
other.RSign.Transparency = 0.15
wait(.3)
model.RSign.Transparency = 0.05
other.RSign.Transparency = 0.05
wait(.3)
model.RSign.Transparency = 0.1
other.RSign.Transparency = 0.1
wait(.3)
model.RSign.Transparency = 0.01
other.RSign.Transparency = 0.01
wait(.3)
model.RSign.Transparency = 0
other.RSign.Transparency = 0
wait(1)
model.RSign.Transparency = 0.1
other.RSign.Transparency = 0.1
wait(.3)
model.RSign.Transparency = 0.2
other.RSign.Transparency = 0.2
wait(.3)
model.RSign.Transparency = 0.3
other.RSign.Transparency = 0.3
wait(.3)
model.RSign.Transparency = 0.4
other.RSign.Transparency = 0.4
wait(.3)
model.RSign.Transparency = 0.5
other.RSign.Transparency = 0.5
wait(.3)
model.RSign.Transparency = 0.6
other.RSign.Transparency = 0.6
wait(.3)
model.RSign.Transparency = 0.7
other.RSign.Transparency = 0.7
wait(.3)
model.RSign.Transparency = 0.8
other.RSign.Transparency = 0.8
wait(.3)
model.RSign.Transparency = 0.9
other.RSign.Transparency = 0.9
wait(.3)
model.RSign.Transparency = 1
other.RSign.Transparency = 1
model.Name = &quot;Player has been sucessfully teleported.&quot;
other.Name = &quot;Player has been sucessfully teleported.&quot;
model.Door1.CanCollide = true
model.Door1.Transparency = 0
model.Door2.CanCollide = false
model.Door2.Transparency = 1
other.Door1.CanCollide = true
other.Door1.Transparency = 0
other.Door2.CanCollide = false
other.Door2.Transparency = 1
wait(5)
model.Name = &quot;Teleporter&quot;
other.Name = &quot;Teleporter&quot;
end
script.Parent.ClickDetector.MouseClick:connect (onClicked)
</ProtectedString>
