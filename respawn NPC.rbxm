					<Item class="BodyThrust" referent="RBX2875">
						<Properties>
							<string name="Name">BodyThrust</string>
							<Vector3 name="force">
								<X>0</X>
								<Y>0</Y>
								<Z>0</Z>
							</Vector3>
							<Vector3 name="location">
								<X>0</X>
								<Y>0</Y>
