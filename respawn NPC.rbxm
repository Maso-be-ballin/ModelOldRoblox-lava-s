						<ProtectedString name="Source">wait(999)
script.Parent.Size = Vector3.new(1,1,1)
wait(3.5)
moo = math.random(1,2)
if moo &gt; 1 then
script.Parent:findFirstChild(&quot;Script&quot;).f.Value = 1
script.Parent:findFirstChild(&quot;BurnScript&quot;):remove()
script.Parent:findFirstChild(&quot;Script&quot;):remove()
script:remove()
else
script.Parent:remove()
end
