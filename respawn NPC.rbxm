					<string name="Name">Text Update Script</string>
					<ProtectedString name="Source">-- CONFIGURATION
local model = script.Parent
local INTERVAL = 5

-- CUSTOMIZABLE NAMES ARRAY
local modelNames = {
&#9;&quot;Swing Controls. Very Cool B).&quot;,
   &quot;Controls: W = Backwards&quot;,
   &quot;Controls: S = Forward&quot;
}

-- RUNNING THE LOOP
local currentIndex = 1

while true do
&#9;local newName = modelNames[currentIndex]
&#9;
&#9;-- 2012 property assignment
&#9;model.Name = newName
&#9;print(&quot;[UPDATE] Model name changed to: &quot; .. newName)
&#9;
&#9;-- Increment index
&#9;currentIndex = currentIndex + 1
&#9;if currentIndex &gt; #modelNames then
&#9;&#9;currentIndex = 1
&#9;end
&#9;
&#9;-- 2012 Delay method (task.wait did not exist)
&#9;wait(INTERVAL)
end
</ProtectedString>
