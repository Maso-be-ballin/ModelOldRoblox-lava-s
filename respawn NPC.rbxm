							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">PresentScript</string>
							<ProtectedString name="Source">local debounce = false

function getPlayer(humanoid) 
local players = game.Players:children() 
for i = 1, #players do 
if players[i].Character.Humanoid == humanoid then return players[i] end 
end 
return nil 
end 

function onTouch(part) 

local human = part.Parent:findFirstChild(&quot;Humanoid&quot;) 
if (human ~= nil) and debounce == false then

debounce = true

local player = getPlayer(human) 

if (player == nil) then return end 

user = game.Players:findFirstChild(human.Parent.Name)
local gold = user.leaderstats.Gold
&#9;if player.Backpack:findFirstChild(&quot;Change This&quot;) ~= nil then---Change where it says &quot;Change This&quot; to the sword name.
&#9;gold.Value = gold.Value + 50---For much that player will get after selling it.
&#9;m = Instance.new(&quot;Hint&quot;)
&#9;m.Text = &quot;You sold&quot;---This is the messegge that will pop up if they have the item.

&#9;m.Parent = player
&#9;player.Backpack:findFirstChild(&quot;Change This&quot;):remove()---Change where it says &quot;Change This&quot; to the sword name.

&#9;wait(2)
&#9;m.Parent = nil
else
&#9;m = Instance.new(&quot;Hint&quot;)
&#9;m.Text = &quot;You dont have that&quot;---This is the messege that will pop up if they don&apos;t have the item.
&#9;m.Parent = player
&#9;wait(3)
&#9;m.Parent = nil
end

wait(2)
debounce = false
end
end


script.Parent.Touched:connect(onTouch) 



-----i edited a sell script from someone else i&apos;d like to thank who ever buy script i edited</ProtectedString>
