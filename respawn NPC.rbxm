			<Item class="Script" referent="RBX6908">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">Flag=script.Parent.Flag
Indicator=script.Parent.Indicator

Top=Flag.Position.y
Bottom=Top-74

Move=1
Wait=0.1

Status=1 --1=Up; 0=Mid; -1=Down
Colors=1 --1=Native; -1=Foreign

Yes=BrickColor.new(&quot;Bright green&quot;)
No=BrickColor.new(&quot;Black&quot;)


ForeignControl=script.Parent.Options:FindFirstChild(&quot;Foreign Control&quot;).Head
NativeControl=script.Parent.Options:FindFirstChild(&quot;Native Control&quot;).Head
NeutralControl=script.Parent.Options:FindFirstChild(&quot;Neutral Control&quot;).Head

NativeDecal=script.Parent.Options:FindFirstChild(&quot;Native Control&quot;).Head.Decal.Texture
ForeignDecal=script.Parent.Options:FindFirstChild(&quot;Foreign Control&quot;).Head.Decal.Texture


UpE=false
SwitchE=false
DownE=true

UpButton=script.Parent.Controls.Up
DownButton=script.Parent.Controls.Down
SwitchButton=script.Parent.Controls.Switch

script.Parent.Options.Parent=nil

function UpdateEnablilities()
if Status==1 then
UpE=false
SwitchE=false
DownE=true
UpButton.BrickColor=No
DownButton.BrickColor=Yes
SwitchButton.BrickColor=No
elseif Status==0 then
UpE=true
SwitchE=false
DownE=true
UpButton.BrickColor=Yes
DownButton.BrickColor=Yes
SwitchButton.BrickColor=No
elseif Status==-1 then
UpE=true
SwitchE=true
DownE=false
UpButton.BrickColor=Yes
DownButton.BrickColor=No
SwitchButton.BrickColor=Yes
end
end

function AllNoEnablilities()
UpE=false
SwitchE=false
DownE=false
UpButton.BrickColor=No
DownButton.BrickColor=No
SwitchButton.BrickColor=No
end

function UpdateColors()
if Colors==1 then
Flag.BrickColor=BrickColor.new(NativeControl.Color)
Flag.F.Texture=NativeDecal
Flag.B.Texture=NativeDecal
C=script.Parent.Smokers:GetChildren()
for I=1,#C do
C[I].Smoke.Color=Flag.Color
end
Indicator.Color=Flag.Color
elseif Colors==-1 then
Flag.BrickColor=BrickColor.new(ForeignControl.Color)
Flag.F.Texture=ForeignDecal
Flag.B.Texture=ForeignDecal
C=script.Parent.Smokers:GetChildren()
for I=1,#C do
C[I].Smoke.Color=Flag.Color
end
Indicator.Color=Flag.Color
end
if Status&lt;1 then
C=script.Parent.Smokers:GetChildren()
for I=1,#C do
C[I].Smoke.Color=NeutralControl.Color
end
Indicator.Color=NeutralControl.Color
end
end

function Up()
if UpE==true then
Flag.Parent=nil
Flag.Position=Vector3.new(Flag.Position.x,Flag.Position.y+Move,Flag.Position.z)
Flag.Parent=script.Parent
if Flag.Position.y&gt;=Top then
Status=1
else
Status=0
end
AllNoEnablilities()
UpdateColors()
wait(Wait)
UpdateEnablilities()
end
end
function Down()
if DownE==true then
Flag.Parent=nil
Flag.Position=Vector3.new(Flag.Position.x,Flag.Position.y-Move,Flag.Position.z)
Flag.Parent=script.Parent
if Flag.Position.y&lt;=Bottom then
Status=-1
else
Status=0
end
AllNoEnablilities()
wait(Wait)
UpdateColors()
UpdateEnablilities()
end
end

function Switch()
if SwitchE==true then
if Colors==-1 then
Colors=1
elseif Colors==1 then
Colors=-1
end
UpdateColors()
AllNoEnablilities()
wait(Wait)
UpdateEnablilities()
end
end
UpButton.Click.MouseClick:connect(Up)
DownButton.Click.MouseClick:connect(Down)
SwitchButton.Click.MouseClick:connect(Switch)
UpdateEnablilities()
UpdateColors()</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX6909">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">README</string>
					<ProtectedString name="Source">--[[

Customizeable flag, made by Defaultio

Use this flag to help indicate who is in control in your clan or groups base while it is being raided.

To customize colors-
-Change the color of the &quot;Native Control&quot; brick to the color that you want the flag, smoke, and indicator to be when you are in control.
-Change the color of the &quot;Foreign Control&quot; brick to the color that you want the flag, smoke, and indicator to be when you are in control.
-Change the color of the &quot;Neutral Control&quot; brick to the color that you want the indicator and smoke to be when the flag is not fully raised.

To customize decals-
-Change the decal on the &quot;Native Control&quot; brick to the one you want to appear on the flag while in your control.
-Change the decal on the &quot;Foreign Control&quot; brick to the one you want to appear on the flag while someone else is in control.

Smoke-
-If you want smoke parts to change color according to the flag, insert them in the &quot;Smokers&quot; model. You can insert as many as you want, or
have none if you don&apos;t want any.

Change the mast, ropes, and other parts of the flag base to be the colors that fits you place.

Have fun!
-Defaultio

]]</ProtectedString>
				</Properties>
			</Item>
