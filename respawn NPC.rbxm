				<Item class="Script" referent="RBX530">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Animate</string>
						<ProtectedString name="Source">print(&quot;brandonhare&apos;s homemade animate script loaded XD&quot;) --XD
--Link up
Head = script.Parent.Head
Torso = script.Parent.Torso
RightArm = script.Parent:findFirstChild(&quot;Right Arm&quot;)
RightLeg = script.Parent:findFirstChild(&quot;Right Leg&quot;)
LeftArm = script.Parent:findFirstChild(&quot;Left Arm&quot;)
LeftLeg = script.Parent:findFirstChild(&quot;Left Leg&quot;)
Humanoid = script.Parent.Zombie

function onJumping() --Give a little help
Torso.BodyForce.force = Vector3.new(Torso.Velocity.x,1e+005,Torso.Velocity.z)
wait(0.1)
Torso.BodyForce.force = Vector3.new(0,2e+004,0) --Don&apos;t fly up!!
Torso.BodyGyro.maxTorque = Vector3.new(0,0,0) --Can fall over
Torso.RotVelocity = Vector3.new(0,0,100) --Fall over so isn&apos;t stuck while jumping
end

function onFallingDown() --Daleks don&apos;t fall down.
Torso.BodyGyro.maxTorque = Vector3.new(1e+006,1e+006,1e+006)
end

function onGettingUp() --GYYYYYROOOOOOOOO COME BAAAAAAAAAAAACK!
Torso.BodyGyro.maxTorque = Vector3.new(1e+006,0,1e+006)
end

function onDied()
&#9;pose = &quot;Dead&quot;
end

function onTouched(hit) --Kill!!!
if (hit.Parent:findFirstChild(&quot;Humanoid&quot;)== nil) then return end --It&apos;s...ALIVE!!!
if (hit.Parent:findFirstChild(&quot;IsaDalek&quot;)~= nil) then return end --Daleks don&apos;t kill eachother
hit.Parent.Humanoid.Health = 0
sound = Instance.new(&quot;Sound&quot;) --EXTERMINATE!!!
sound.SoundId = &quot;C:\Documents and Settings\Hare\Desktop\Daleks\exterminate&quot; --Sorry if you can&apos;t hear it
sound.Parent = Head --Where do you talk from?
sound.Volume = 1
sound:play()
end

function onRunning(speed) --Instead of moving limbs, spinning wheels and head XD
if speed&gt;0 then
Torso.TopParamB = speed/100
LeftLeg.RightParamB = speed/100
LeftArm.RightParamB = speed/100
RightLeg.RightParamB = -speed/100
RightArm.RightParamB = -speed/100
else
Torso.TopParamB = 0
LeftLeg.RightParamB = 0
LeftArm.RightParamB = 0
RightLeg.RightParamB = 0
RightArm.RightParamB = 0
end
end
--Ever tried to turn a lightbulb on with no wires?  I have XD
Humanoid.Jumping:connect(onJumping)
Humanoid.FallingDown:connect(onFallingDown)
Humanoid.GettingUp:connect(onGettingUp)
Humanoid.Died:connect(onDied)
Humanoid.Running:connect(onRunning)

c = script.Parent:GetChildren()
for i = 1, #c do --Deadly Daleks Don&apos;t Die.
if (c[i].Name == &quot;Kill&quot;) then c[i].Touched:connect(onTouched) end
end
</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX531">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Respawn</string>
						<ProtectedString name="Source">name=&quot;Zombie&quot;

robo=script.Parent:clone()

while true do
&#9;wait(10)
&#9;if script.Parent.Zombie.Health&lt;1 then
&#9;&#9;robot=robo:clone()
&#9;&#9;robot.Parent=script.Parent.Parent
&#9;&#9;robot:makeJoints()
&#9;&#9;script.Parent:remove()
&#9;end
end
&#9;&#9;


</ProtectedString>
					</Properties>
				</Item>
