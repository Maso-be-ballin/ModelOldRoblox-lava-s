				<Item class="Script" referent="RBX5909">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">welding</string>
						<ProtectedString name="Source">pln = script.Parent

local w = Instance.new(&quot;Weld&quot;) 
w.Parent = pln.DressBottom 
w.Part0 = w.Parent --&gt; part0 has to be the parent 
w.Part1 = pln.DressTop
w.C0 = CFrame.new(0, 0.4, 0)*CFrame.fromEulerAnglesXYZ(0, 0, 0)

local w = Instance.new(&quot;Weld&quot;) 
w.Parent = pln.DressBottom 
w.Part0 = w.Parent --&gt; part0 has to be the parent 
w.Part1 = pln.DressTop2
w.C0 = CFrame.new(0, 0.4, 0)*CFrame.fromEulerAnglesXYZ(math.pi/1, 0, 0)

local w = Instance.new(&quot;Weld&quot;) 
w.Parent = pln.DressTop 
w.Part0 = w.Parent --&gt; part0 has to be the parent 
w.Part1 = pln.Sleeve
w.C0 = CFrame.new(-0.4, 0, 0)*CFrame.fromEulerAnglesXYZ(0, 0, math.pi/2.5)

local w = Instance.new(&quot;Weld&quot;) 
w.Parent = pln.DressTop 
w.Part0 = w.Parent --&gt; part0 has to be the parent 
w.Part1 = pln.Sleeve2
w.C0 = CFrame.new(0.4, 0, 0)*CFrame.fromEulerAnglesXYZ(0, 0, -math.pi/2.5)

local w = Instance.new(&quot;Weld&quot;) 
w.Parent = pln.Sleeve 
w.Part0 = w.Parent --&gt; part0 has to be the parent 
w.Part1 = pln.Arm
w.C0 = CFrame.new(-0.5, -0, 0)*CFrame.fromEulerAnglesXYZ(0, 0, math.pi/2)

local w = Instance.new(&quot;Weld&quot;) 
w.Parent = pln.Sleeve2 
