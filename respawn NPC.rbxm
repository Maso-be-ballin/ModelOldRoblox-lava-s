							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Paintball</string>
							<ProtectedString name="Source">ball = script.Parent

function CheckBrick(brick) -- This function checks to see if brick is anchored or locked.
&#9;Object = brick
&#9;if Object:findFirstChild(&quot;BurnScript&quot;) ~= nil or Object:findFirstChild(&quot;Wet&quot;) ~= nil then -- Do Not Burn Anything Else Un-Burnable
&#9;&#9;return
&#9;end
&#9;if brick.className ~= &quot;Part&quot; then -- Do Not Burn Spawns, Seats, Or Flag Stands
&#9;&#9;return
&#9;end
&#9;if Object.Locked == true or Object.Anchored == true or Object.Name == &quot;Fire&quot; then -- Do Not Burn The BasePlate
&#9;&#9;return
&#9;end
&#9;if Object.BrickColor == BrickColor.Blue() or Object.Transparency &gt; 0 then -- Do Not Burn Water
&#9;&#9;return
&#9;end
&#9;return true -- in none of the above is true then return True.
end

function onTouched(hit)
&#9;if script.Parent:findFirstChild(&quot;Script&quot;).f.Value ~= 1 then
&#9;if CheckBrick(hit) then
&#9;hit.BrickColor = BrickColor.Black()
&#9;local FireScript = script.Parent:findFirstChild(&quot;Script&quot;):clone()
&#9;FireScript.Disabled = false
&#9;FireScript.Parent = hit

&#9;local FireScript2 = script.Parent:findFirstChild(&quot;size&quot;):clone()
&#9;FireScript2.Disabled = false
&#9;FireScript2.Parent = hit

&#9;local FireScript3 = script.Parent:findFirstChild(&quot;BurnScript&quot;):clone()
&#9;FireScript3.Disabled = false
&#9;FireScript3.Parent = hit
&#9;
&#9;local FireScript4 = script:clone()
&#9;FireScript4.Disabled = false
&#9;FireScript4.Parent = hit
&#9;end
&#9;end
end


connection = ball.Touched:connect(onTouched)

</ProtectedString>
