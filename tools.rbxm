			<Item class="LocalScript" referent="RBX5775">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui</string>
					<ProtectedString name="Source">local Tool = script.Parent;

enabled = true
function onButton1Down(mouse)
&#9;if not enabled then
&#9;&#9;return
&#9;end

&#9;enabled = false
&#9;mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;

&#9;wait(1)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;enabled = true

end

function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end

&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end


Tool.Equipped:connect(onEquippedLocal)
</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX5776">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">BoomerangControl</string>
					<ProtectedString name="Source">local bodyp = script.Parent.BodyPosition
local connection = nil


local sound = script.Parent.FlyingSound
sound.Looped = true
sound:Play()


function OnTouch(hit)
&#9;bodyp:Remove()
&#9;connection:disconnect()
&#9;sound:Stop()
end


connection = script.Parent.Touched:connect(OnTouch)


while(true) do
&#9;wait(.1)
&#9;if (script.Parent.Position - bodyp.position).magnitude &lt; 10 then
&#9;&#9;
&#9;&#9;-- get tosser
&#9;&#9;local creator_tag = script.Parent:FindFirstChild(&quot;creator&quot;)
&#9;&#9;if creator_tag == nil then
&#9;&#9;&#9;bodyp:Remove()
&#9;&#9;else
&#9;&#9;&#9;local char = creator_tag.Value.Character
&#9;&#9;&#9;if char == nil then
&#9;&#9;&#9;&#9;bodyp:Remove()
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;bodyp.position = char.Head.Position
&#9;&#9;&#9;end
&#9;&#9;end
&#9;
&#9;&#9;break
&#9;end
end

wait(.5)
script.Parent.RotVelocity = Vector3.new(0,10,0)

while (true) do
&#9;wait(.1)
&#9;if (script.Parent.Position - bodyp.position).magnitude &lt; 5 then
&#9;&#9;bodyp:Remove()
&#9;&#9;break
&#9;end
end

sound:Stop()
script:Remove()</ProtectedString>
				</Properties>
			</Item>
