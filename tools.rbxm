			<Item class="Script" referent="RBX4562">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">FlashBangScript</string>
					<ProtectedString name="Source">local Tool = script.Parent;




local GlassBreak = Instance.new(&quot;Sound&quot;)
GlassBreak.Name = &quot;GlassBreak&quot;
GlassBreak.SoundId = &quot;http://www.roblox.com/asset/?id=16976189&quot;
GlassBreak.Volume = 3
GlassBreak.Parent = Tool.Handle





function onActivated()
&#9;if not Tool.Enabled  then
&#9;&#9;return
&#9;end

&#9;Tool.Enabled = false
&#9;

&#9;wait(1)
&#9;
&#9;local player = game.Players:GetPlayerFromCharacter(Tool.Parent)
&#9;local h = Tool.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;if (h == nil or player == nil) then
&#9;&#9;Tool.Enabled = true
&#9;&#9;return
&#9;end

&#9;
&#9;

&#9;local p = Tool.Handle:Clone()
&#9;GlassBreak.Parent = p
&#9;p.Transparency = 0
&#9;
&#9;Tool.Parent.Torso[&quot;Right Shoulder&quot;].MaxVelocity = 0.7
&#9;Tool.Parent.Torso[&quot;Right Shoulder&quot;].DesiredAngle = 3.6
&#9;wait(.1)
&#9;Tool.Parent.Torso[&quot;Right Shoulder&quot;].MaxVelocity = 1

&#9;local tosser = Instance.new(&quot;ObjectValue&quot;)
&#9;tosser.Value = player
&#9;tosser.Name = &quot;Tosser&quot;
&#9;tosser.Parent = p

&#9;local dir = h.Parent.Head.CFrame.lookVector
&#9;p.Velocity = (dir * 45) + Vector3.new(-20,45,0)
&#9;p.CanCollide = true
&#9;Tool.Glass:Clone().Parent = p
&#9;p.Glass.Disabled = false
&#9;p.Parent = game.Workspace

&#9;wait(14)
&#9;p.Transparency = 1
&#9;Tool.Enabled = true

end

function onEquipped()
&#9;--Tool.Handle.OpenSound:play()
end

script.Parent.Activated:connect(onActivated)
script.Parent.Equipped:connect(onEquipped)
</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX4563">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Glass</string>
					<ProtectedString name="Source">print(&quot;lol&quot;)

local grenade = script.Parent
local tosser = script.Parent.Tosser.Value

function GetNearbyPlayers(pos, distance)

&#9;local players = game.Players:GetPlayers()
&#9;local results = {}
&#9;for i=1,#players do
&#9;&#9;if (players[i].Character ~= nil) then
&#9;&#9;&#9;local t = players[i].Character:FindFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;if (t ~= nil) then
&#9;&#9;&#9;&#9;if ((t.Position - pos).magnitude &lt; distance) then
&#9;&#9;&#9;&#9;&#9;results[#results + 1] = players[i]
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end

&#9;return results

end

function FlashBang()
&#9;
&#9;local players = GetNearbyPlayers(grenade.Position, 44)
&#9;print(&quot;number blinded: &quot; .. #players)

&#9;grenade.Transparency = 1

&#9;local effects = {}
&#9;local tosserEffect = nil

&#9;for i = 1,#players do
&#9;&#9;&#9;local guiMain = Instance.new(&quot;GuiMain&quot;) 
&#9;&#9;&#9;guiMain.Parent = players[i].PlayerGui 
&#9;&#9;&#9;local mainFrame = Instance.new(&quot;Frame&quot;) 
&#9;&#9;&#9;mainFrame.Name = &quot;FlashBangEffect&quot;
&#9;&#9;&#9;mainFrame.Position = UDim2.new(-.2, 0, -.2, 0) 
&#9;&#9;&#9;mainFrame.Size = UDim2.new(1.5, 0, 1.5, 0) 
&#9;&#9;&#9;mainFrame.BackgroundColor = BrickColor.new(1,1,1)
&#9;&#9;&#9;mainFrame.BorderColor = BrickColor.new(1,1,1)
&#9;&#9;&#9;mainFrame.Parent = guiMain
&#9;&#9;if (players[i] ~= tosser) then
&#9;&#9;&#9;effects[#effects + 1] = mainFrame
&#9;&#9;else
&#9;&#9;&#9;tosserEffect = mainFrame
&#9;&#9;end
&#9;end

&#9;wait(4)
&#9;if tosserEffect ~= nil then
&#9;&#9;for t = 1, 9 do
&#9;&#9;&#9;tosserEffect.Transparency = t / 10
&#9;&#9;&#9;wait(.3)
&#9;&#9;end
&#9;&#9;tosserEffect:Remove()
&#9;else
&#9;&#9;wait(.9)
&#9;end

&#9;wait(2)

&#9;for t = 1, 9 do
&#9;&#9;for n = 1, #effects do
&#9;&#9;&#9;effects[n].Transparency = t / 10
&#9;&#9;end
&#9;&#9;wait(.1)
&#9;end

&#9;for n = 1, #effects do
&#9;&#9;effects[n]:Remove()
&#9;end
&#9;
&#9;

end

function Touched(part)
&#9;con:disconnect()
&#9;script.Parent.GlassBreak:Play()
&#9;FlashBang()
end


wait(1)
con = script.Parent.Touched:connect(Touched)

wait(30)
script.Parent:Remove()</ProtectedString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX4564">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui</string>
					<ProtectedString name="Source">local Tool = script.Parent;

enabled = true
function onButton1Down(mouse)
&#9;if not enabled then
&#9;&#9;return
&#9;end

&#9;enabled = false
&#9;mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;

&#9;wait(15)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;enabled = true

end

function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end

&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end


Tool.Equipped:connect(onEquippedLocal)
</ProtectedString>
				</Properties>
			</Item>
		</Item>
