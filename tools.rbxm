			<Item class="Script" referent="RBX537">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">TeddyTrapScript</string>
					<ProtectedString name="Source">local Tool = script.Parent;

enabled = true


Calibrate = Instance.new(&quot;Sound&quot;)
Calibrate.SoundId = &quot;http://www.roblox.com/asset/?id=11956590&quot;
Calibrate.Parent = Tool.Handle



function onActivated()
&#9;if not enabled  then
&#9;&#9;return
&#9;end

&#9;enabled = false

&#9;

&#9;local sound = Instance.new(&quot;Sound&quot;)
&#9;&#9;sound.SoundId = &quot;rbxasset://sounds\\Rocket shot.wav&quot;
&#9;&#9;sound.Parent = script.Parent
&#9;&#9;sound.PlayOnRemove = true
&#9;&#9;sound.Volume = 1
&#9;&#9;

&#9;Tool.GripForward = Vector3.new(1,0,0)
&#9;Tool.GripPos = Vector3.new(.5,-1.5,-1.56)
&#9;Tool.GripRight = Vector3.new(0,-.707,-.707)
&#9;Tool.GripUp = Vector3.new(0,-.707,.707)

&#9;Calibrate:Play()
&#9;wait(2)


&#9;

&#9;local e = Instance.new(&quot;Explosion&quot;)
&#9;e.BlastRadius = 2
&#9;e.BlastPressure = 1000000
&#9;e.Position = Tool.Handle.Position
&#9;e.Parent = game.Workspace

&#9;wait(.1)
&#9;Tool.Parent = game.Workspace --drop teddy
&#9;Tool.GripForward = Vector3.new(-1,0,0)
&#9;Tool.GripPos = Vector3.new(0,0,-.4)
&#9;Tool.GripRight = Vector3.new(0,1,0)
&#9;Tool.GripUp = Vector3.new(0,0,1)


&#9;sound:Remove()
&#9;enabled = true

end


function onEquipped()
&#9;Calibrate.Volume = 1
end

function onUnequipped()
&#9;Calibrate.Volume = 0
end


script.Parent.Activated:connect(onActivated)
script.Parent.Equipped:connect(onEquipped)
script.Parent.Unequipped:connect(onUnequipped)
</ProtectedString>
