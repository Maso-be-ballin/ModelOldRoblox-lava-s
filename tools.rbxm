			<Item class="LocalScript" referent="RBX524">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui</string>
					<ProtectedString name="Source">local Tool = script.Parent;

enabled = true
function onButton1Down(mouse)
&#9;if not enabled then
&#9;&#9;return
&#9;end

&#9;enabled = false
&#9;mouse.Icon = &quot;rbxasset://textures\\ArrowFarCursor.png&quot;

&#9;wait(3)
&#9;mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
&#9;enabled = true

end

function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end

&#9;mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

Tool.Equipped:connect(onEquippedLocal)
</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX525">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Bomb</string>
					<ProtectedString name="Source">debris = game:GetService(&quot;Debris&quot;)

FuseSound = Instance.new(&quot;Sound&quot;)
FuseSound.SoundId = &quot;http://www.roblox.com/asset/?id=11565378&quot;
FuseSound.Parent = script.Parent
FuseSound:Play()

local sounds = {script.Parent.MoneySound1, script.Parent.MoneySound2, script.Parent.MoneySound3}

local meshsize = script.Parent.Mesh.Scale

local buck = nil


buck = Instance.new(&quot;Part&quot;)
buck.formFactor = 2
buck.Size = Vector3.new(2,.4,1)
buck.BrickColor = BrickColor.new(&quot;Br. yellowish orange&quot;)
buck.TopSurface = 0
buck.BottomSurface = 0
buck.Elasticity = .01 

local d = Instance.new(&quot;Decal&quot;)
d.Face = 4
d.Texture = &quot;http://www.roblox.com/asset/?id=19354292&quot;
d.Parent = buck

local d2 = d:Clone()
d2.Face = 1
d2.Parent = buck

function MakeABuck(pos)

&#9;local limit = 15

&#9;for i=1,limit do

&#9;&#9;local b = buck:Clone()
&#9;&#9;local v = Vector3.new(math.random() - .5, math.random() - .5, math.random() - .5).unit
&#9;&#9;b.CFrame = CFrame.new(pos + (v * 2) + Vector3.new(0,4,0), v)
&#9;&#9;b.Parent = game.Workspace
&#9;&#9;debris:AddItem(b, 60)
&#9;end

end

function update(big)
&#9;if big then
&#9;&#9;script.Parent.Mesh.Scale = meshsize * 1.5
&#9;else
&#9;&#9;script.Parent.Mesh.Scale = meshsize
&#9;end
end


function blowUp()
&#9;local sound = Instance.new(&quot;Sound&quot;)
&#9;&#9;sound.SoundId = &quot;rbxasset://sounds\\Rocket shot.wav&quot;
&#9;&#9;sound.Parent = script.Parent
&#9;&#9;sound.Volume = 1
&#9;&#9;sound:play()

&#9;MakeABuck(script.Parent.Position + Vector3.new(0,4,0))


&#9;explosion = Instance.new(&quot;Explosion&quot;)
&#9;explosion.BlastRadius = 12
&#9;explosion.BlastPressure = 100000 -- these are really wussy units

&#9;-- find instigator tag
&#9;local creator = script.Parent:findFirstChild(&quot;creator&quot;)
&#9;if creator ~= nil then
&#9;&#9;explosion.Hit:connect(function(part, distance)  onPlayerBlownUp(part, distance, creator) end)
&#9;end

&#9;explosion.Position = script.Parent.Position + Vector3.new(math.random() - .5, math.random() - .5, math.random() - .5)
&#9;explosion.Parent = game.Workspace

&#9;for i=1,5 do
&#9;&#9;sounds[math.random(1,#sounds)]:Play()
&#9;&#9;wait(.1)
&#9;end

&#9;script.Parent.Transparency = 1
end

function onPlayerBlownUp(part, distance, creator)
&#9;if part.Name == &quot;Head&quot; then
&#9;&#9;local humanoid = part.Parent.Humanoid
&#9;&#9;tagHumanoid(humanoid, creator)
&#9;end
end

function tagHumanoid(humanoid, creator)
&#9;-- tag does not need to expire iff all explosions lethal
&#9;
&#9;if creator ~= nil then
&#9;&#9;local new_tag = creator:clone()
&#9;&#9;new_tag.Parent = humanoid
&#9;end
end

function untagHumanoid(humanoid)
&#9;if humanoid ~= nil then
&#9;&#9;local tag = humanoid:findFirstChild(&quot;creator&quot;)
&#9;&#9;if tag ~= nil then
&#9;&#9;&#9;tag.Parent = nil
&#9;&#9;end
&#9;end
end

local counter = .6
local big = true
while counter &gt; .03 do
&#9;wait(counter)
&#9;counter = counter * .8
&#9;update(big)
&#9;big = not big
end


blowUp()
wait(.1)
script.Parent:remove()
</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX526">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">PlantBomb</string>
					<ProtectedString name="Source">bombScript = script.Parent.Bomb
Tool = script.Parent

function plant(pos)
&#9;
   
&#9;local vCharacter = Tool.Parent
&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;local spawnPos = vCharacter.PrimaryPart.Position


&#9;local bomb = Tool.Handle:Clone()
&#9;bomb.CanCollide = true
&#9;bomb.Transparency = 0
&#9;bomb.Position = pos
&#9;bomb.Size = Vector3.new(2,2,2)
&#9;bomb.Name = &quot;FuseBomb&quot;
&#9;bomb.Locked = true

&#9;local spark = Instance.new(&quot;Sparkles&quot;)
&#9;spark.Name = &quot;Fuse&quot;
&#9;spark.Parent = bomb


&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;creator_tag.Value = vPlayer
&#9;creator_tag.Name = &quot;creator&quot;
&#9;creator_tag.Parent = bomb

&#9;Tool.Handle.MoneySound1:Clone().Parent = bomb
&#9;Tool.Handle.MoneySound2:Clone().Parent = bomb
&#9;Tool.Handle.MoneySound3:Clone().Parent = bomb

&#9;bomb.Parent = game.Workspace
&#9;local new_script = bombScript:clone()
&#9;new_script.Disabled = false
&#9;new_script.Parent = bomb

end


Tool.Enabled = true
function onActivated()

&#9;if not Tool.Enabled then
&#9;&#9;return
&#9;end

&#9;Tool.Enabled = false

&#9;local character = Tool.Parent;
&#9;local humanoid = character.Humanoid
&#9;if humanoid == nil then
&#9;&#9;print(&quot;Humanoid not found&quot;)
&#9;&#9;return 
&#9;end

&#9;local targetPos = humanoid.TargetPoint

&#9;Tool.Handle.Transparency = 1
&#9;plant(Tool.Handle.Position)
&#9;wait(3)
&#9;Tool.Handle.Transparency = 0

&#9;Tool.Enabled = true
end


script.Parent.Activated:connect(onActivated)</ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="Tool" referent="RBX527">
			<Properties>
				<bool name="CanBeDropped">true</bool>
				<bool name="Enabled">true</bool>
				<CoordinateFrame name="Grip">
					<X>0</X>
					<Y>0</Y>
					<Z>1</Z>
					<R00>1</R00>
					<R01>0</R01>
					<R02>0</R02>
					<R10>0</R10>
					<R11>1</R11>
					<R12>0</R12>
					<R20>0</R20>
					<R21>0</R21>
					<R22>1</R22>
				</CoordinateFrame>
				<string name="Name">TicTacToe</string>
				<Content name="TextureId"><url>http://www.roblox.com/asset/?id=16923382</url></Content>
				<string name="ToolTip"></string>
			</Properties>
			<Item class="ObjectValue" referent="RBX528">
				<Properties>
					<string name="Name">Opponent</string>
					<Ref name="Value">null</Ref>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX529">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">TicTac_LocalMain</string>
					<ProtectedString name="Source">local clicks = 0
local con = nil

script.Parent.Equipped:connect(function(mouse)
&#9;script.Name = &quot;TicTac_LocalMain_Selected&quot;
&#9;--when clicked look for an opponent
&#9;con = mouse.Button1Down:connect(function()
&#9;&#9;--check for a humanoid
&#9;&#9;--OR hack for quick elimination of possible &quot;no mouse.Target&quot; condition
&#9;&#9;local humanoid = (mouse.Target or game.Workspace).Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;&#9;local torso = humanoid.Parent:FindFirstChild(&quot;Torso&quot;)
&#9;&#9;if torso and (torso.Position - script.Parent.Handle.Position).magnitude &lt; 16 then
&#9;&#9;&#9;if humanoid then
&#9;&#9;&#9;&#9;--check if the humanoid belongs to a player
&#9;&#9;&#9;&#9;local player = game.Players:playerFromCharacter(humanoid.Parent)
&#9;&#9;&#9;&#9;if player then
&#9;&#9;&#9;&#9;&#9;--replicate the opponent value to the server sided script
&#9;&#9;&#9;&#9;&#9;script.Parent.Opponent.Value = player
&#9;&#9;&#9;&#9;&#9;--
&#9;&#9;&#9;&#9;&#9;clicks = clicks + 1
&#9;&#9;&#9;&#9;&#9;script.Name = tostring(clicks)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)
end)

script.Parent.Unequipped:connect(function()
&#9;if con then
&#9;&#9;con:disconnect()
&#9;&#9;con = nil
&#9;end
&#9;script.Name = &quot;TicTac_LocalMain_NotSelected&quot;
end)
</ProtectedString>
				</Properties>
			</Item>
