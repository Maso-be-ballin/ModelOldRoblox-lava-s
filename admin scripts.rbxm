p.CanCollide = false
p.formFactor = &quot;Symmetric&quot;
p.Shape = &quot;Ball&quot;
p.Size = Vector3.new(1,1,1)
p.BrickColor = BrickColor.new(&quot;New Yeller&quot;)
p.Transparency = .5
